<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <!-- The view models talk to the modules through their contracts only, as the program does. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Chainsaw.SharedKernel\Chainsaw.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Modules\Security\Chainsaw.Modules.Security.Contracts\Chainsaw.Modules.Security.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Network\Chainsaw.Modules.Network.Contracts\Chainsaw.Modules.Network.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Cases\Chainsaw.Modules.Cases.Contracts\Chainsaw.Modules.Cases.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Chains\Chainsaw.Modules.Chains.Contracts\Chainsaw.Modules.Chains.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Tracing\Chainsaw.Modules.Tracing.Contracts\Chainsaw.Modules.Tracing.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Attribution\Chainsaw.Modules.Attribution.Contracts\Chainsaw.Modules.Attribution.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Clustering\Chainsaw.Modules.Clustering.Contracts\Chainsaw.Modules.Clustering.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Pricing\Chainsaw.Modules.Pricing.Contracts\Chainsaw.Modules.Pricing.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Checks\Chainsaw.Modules.Checks.Contracts\Chainsaw.Modules.Checks.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Monitoring\Chainsaw.Modules.Monitoring.Contracts\Chainsaw.Modules.Monitoring.Contracts.csproj" />
  </ItemGroup>
  <!--
    Chainsaw.App is a WPF program, which tests cannot load where there is no Windows desktop runtime, as in the cloud.
    The parts that use no WPF on purpose are compiled in here instead: the views' table in Navigation/, the view
    models in ViewModels/, the commands in Commands/, the links in Links/, the figure behind the lock screen in
    Figure/, the settings in Settings/, the graph's layout, look and hit tests in Graph/, the check of a WireGuard file
    and the exits' words in Exits/, and the Guide's texts, index and history in Guide/.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Chainsaw.App\Navigation\*.cs" Link="Navigation\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Chainsaw.App\ViewModels\*.cs" Link="ViewModels\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Chainsaw.App\Figure\*.cs" Link="Figure\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Chainsaw.App\Settings\*.cs" Link="Settings\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Chainsaw.App\Commands\*.cs" Link="Commands\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Chainsaw.App\Links\*.cs" Link="Links\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Chainsaw.App\Graph\*.cs" Link="Graph\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Chainsaw.App\Exits\*.cs" Link="Exits\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Chainsaw.App\Guide\*.cs" Link="Guide\%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- The Guide's texts, built in as in the program, so that the tests read what the program shows. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\guide\*.md" LogicalName="Chainsaw.App.Guide.%(Filename).md" />
    <EmbeddedResource Include="..\..\THIRD_PARTY.md" LogicalName="Chainsaw.App.Licenses.md" />
  </ItemGroup>
</Project>
