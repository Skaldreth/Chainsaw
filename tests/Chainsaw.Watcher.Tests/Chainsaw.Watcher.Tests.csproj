<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Monitoring tests' fakes and synthetic Esplora pages, shared rather than copied. -->
    <Compile Include="..\Chainsaw.Modules.Monitoring.Tests\Fakes.cs" Link="Shared\Fakes.cs" />
    <Compile Include="..\Chainsaw.Modules.Monitoring.Tests\Synthetic.cs" Link="Shared\Synthetic.cs" />
    <None Include="..\Chainsaw.Modules.Monitoring.Tests\Recorded\*.json" Link="Recorded\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Chainsaw.Watcher\Chainsaw.Watcher.csproj" />
    <ProjectReference Include="..\..\src\Modules\Cases\Chainsaw.Modules.Cases\Chainsaw.Modules.Cases.csproj" />
    <ProjectReference Include="..\..\src\Modules\Clustering\Chainsaw.Modules.Clustering\Chainsaw.Modules.Clustering.csproj" />
  </ItemGroup>
</Project>
