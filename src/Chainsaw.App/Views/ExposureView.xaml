<UserControl x:Class="Chainsaw.App.Views.ExposureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ExposureViewModel}"
             mc:Ignorable="d" Focusable="True" FocusVisualStyle="{x:Null}">

    <!--
      The view Exponering (sketch EP1b): the rings around the cluster to the left, with the subject, the depth and the
      method over them; to the right the shares per colour of both sides, the services, and at the bottom the chosen
      service's way with what it rests on, Varför? and Visa vägen i grafen. Only wiring; what happens lives in
      ExposureViewModel, and the rings are drawn by ExposureRings.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A quiet framed button over the picture, as the sketch's ghost: the subject and the menu's rows. -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Height="44" Padding="8,0,12,0" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{StaticResource Brush.BorderStrong}" Background="{StaticResource Brush.Surface}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row of a list: a soft ground on hover, the raised ground when chosen. -->
        <Style x:Key="Row" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Padding="8,0" CornerRadius="8" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A choice in a segmented control: the depth or the asset; the chosen one on the selected ground. -->
        <Style x:Key="Segment" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" MinWidth="34" Height="30" Padding="8,0" CornerRadius="7" Background="Transparent">
                            <TextBlock x:Name="Words" Text="{Binding Text}" FontSize="12.5" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                                <Setter TargetName="Words" Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Words" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The segmented controls' items: the depth or the asset as small buttons in a row. -->
        <DataTemplate x:Key="SegmentItem" DataType="{x:Type vm:ExposureChoice}">
            <Button Style="{StaticResource Segment}" ToolTip="{Binding ToolTip}"
                    Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding Value}" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="InRow">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- The small headings in capitals, as the sketch writes them. -->
        <Style x:Key="Caps" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Nothing to read yet: said honestly, with the view's icon, never with made-up rings. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80" MaxWidth="440"
                    Visibility="{Binding HasSubject, Converter={x:Static controls:InvertVisibility.Instance}}">
            <controls:GridIcon Size="40" Foreground="{StaticResource Brush.TextFaint}" HorizontalAlignment="Center"
                               Data="{StaticResource Icon.Exposure}" />
            <TextBlock Text="{x:Static vm:ExposureViewModel.EmptyText}" FontSize="13.5" Margin="0,14,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="21"
                       Foreground="{StaticResource Brush.TextDim}" />
        </StackPanel>

        <Grid x:Name="Room" Margin="84,0,0,0" Visibility="{Binding HasSubject, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- ===== The rings, with the subject, the depth and the method over them. ===== -->
            <Grid Grid.Column="0" Margin="0,16,0,16">
                <controls:ExposureRings Margin="0,52,0,0" Picture="{Binding Picture}" SelectedId="{Binding SelectedId}"
                                        Lit="{Binding Lit}" PickCommand="{Binding PickCommand}" />

                <DockPanel VerticalAlignment="Top" Height="44" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource Ghost}" Command="{Binding ToggleMenuCommand}"
                            ToolTip="Välj kluster eller adress">
                        <StackPanel Orientation="Horizontal">
                            <controls:SortMark Width="30" Height="30" Look="{Binding Subject.Node.Look}" />
                            <StackPanel Margin="10,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Subject.Name}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}" />
                                <TextBlock Text="{Binding Subject.Line}" FontSize="11.5" Margin="0,1,0,0"
                                           Foreground="{StaticResource Brush.TextDim}" />
                            </StackPanel>
                            <controls:GridIcon Size="14" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}"
                                               Data="{StaticResource Icon.ChevronDown}" />
                        </StackPanel>
                    </Button>

                    <TextBlock DockPanel.Dock="Left" Text="Djup" FontSize="12" Margin="16,0,10,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextDim}" />
                    <Border DockPanel.Dock="Left" Padding="2" CornerRadius="9" BorderThickness="1" VerticalAlignment="Center"
                            BorderBrush="{StaticResource Brush.BorderStrong}" Background="{StaticResource Brush.Surface}">
                        <ItemsControl ItemsSource="{Binding Depths}" Tag="{Binding SetDepthCommand}" Focusable="False"
                                      ItemTemplate="{StaticResource SegmentItem}" ItemsPanel="{StaticResource InRow}" />
                    </Border>

                    <!-- The assets, only when the subject has more than one (principle 7). -->
                    <Border DockPanel.Dock="Left" Padding="2" CornerRadius="9" BorderThickness="1" Margin="10,0,0,0"
                            VerticalAlignment="Center" BorderBrush="{StaticResource Brush.BorderStrong}"
                            Background="{StaticResource Brush.Surface}"
                            Visibility="{Binding HasAssets, Converter={StaticResource Visible}}">
                        <ItemsControl ItemsSource="{Binding Assets}" Tag="{Binding PickAssetCommand}" Focusable="False"
                                      ItemTemplate="{StaticResource SegmentItem}" ItemsPanel="{StaticResource InRow}" />
                    </Border>

                    <!-- The method, dashed: the shares are a judgement by it. -->
                    <Grid DockPanel.Dock="Right" Height="34" VerticalAlignment="Center" Background="Transparent"
                          ToolTip="Andelarna räknas med spårningsmetoden och är en bedömning">
                        <Rectangle RadiusX="9" RadiusY="9" StrokeThickness="1" StrokeDashArray="3 2" SnapsToDevicePixels="True"
                                   Stroke="{StaticResource Brush.BorderHover}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                            <TextBlock Text="{Binding MethodText}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text}" />
                            <TextBlock Text="{Binding VersionText}" FontSize="12.5" Margin="8,0,0,0"
                                       Foreground="{StaticResource Brush.TextDim}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <!-- Why nothing could be read, said honestly in the room of the rings. -->
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" TextWrapping="Wrap"
                           TextAlignment="Center" FontSize="13" Text="{Binding Problem}"
                           Foreground="{StaticResource Brush.Error}"
                           Visibility="{Binding HasProblem, Converter={StaticResource Visible}}" />

                <!-- The subject menu (sketch EP1b, I GRAFEN). -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,50,0,0" Width="300" Padding="5"
                        CornerRadius="11" BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}"
                        Background="{StaticResource Brush.Floating}"
                        Visibility="{Binding IsMenuOpen, Converter={StaticResource Visible}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="I GRAFEN" Style="{StaticResource Caps}" Margin="9,6,9,4" />
                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Subjects}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ExposureSubjectRow}">
                                        <Button Style="{StaticResource Row}" Height="44" Margin="0,1"
                                                Command="{Binding DataContext.PickSubjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:SortMark Width="26" Height="26" Look="{Binding Look}" />
                                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Brush.Text}" />
                                                    <TextBlock Text="{Binding Line}" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== The side: the shares, the services and the chosen way. ===== -->
            <!-- Under the work, as the graph's inspector (sketch IN5a): 20 px more room on the left than the content's 20. -->
            <controls:UnderPanel Grid.Column="2" Padding="20,0,6,0">
                <DockPanel>
                    <!-- The chosen service, fixed at the bottom. -->
                    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border}"
                            Background="{StaticResource Brush.Floating}" Padding="20,16,20,18" CornerRadius="0"
                            Visibility="{Binding HasDetail, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <DockPanel>
                                <controls:SortMark DockPanel.Dock="Left" Width="36" Height="36" Look="{Binding Detail.Look}" />
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Detail.Percent}" FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Foreground="{StaticResource Brush.Text}" />
                                    <TextBlock Text="{Binding Detail.Direction}" FontSize="11.5" HorizontalAlignment="Right"
                                               Foreground="{StaticResource Brush.TextDim}" />
                                </StackPanel>
                                <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Detail.Name}" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource Brush.Text}" />
                                    <TextBlock Text="{Binding Detail.Amount}" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                </StackPanel>
                            </DockPanel>

                            <!-- The way, as chips with a › between. -->
                            <ItemsControl ItemsSource="{Binding Detail.Crumbs}" Margin="0,12,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ExposureCrumb}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Grid Height="24">
                                                <Rectangle x:Name="Frame" RadiusX="6" RadiusY="6" StrokeThickness="1"
                                                           Stroke="{StaticResource Brush.BorderStrong}" SnapsToDevicePixels="True" />
                                                <TextBlock Text="{Binding Text}" FontSize="12" Margin="8,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush.TextMuted}" />
                                            </Grid>
                                            <TextBlock Text="›" Margin="5,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextFaint}"
                                                       Visibility="{Binding HasNext, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDashed}" Value="True">
                                                <Setter TargetName="Frame" Property="StrokeDashArray" Value="3 2" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding Detail.Transactions}" FontSize="12" Margin="0,8,0,0" LineHeight="18"
                                       TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}" />

                            <!-- What it rests on, and Varför?. -->
                            <WrapPanel Margin="0,10,0,0">
                                <ItemsControl ItemsSource="{Binding Detail.Basis}" Focusable="False"
                                              ItemTemplate="{StaticResource ExposureBasisChip}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button Style="{StaticResource Row}" Height="22" Margin="0,0,0,6" Command="{Binding AskWhyCommand}"
                                        ToolTip="Öppnar Guiden bredvid · ?">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:GridIcon Size="12" Foreground="{StaticResource Brush.TextMuted}"
                                                           Data="{StaticResource Icon.Question}" />
                                        <TextBlock Text="Varför?" FontSize="11.5" Margin="5,0,0,0"
                                                   Foreground="{StaticResource Brush.TextMuted}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <Button Style="{StaticResource Button.Primary}" Height="38" Margin="0,8,0,0"
                                    Command="{Binding ShowPathCommand}" ToolTip="Visa vägen i grafen · G">
                                <StackPanel Orientation="Horizontal">
                                    <controls:GridIcon Size="15" Foreground="{StaticResource Brush.OnAccent}" VerticalAlignment="Center"
                                                       Data="{StaticResource Icon.Fit}" />
                                    <TextBlock Text="Visa vägen i grafen" FontSize="13.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="G" FontSize="11" FontWeight="Normal" Opacity="0.7" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="12,14,12,0">
                        <StackPanel>
                            <!-- The shares per colour, paid out and got. -->
                            <ItemsControl ItemsSource="{Binding Sides}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ExposureSideRows}">
                                        <StackPanel Margin="0,0,0,10">
                                            <DockPanel Height="34" Margin="8,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" FontSize="12" Margin="5,0,0,0"
                                                           VerticalAlignment="Center" Foreground="{StaticResource Brush.TextDim}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontSize="12.5"
                                                           VerticalAlignment="Center" Foreground="{StaticResource Brush.Text}" />
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Caps}" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ExposureGroupRow}">
                                                        <Grid Height="34" Margin="8,0" ToolTip="{Binding ToolTip}" Background="Transparent">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="20" />
                                                                <ColumnDefinition Width="108" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="58" />
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle x:Name="Dot" Width="10" Height="10" RadiusX="3" RadiusY="3" StrokeThickness="1.5"
                                                                       HorizontalAlignment="Left"
                                                                       Fill="{Binding Ink, Converter={x:Static controls:GraphInkConverter.Instance}}"
                                                                       Stroke="{Binding Ink, Converter={x:Static controls:GraphInkConverter.Instance}}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Brush.TextMuted}" />
                                                            <Border Grid.Column="2" Height="5" CornerRadius="2.5" VerticalAlignment="Center"
                                                                    Background="{StaticResource Brush.SurfaceRaised}" ClipToBounds="True">
                                                                <Border x:Name="Bar" CornerRadius="2.5" HorizontalAlignment="Stretch"
                                                                        RenderTransformOrigin="0,0.5"
                                                                        Background="{Binding Ink, Converter={x:Static controls:GraphInkConverter.Instance}}">
                                                                    <Border.RenderTransform>
                                                                        <ScaleTransform ScaleX="{Binding Share}" />
                                                                    </Border.RenderTransform>
                                                                </Border>
                                                            </Border>
                                                            <TextBlock Grid.Column="3" Text="{Binding Percent}" FontSize="12.5" TextAlignment="Right"
                                                                       VerticalAlignment="Center" Foreground="{StaticResource Brush.Text}" />
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                                                                <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                                                                <Setter TargetName="Dot" Property="StrokeDashArray" Value="2 1.5" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Rectangle Height="1" Margin="8,0,8,6" Fill="{StaticResource Brush.Border}" />

                            <!-- The services paid out to, the largest first; a click chooses one. -->
                            <ItemsControl ItemsSource="{Binding Services}" Focusable="False" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ExposureServiceRow}">
                                        <Button Style="{StaticResource Row}" Height="34"
                                                Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}" ToolTip="{Binding Look.Name}">
                                            <DockPanel>
                                                <controls:SortMark DockPanel.Dock="Left" Width="20" Height="20" Look="{Binding Look}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Percent}" Width="52" FontSize="12.5"
                                                           TextAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush.TextMuted}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Hops}" FontSize="11.5" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush.TextDim}" />
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" Margin="10,0,8,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource Brush.Text}" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </controls:UnderPanel>
        </Grid>
    </Grid>
</UserControl>
