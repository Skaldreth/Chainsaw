<UserControl x:Class="Chainsaw.App.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:views="clr-namespace:Chainsaw.App.Views"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:MonitoringViewModel}"
             mc:Ignorable="d" Focusable="True" FocusVisualStyle="{x:Null}">

    <!--
      The view Bevakning (sketch BV1a): a row per watch (state as a dot, chain, direction as arrows, counterparties as
      chips, the asset, when last checked, a dot for new hits), the chosen one's details and hits to the right, Ny
      bevakning … (B) with the graph's form, and the honest state of the watching in the head. Only wiring; what
      happens lives in MonitoringViewModel.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}" />
        </Style>
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Light}" Value="{x:Static vm:WatchLight.Waiting}">
                    <Setter Property="Fill" Value="{StaticResource Brush.Pending}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Light}" Value="{x:Static vm:WatchLight.Paused}">
                    <Setter Property="Fill" Value="{StaticResource Brush.TextDim}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The list, beside the pill. -->
        <DockPanel Grid.Column="0" Margin="84,16,24,80">
            <!-- The head shows only beside watches: the empty state has its own button, and a count of nothing is
                 noise (principle 7). -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" Height="30"
                       Visibility="{Binding ShowsHead, Converter={StaticResource Visible}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Graph}" Foreground="{StaticResource Brush.Text}"
                        Command="{Binding NewCommand}" ToolTip="Ny bevakning · B" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <controls:GridIcon Size="16" Data="{StaticResource Icon.Plus}" Margin="0,0,7,0" />
                        <TextBlock Text="Ny bevakning …" FontSize="13.5" VerticalAlignment="Center" />
                        <TextBlock Text="B" FontSize="12" Foreground="{StaticResource Brush.TextFaint}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- The honest state of the watching (sketch BV1a), as a dot and words in a rounded frame: it runs
                     (green, a whole frame), waits for the exit (yellow, dashed) or the background is off (grey,
                     dashed), since dashed always means uncertain. The tooltip says why. -->
                <Grid DockPanel.Dock="Right" ToolTip="{Binding BackgroundTip}">
                    <Border CornerRadius="15" Background="{StaticResource Brush.Surface}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFrameDashed}" Value="True">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Rectangle RadiusX="15" RadiusY="15" StrokeThickness="1" StrokeDashArray="4 3" SnapsToDevicePixels="True"
                               Visibility="{Binding IsFrameDashed, Converter={StaticResource Visible}}">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Stroke" Value="{StaticResource Brush.BorderStrong}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Brush.Pending}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Pending}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOff}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.TextDim}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding BackgroundText}" FontSize="13" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Pending}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOff}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{StaticResource Brush.TextDim}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <Grid DockPanel.Dock="Top" Margin="12,0,12,4" Visibility="{Binding HasRows, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Bevakning" Style="{StaticResource Head}" />
                <TextBlock Grid.Column="2" Text="Kedja" Style="{StaticResource Head}" />
                <TextBlock Grid.Column="3" Text="Riktning" Style="{StaticResource Head}" />
                <TextBlock Grid.Column="4" Text="Motpart och tillgång" Style="{StaticResource Head}" />
                <TextBlock Grid.Column="5" Text="Senast kontrollerad" Style="{StaticResource Head}" />
            </Grid>

            <!-- Virtualized, so that a long list costs only the rows on screen (principle 6). -->
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.ScrollUnit="Pixel">
            <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsPresenter />
                </ScrollViewer>
            </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel VirtualizationMode="Recycling" />
            </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WatchRowViewModel}">
                            <Button Height="52" Margin="0,0,0,4" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Box" CornerRadius="8" BorderThickness="1" Padding="12,0"
                                                Background="Transparent" BorderBrush="Transparent">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter TargetName="Box" Property="Opacity" Value="0.6" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource Dot}" ToolTip="{Binding StateText}" HorizontalAlignment="Left" />
                                    <DockPanel Grid.Column="1">
                                        <!-- The watched node as the graph draws it: its sort's icon and colour, round
                                             or square. -->
                                        <Border DockPanel.Dock="Left" Width="24" Height="24" BorderThickness="1.5" Margin="0,0,9,0"
                                                BorderBrush="{Binding Look.Ink, Converter={x:Static controls:GraphInkConverter.Instance}}"
                                                ToolTip="{Binding Look.Name}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="7" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRound}" Value="True">
                                                            <Setter Property="CornerRadius" Value="12" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <controls:GridIcon Size="14"
                                                               Data="{Binding Look.Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}"
                                                               Foreground="{Binding Look.Ink, Converter={x:Static controls:GraphInkConverter.Instance}}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Short}" FontSize="12" Foreground="{StaticResource Brush.TextFaint}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="9"
                                            BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}" Padding="7,1">
                                        <TextBlock Text="{Binding ChainName}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" />
                                    </Border>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" ToolTip="{Binding DirectionText}"
                                                VerticalAlignment="Center" Background="Transparent">
                                        <controls:GridIcon Size="16" Data="{StaticResource Icon.Dir.In}" Margin="0,0,2,0"
                                                           Foreground="{StaticResource Brush.TextMuted}"
                                                           Visibility="{Binding WatchesIn, Converter={StaticResource Visible}}" />
                                        <controls:GridIcon Size="16" Data="{StaticResource Icon.Dir.Out}"
                                                           Foreground="{StaticResource Brush.TextMuted}"
                                                           Visibility="{Binding WatchesOut, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" ToolTip="{Binding PartiesText}"
                                                VerticalAlignment="Center" ClipToBounds="True" Background="Transparent">
                                        <ItemsControl ItemsSource="{Binding Parties}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <!-- A counterparty with the way the money goes: out to a receiver, in
                                                     from a sender. -->
                                                <DataTemplate DataType="{x:Type vm:WatchRowParty}">
                                                    <Border Height="20" Padding="6,0,7,0" Margin="0,0,4,0" CornerRadius="10" BorderThickness="1"
                                                            BorderBrush="{StaticResource Brush.BorderStrong}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:GridIcon x:Name="Way" Size="12" Data="{StaticResource Icon.Dir.In}"
                                                                               Foreground="{StaticResource Brush.TextDim}" Margin="0,0,3,0"
                                                                               VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Text}" FontSize="12.5" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Brush.TextMuted}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsOut}" Value="True">
                                                            <Setter TargetName="Way" Property="Data" Value="{StaticResource Icon.Dir.Out}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Alla motparter" FontSize="12.5" Foreground="{StaticResource Brush.TextFaint}"
                                                   Margin="0,0,4,0" Visibility="{Binding AllParties, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding AssetText}" FontSize="12.5" Foreground="{StaticResource Brush.TextFaint}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="5" Text="{Binding LastText}" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextDim}" TextTrimming="CharacterEllipsis" />
                                    <Ellipse Grid.Column="6" Width="9" Height="9" Fill="{StaticResource Brush.Accent}"
                                             HorizontalAlignment="Right" ToolTip="{Binding NewTip}"
                                             Visibility="{Binding HasNew, Converter={StaticResource Visible}}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
        </DockPanel>

        <!-- The empty view: a calm eye in the watch's own tone, what a watch does and the one button to add one.
             It steps aside while the form is open, so that the two never overlap. -->
        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                    Margin="84,0,24,80">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRows}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Form.IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Grid Width="96" Height="96" HorizontalAlignment="Center">
                <Ellipse Fill="{StaticResource Brush.Watch}" Opacity="0.12" />
                <controls:GridIcon Size="48" Data="{StaticResource Icon.Eye}" Foreground="{StaticResource Brush.Watch}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding EmptyTitle}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"
                       HorizontalAlignment="Center" Margin="0,22,0,0" />
            <TextBlock Text="{Binding EmptyText}" FontSize="13.5" Foreground="{StaticResource Brush.TextDim}"
                       TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0" />
            <Button Style="{StaticResource Button.Primary}" Height="38" Padding="18,0" Margin="0,22,0,0"
                    HorizontalAlignment="Center" Command="{Binding NewCommand}" ToolTip="B"
                    Visibility="{Binding CanAddFirst, Converter={StaticResource Visible}}">
                <StackPanel Orientation="Horizontal">
                    <controls:GridIcon Size="16" Data="{StaticResource Icon.Plus}" Margin="0,0,7,0"
                                       Foreground="{StaticResource Brush.OnAccent}" />
                    <TextBlock Text="Ny bevakning …" FontSize="13.5" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- The form for Ny bevakning … and Ändra. -->
        <views:WatchForm Grid.Column="0" DataContext="{Binding Form}" HorizontalAlignment="Center" VerticalAlignment="Top"
                         Margin="0,64,0,0" Visibility="{Binding IsOpen, Converter={StaticResource Visible}}" />

        <!-- The chosen watch: details, hits and what can be done with it. -->
        <!-- Only while a watch is chosen; otherwise it folds away and the list takes the width (principle 7). -->
        <Border Grid.Column="1" Width="340" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1.5,0,0,0" Padding="18"
                Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
            <Grid>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <!-- The watched node as the graph draws it, its name, and its state in the state's colour. -->
                        <DockPanel DataContext="{Binding Selected}">
                            <Border DockPanel.Dock="Left" Width="30" Height="30" BorderThickness="1.5" Margin="0,0,10,0"
                                    VerticalAlignment="Center" ToolTip="{Binding Look.Name}"
                                    BorderBrush="{Binding Look.Ink, Converter={x:Static controls:GraphInkConverter.Instance}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRound}" Value="True">
                                                <Setter Property="CornerRadius" Value="15" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <controls:GridIcon Size="16"
                                                   Data="{Binding Look.Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}"
                                                   Foreground="{Binding Look.Ink, Converter={x:Static controls:GraphInkConverter.Instance}}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Ellipse Style="{StaticResource Dot}" Width="7" Height="7" Margin="0,0,6,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StateText}" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Light}" Value="{x:Static vm:WatchLight.Waiting}">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Pending}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Light}" Value="{x:Static vm:WatchLight.Paused}">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Selected.Watch.Subject.Anchor.Value}" FontFamily="{StaticResource Font.Mono}"
                                   FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,14,0,0" />
                        <ItemsControl ItemsSource="{Binding Facts}" Margin="0,12,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WatchFact}">
                                    <StackPanel Margin="0,0,12,10">
                                        <TextBlock Text="{Binding Key}" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}" />
                                        <TextBlock Text="{Binding Value}" FontSize="13.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <!-- Ta bort is a sealed taking back (sketch AN1b): the reason is optional, and the old stays. -->
                        <StackPanel Visibility="{Binding IsRemoving, Converter={StaticResource Visible}}" Margin="0,0,0,10">
                            <TextBlock Text="Skäl (valfritt)" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource TextBox.Field}" Height="28" AutomationProperties.Name="Skäl"
                                     Text="{Binding RemoveReason, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding RemoveCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding CancelRemoveCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Style="{StaticResource Button.Graph}" Height="28" FontSize="13" Margin="0,0,6,0"
                                        Command="{Binding CancelRemoveCommand}" ToolTip="Esc">Avbryt</Button>
                                <Button Style="{StaticResource Button.Primary}" Height="28" Padding="10,0" Command="{Binding RemoveCommand}"
                                        ToolTip="Enter" Content="Ta tillbaka" />
                            </StackPanel>
                        </StackPanel>
                        <!-- At the bottom of the panel (sketch BV1a): Öppna i grafen leads, a step lighter than the
                             others, which stay quiet. -->
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Graph}" Height="28" FontSize="13" Padding="10,0" Margin="0,0,6,0"
                                    Background="{StaticResource Brush.SurfaceSelected}" BorderBrush="{StaticResource Brush.BorderHover}"
                                    Foreground="{StaticResource Brush.Text}" Command="{Binding OpenInGraphCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:GridIcon Size="14" Data="{StaticResource Icon.Graph}" Margin="0,0,6,0" />
                                    <TextBlock Text="Öppna i grafen" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Graph}" Height="28" FontSize="13" Padding="10,0" Margin="0,0,6,0"
                                    Command="{Binding ChangeCommand}" Content="Ändra" />
                            <Button Style="{StaticResource Button.Graph}" Height="28" FontSize="13" Padding="10,0" Margin="0,0,6,0"
                                    Command="{Binding TogglePauseCommand}" Content="{Binding PauseText}" />
                            <Button Style="{StaticResource Button.Graph}" Width="30" Height="28" Padding="0"
                                    Command="{Binding AskRemoveCommand}" ToolTip="Avsluta bevakningen"
                                    AutomationProperties.Name="Ta bort bevakningen">
                                <controls:GridIcon Size="14" Data="{StaticResource Icon.Trash}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <DockPanel Margin="0,4,0,12">
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                                Padding="0,12,0,6">
                            <TextBlock Text="{Binding HitsTitle}" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}" />
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="Inga träffar än." FontSize="13" Foreground="{StaticResource Brush.TextFaint}"
                                   Visibility="{Binding HasNoHits, Converter={StaticResource Visible}}" />
                        <ItemsControl ItemsSource="{Binding Hits}" Focusable="False" VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.ScrollUnit="Pixel">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizationMode="Recycling" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WatchHitRow}">
                                        <Border CornerRadius="6" Padding="12,7,8,7" Margin="0,0,0,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Border Width="3" Margin="-12,0,0,0" HorizontalAlignment="Left" CornerRadius="2"
                                                        Background="{StaticResource Brush.Accent}"
                                                        Visibility="{Binding IsNew, Converter={StaticResource Visible}}" />
                                                <StackPanel>
                                                    <DockPanel>
                                                        <controls:GridIcon x:Name="Arrow" Size="14" Data="{StaticResource Icon.Dir.In}"
                                                                           Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,7,0" />
                                                        <TextBlock Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding When}" FontSize="12" Foreground="{StaticResource Brush.TextFaint}"
                                                               Margin="21,3,0,0" ToolTip="{Binding Hit.Match.Block.Hash}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsOut}" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="{StaticResource Icon.Dir.Out}" />
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </DockPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
