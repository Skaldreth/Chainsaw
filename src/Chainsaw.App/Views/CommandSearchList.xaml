<UserControl x:Class="Chainsaw.App.Views.CommandSearchList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A row as a button that never takes the keyboard: the bar's field keeps it. -->
        <Style x:Key="Button.SearchRow" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The name, with what was written in bold; hashes and addresses in the mono font. -->
        <Style x:Key="Text.SearchName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMono}" Value="True">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="FontSize" Value="12.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The node's form and colour from the graph: round or square, dashed when uncertain, with its icon. -->
        <Style x:Key="Shape.SearchFrame" TargetType="Rectangle">
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="RadiusX" Value="7" />
            <Setter Property="RadiusY" Value="7" />
            <Setter Property="Stroke" Value="{Binding InkKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDashed}" Value="True">
                    <Setter Property="StrokeDashArray" Value="3 2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The Enter key's hint beside the chosen row: Visa i grafen, Öppna i Guiden or Inte i grafen. -->
        <DataTemplate x:Key="EnterHint" DataType="{x:Type vm:SearchRowViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <controls:GridIcon Size="12" Data="{StaticResource Icon.Enter}" Foreground="{StaticResource Brush.TextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBlock Text="{Binding Hint}" FontSize="11.5" Foreground="{StaticResource Brush.TextMuted}" />
            </StackPanel>
        </DataTemplate>

        <!-- A row of a group (sketch KR1a): the frame, the name and its second line, the amount, and the hint. -->
        <DataTemplate x:Key="SearchRow" DataType="{x:Type vm:SearchRowViewModel}">
            <Button Style="{StaticResource Button.SearchRow}"
                    Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Entry.Text}"
                    ToolTip="{Binding Entry.Text}">
                <Border x:Name="Row" Height="48" CornerRadius="9" Background="Transparent" Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Rectangle x:Name="Frame" Style="{StaticResource Shape.SearchFrame}" />
                            <controls:GridIcon Size="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Data="{Binding IconKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}"
                                               Foreground="{Binding InkKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.SearchName}">
                                    <Run Text="{Binding Text.Before, Mode=OneWay}" /><Run
                                        Text="{Binding Text.Match, Mode=OneWay}" FontWeight="Bold" /><Run
                                        Text="{Binding Text.After, Mode=OneWay}" />
                                </TextBlock>
                                <!-- A label from another case: the dashed ring of the graph's corner mark. -->
                                <Ellipse Width="13" Height="13" Margin="7,0,0,0" VerticalAlignment="Center"
                                         Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.5" StrokeDashArray="2 1.5"
                                         ToolTip="Etikett från ett annat ärende"
                                         Visibility="{Binding IsFromOtherCase, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Sub}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Brush.TextDim}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Meta}" FontSize="12.5" VerticalAlignment="Center"
                                   Margin="12,0,0,0" Foreground="{StaticResource Brush.TextMuted}"
                                   Visibility="{Binding HasMeta, Converter={StaticResource Visible}}" />
                        <ContentControl Grid.Column="3" Content="{Binding}" Focusable="False"
                                        ContentTemplate="{StaticResource EnterHint}"
                                        Visibility="{Binding IsSelected, Converter={StaticResource Visible}}" />
                    </Grid>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRound}" Value="True">
                    <Setter TargetName="Frame" Property="RadiusX" Value="14" />
                    <Setter TargetName="Frame" Property="RadiusY" Value="14" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The best hit, large: the frame, the name with its kind, the line that says why, and the hint. -->
        <DataTemplate x:Key="BestRow" DataType="{x:Type vm:SearchRowViewModel}">
            <Button Style="{StaticResource Button.SearchRow}"
                    Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Entry.Text}"
                    ToolTip="{Binding Entry.Text}">
                <Border x:Name="Row" CornerRadius="12" Background="Transparent" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Top">
                            <Rectangle x:Name="Frame" Style="{StaticResource Shape.SearchFrame}" RadiusX="10" RadiusY="10" />
                            <controls:GridIcon Size="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Data="{Binding IconKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}"
                                               Foreground="{Binding InkKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Name" Style="{StaticResource Text.SearchName}" FontSize="17" FontWeight="SemiBold">
                                    <Run Text="{Binding Text.Before, Mode=OneWay}" /><Run
                                        Text="{Binding Text.Match, Mode=OneWay}" /><Run
                                        Text="{Binding Text.After, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding KindText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextDim}" />
                                <Ellipse Width="13" Height="13" Margin="7,0,0,0" VerticalAlignment="Center"
                                         Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.5" StrokeDashArray="2 1.5"
                                         ToolTip="Etikett från ett annat ärende"
                                         Visibility="{Binding IsFromOtherCase, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Lead}" FontSize="12.5" LineHeight="19" Margin="0,4,0,0"
                                       TextWrapping="Wrap" MaxHeight="58" TextTrimming="WordEllipsis"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                        </StackPanel>
                        <ContentControl Grid.Column="2" Content="{Binding}" Focusable="False" VerticalAlignment="Top"
                                        Margin="0,4,0,0" ContentTemplate="{StaticResource EnterHint}"
                                        Visibility="{Binding IsSelected, Converter={StaticResource Visible}}" />
                    </Grid>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRound}" Value="True">
                    <Setter TargetName="Frame" Property="RadiusX" Value="22" />
                    <Setter TargetName="Frame" Property="RadiusY" Value="22" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMono}" Value="True">
                    <Setter TargetName="Name" Property="FontSize" Value="15" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- The foot: the keys, always in sight while the bar is up. -->
        <Border DockPanel.Dock="Bottom" Height="38" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="16,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Ctrl+K · Ctrl+F" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextDim}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="↑↓ välj" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding FootEnterText}" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}"
                               Margin="0,0,16,0" />
                    <TextBlock Text="Tab grupp" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,16,0" />
                    <TextBlock Text="/ kommandon" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                Visibility="{Binding IsShown, Converter={StaticResource Visible}}">
            <ScrollViewer x:Name="Scroller" MaxHeight="460" VerticalScrollBarVisibility="Auto" Focusable="False"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8,6,8,8">
                    <!-- Bästa träff. -->
                    <StackPanel Visibility="{Binding HasBest, Converter={StaticResource Visible}}">
                        <TextBlock Text="Bästa träff" FontSize="12" Foreground="{StaticResource Brush.TextDim}" Margin="4,8,4,4" />
                        <ContentControl Content="{Binding Best}" ContentTemplate="{StaticResource BestRow}" Focusable="False" />
                    </StackPanel>

                    <!-- The groups: Etiketter, Adresser, Tx, Kluster and Guide. -->
                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SearchGroupViewModel}">
                                <StackPanel>
                                    <DockPanel Margin="6,12,6,4">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding MoreText}" FontSize="12"
                                                   Foreground="{StaticResource Brush.TextDim}"
                                                   Visibility="{Binding HasMore, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Brush.TextDim}" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SearchRow}"
                                                  Focusable="False" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Nothing in the case by that name: said honestly, with the Guide's answer above if it has one. -->
                    <TextBlock Text="{Binding EmptyText}" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}"
                               TextWrapping="Wrap" Margin="10,14,10,6"
                               Visibility="{Binding HasEmptyText, Converter={StaticResource Visible}}" />

                    <!-- An address or a tx the case does not have: it can be added as a start point. -->
                    <StackPanel Margin="4,14,4,2" Visibility="{Binding IsUnknown, Converter={StaticResource Visible}}">
                        <TextBlock Text="Finns inte i ärendet" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}"
                                   Margin="4,0,4,8" />
                        <Border x:Name="AddRow" MinHeight="56" CornerRadius="9" Padding="12,8" Cursor="Hand"
                                MouseLeftButtonUp="OnAddClicked" ToolTip="Lägg till som startpunkt (Enter)">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsUnknownSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.5" StrokeDashArray="3 2" />
                                    <controls:GridIcon Size="14" Data="{StaticResource Icon.Plus}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Lägg till som startpunkt" FontSize="13.5" />
                                    <TextBlock Text="{Binding UnknownText}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource Brush.TextDim}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <controls:GridIcon Size="12" Data="{StaticResource Icon.Enter}" Margin="0,0,5,0"
                                                       Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Text="Enter" FontSize="11.5" Foreground="{StaticResource Brush.TextMuted}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
