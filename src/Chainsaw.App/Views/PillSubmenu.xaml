<UserControl x:Class="Chainsaw.App.Views.PillSubmenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             Focusable="True" FocusVisualStyle="{x:Null}" Visibility="Collapsed"
             KeyboardNavigation.TabNavigation="None" KeyboardNavigation.DirectionalNavigation="None"
             AutomationProperties.Name="{Binding Entry.Name}">
    <!--
      An open submenu of the pill (sketch PN1, after Gawk's B9). The button's round grows into a tab past the pill's
      edge and runs into the menu, which hangs from the tab's top edge; a rounded inner corner joins them below the tab.
      One outline (SubmenuShape) carries the surface, the edge and the shadow for both. The rows come from SubmenuTable.
      The control keeps the keyboard itself; its rows are never focused, so that the arrows, Enter, the letters and Esc
      all come here.
    -->
    <Grid x:Name="Shape" HorizontalAlignment="Left" VerticalAlignment="Top">
        <!-- The outline, half a pixel in so that its 1 px edge is sharp, with the shadow in its own element. -->
        <Path x:Name="Outline" Fill="{StaticResource Brush.Submenu}" Stroke="{StaticResource Brush.BorderStrong}"
              StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Path.RenderTransform>
                <TranslateTransform X="0.5" Y="0.5" />
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="10" Direction="270" Opacity="0.5" Color="Black" />
            </Path.Effect>
        </Path>

        <!-- The tab: the button's icon where the button is; a click folds the menu in. -->
        <Border Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                Cursor="Hand" ToolTip="{Binding Entry.ToolTip}" MouseLeftButtonUp="OnTabClicked">
            <controls:GridIcon Size="20" Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Data="{Binding Entry.Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
        </Border>

        <!-- The rows, hanging from the tab's top edge. -->
        <ItemsControl x:Name="Rows" ItemsSource="{Binding Submenu.Rows}" Focusable="False"
                      HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="{Binding Entry.Name}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SubmenuRowViewModel}">
                    <Grid>
                        <Border x:Name="Line" Height="1" Margin="6,4" Background="{StaticResource Brush.BorderStrong}"
                                Visibility="Collapsed" />
                        <Border x:Name="Row" Height="30" CornerRadius="5" Padding="10,0" Background="Transparent"
                                Cursor="Hand" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="300"
                                MouseEnter="OnRowPointed" MouseLeftButtonUp="OnRowClicked"
                                AutomationProperties.Name="{Binding Row.Name}">
                            <DockPanel>
                                <TextBlock x:Name="Key" DockPanel.Dock="Right" Text="{Binding Row.Gesture}"
                                           Foreground="{StaticResource Brush.TextDim}" Margin="24,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="Name" Text="{Binding Row.Name}" Foreground="{StaticResource Brush.Text}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Row.IsLine}" Value="True">
                            <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMarked}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                        </DataTrigger>
                        <!-- A row that cannot be chosen is toned down, with its key, and never looks clickable. -->
                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                            <Setter TargetName="Key" Property="Foreground" Value="{StaticResource Brush.TextFaint}" />
                            <Setter TargetName="Row" Property="Cursor" Value="Arrow" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
