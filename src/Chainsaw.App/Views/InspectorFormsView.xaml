<UserControl x:Class="Chainsaw.App.Views.InspectorFormsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:graph="clr-namespace:Chainsaw.App.Graph"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:InspectorFormsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!--
      The inspector's forms (sketch IN1a): three buttons under the facts, Etikett (L), Bryt upp (U, only on a cluster)
      and Annan kedja (K), and the open form folded out under them. Esc cancels and Enter stores. Only wiring; what
      happens lives in InspectorFormsViewModel.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!--
          A button without a look of its own: its content draws it. It never takes the keyboard, so that Enter after a
          click stores the form instead of clicking the row again.
        -->
        <Style x:Key="Button.Bare" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A choice among several (a source, a chain): grey, lighter when chosen; never takes the keyboard. -->
        <Style x:Key="Button.Chip" TargetType="Button" BasedOn="{StaticResource Button.Graph}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.TextDim}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A field of the forms: smaller than the setup's. -->
        <Style x:Key="TextBox.Form" TargetType="TextBox" BasedOn="{StaticResource TextBox.Field}">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <!-- The reason: wraps, and Enter stores instead of starting a new line. -->
        <Style x:Key="TextBox.Reason" TargetType="TextBox" BasedOn="{StaticResource TextBox.Form}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="MaxLength" Value="{x:Static graph:InspectorForms.MostReasonLength}" />
        </Style>

        <!-- A heading over a field. -->
        <Style x:Key="Text.FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>

        <!-- A quiet line under a form: what storing it means. -->
        <Style x:Key="Text.FormNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel Visibility="{Binding HasNode, Converter={StaticResource Visible}}">
        <!-- ===== The open form: Esc cancels, Enter stores ===== -->
        <!-- The panel by the node (sketch IN1b) gives the frame; here only the fields. -->
        <Border x:Name="FormPanel" Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
            <Border.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SubmitCommand}" />
                <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
            </Border.InputBindings>
            <StackPanel>
                <!-- Etikett: name, sort, source, reason and Sprid inte. -->
                <StackPanel Visibility="{Binding IsLabelOpen, Converter={StaticResource Visible}}">
                    <!-- From a check (sketch TJ1b): the check as the label's source, a dashed badge, never a fact. -->
                    <Border HorizontalAlignment="Left" Margin="0,4,0,2" Padding="8,2" CornerRadius="9" BorderThickness="1"
                            BorderBrush="{StaticResource Brush.TextDim}"
                            ToolTip="Etiketten är en bedömning med kontrollen som källa, inte ett faktum"
                            Visibility="{Binding IsFromCheck, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding CheckSourceText}" FontSize="11.5" Foreground="{StaticResource Brush.TextMuted}" />
                    </Border>
                    <TextBlock Text="Namn" Style="{StaticResource Text.FormLabel}" />
                    <TextBox x:Name="NameBox" Style="{StaticResource TextBox.Form}" AutomationProperties.Name="Namn"
                             MaxLength="{x:Static graph:InspectorForms.MostNameLength}"
                             Text="{Binding LabelName, UpdateSourceTrigger=PropertyChanged}" />
                    <DockPanel>
                        <TextBlock Text="{Binding KindName}" DockPanel.Dock="Right" FontSize="12.5" Margin="0,12,0,5"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock Text="Sort" Style="{StaticResource Text.FormLabel}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Kinds}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:KindChoice}">
                                <Button Style="{StaticResource Button.Bare}" ToolTip="{Binding Name}" Margin="0,0,4,4"
                                        AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.ChooseKindCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Border x:Name="Tile" Width="32" Height="32" CornerRadius="7" BorderThickness="1"
                                            Background="{StaticResource Brush.Surface}"
                                            BorderBrush="{StaticResource Brush.Border}">
                                        <Border x:Name="Frame" Width="22" Height="22" CornerRadius="6" BorderThickness="1.2"
                                                BorderBrush="{Binding Option.Look.Ink,
                                                                      Converter={x:Static controls:GraphInkConverter.Instance}}">
                                            <controls:GridIcon Size="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{Binding Option.Look.Ink,
                                                                                    Converter={x:Static controls:GraphInkConverter.Instance}}"
                                                               Data="{Binding Option.Look.Icon,
                                                                              Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                                        </Border>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Option.Look.Shape}" Value="{x:Static graph:NodeShape.Round}">
                                        <Setter TargetName="Frame" Property="CornerRadius" Value="11" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Option.Look.IsDashed}" Value="True">
                                        <Setter TargetName="Frame" Property="Opacity" Value="0.8" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChosen}" Value="True">
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                        <Setter TargetName="Tile" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Källa" Style="{StaticResource Text.FormLabel}"
                               Visibility="{Binding IsFromCheck, Converter={x:Static controls:InvertVisibility.Instance}}" />
                    <ItemsControl ItemsSource="{Binding Bases}" Focusable="False"
                                  Visibility="{Binding IsFromCheck, Converter={x:Static controls:InvertVisibility.Instance}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BasisChoice}">
                                <Button Style="{StaticResource Button.Chip}" Content="{Binding Name}"
                                        Command="{Binding DataContext.ChooseBasisCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding IsOpenSource, Converter={StaticResource Visible}}">
                        <TextBlock Text="Vilken källa" Style="{StaticResource Text.FormLabel}" Margin="0,6,0,5" />
                        <TextBox Style="{StaticResource TextBox.Form}" AutomationProperties.Name="Vilken källa"
                                 MaxLength="{x:Static graph:InspectorForms.MostNameLength}"
                                 Text="{Binding SourceName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Text="Skäl (frivilligt)" Style="{StaticResource Text.FormLabel}" />
                    <TextBox Style="{StaticResource TextBox.Reason}" AutomationProperties.Name="Skäl"
                             Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                    <ToggleButton Style="{StaticResource Toggle.Switch}" Margin="0,12,0,0" IsChecked="{Binding DoNotSpread}"
                                  AutomationProperties.Name="Sprid inte" IsEnabled="{Binding IsSpreadOptional}"
                                  Focusable="False"
                                  ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Håller etiketten borta från biblioteket och andra ärenden. Ett offer sprids aldrig.">
                        <StackPanel Orientation="Horizontal">
                            <controls:GridIcon Size="14" Data="{StaticResource Icon.NoSpread}"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                            <TextBlock Text="Sprid inte" FontSize="13.5" Margin="6,0,0,0"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <!-- Bryt upp: the cluster's addresses with their heuristics, and the reason. -->
                <StackPanel Visibility="{Binding IsSplitOpen, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <TextBlock Text="{Binding PickedText}" DockPanel.Dock="Right" FontSize="12.5" Margin="0,12,0,5"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   Visibility="{Binding ShowsMembers, Converter={StaticResource Visible}}" />
                        <TextBlock Text="Adresser i klustret" Style="{StaticResource Text.FormLabel}"
                                   Visibility="{Binding ShowsMembers, Converter={StaticResource Visible}}" />
                    </DockPanel>
                    <TextBlock Text="{Binding MembersNotice}" FontSize="13" Foreground="{StaticResource Brush.TextDim}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Virtualized in a box of its own, so that an exchange's cluster with thousands of addresses
                         costs only the rows on screen (principle 6). -->
                    <TextBlock Text="Ctrl + klick på adressen som inte hör ihop med den" Style="{StaticResource Text.FormNote}"
                               Margin="0,0,0,6"
                               Visibility="{Binding ShowsMembers, Converter={StaticResource Visible}}" />
                    <ItemsControl x:Name="MemberList" ItemsSource="{Binding Members}" Focusable="False" MaxHeight="280"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                  Visibility="{Binding ShowsMembers, Converter={StaticResource Visible}}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel VirtualizationMode="Recycling" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MemberChoice}">
                                <Button Style="{StaticResource Button.Bare}" ToolTip="{Binding ToolTip}"
                                        AutomationProperties.Name="{Binding ShortAddress}"
                                        Command="{Binding DataContext.ToggleMemberCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Border x:Name="Row" CornerRadius="5" Padding="6,5" Background="Transparent">
                                        <!-- Ctrl+click: the address that is not the same owner as the one picked (BU1a). -->
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="Ctrl+LeftClick" CommandParameter="{Binding}"
                                                          Command="{Binding DataContext.PickPairCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </Border.InputBindings>
                                        <DockPanel>
                                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="3" BorderThickness="1.2"
                                                    DockPanel.Dock="Left" BorderBrush="{StaticResource Brush.TextDim}">
                                                <controls:GridIcon x:Name="Check" Size="10" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" Data="{StaticResource Icon.Kind.Check}"
                                                                   Foreground="Transparent" />
                                            </Border>
                                            <TextBlock Text="{Binding Heuristic}" DockPanel.Dock="Right" FontSize="12"
                                                       Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="Address" Text="{Binding ShortAddress}" FontSize="12.5"
                                                       FontFamily="{StaticResource Font.Mono}" Margin="8,0,6,0"
                                                       Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                        <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}" />
                                        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                        <Setter TargetName="Check" Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                                        <Setter TargetName="Address" Property="Foreground" Value="{StaticResource Brush.Text}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The pair's way (sketch BU1a): the addresses as dots and the links as a chain, scissors on one. -->
                    <StackPanel Visibility="{Binding IsPairMode, Converter={StaticResource Visible}}">
                        <StackPanel Visibility="{Binding IsApart, Converter={x:Static controls:InvertVisibility.Instance}}">
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Bare}" Content="Alla adresser"
                                        FontSize="12" Foreground="{StaticResource Brush.TextDim}" Cursor="Hand"
                                        Command="{Binding LeavePairCommand}" />
                                <TextBlock Text="Vägen mellan dem. Välj länken som inte stämmer." FontSize="12.5"
                                           Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding PathLinks}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PathLinkViewModel}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="4,4,0,4">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.TextDim}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding From}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5"
                                                           Margin="10,0,0,0" />
                                            </StackPanel>
                                            <Button Style="{StaticResource Button.Bare}" Cursor="Hand" CommandParameter="{Binding}"
                                                    ToolTip="Klipp här"
                                                    Command="{Binding DataContext.ChooseCutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Border x:Name="Link" CornerRadius="7" BorderThickness="1" Padding="8,5"
                                                        BorderBrush="Transparent" Background="Transparent">
                                                    <DockPanel>
                                                        <Rectangle x:Name="Chain" DockPanel.Dock="Left" Width="1.5" Margin="3,0,14,0"
                                                                   Fill="{StaticResource Brush.TextDim}" />
                                                        <controls:GridIcon x:Name="Scissors" DockPanel.Dock="Right" Size="14"
                                                                           Data="{StaticResource Icon.Scissors}" Visibility="Hidden"
                                                                           Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                                                        <Border DockPanel.Dock="Right" CornerRadius="8" BorderThickness="1" Padding="6,0"
                                                                Margin="0,0,8,0" VerticalAlignment="Center"
                                                                BorderBrush="{StaticResource Brush.BorderStrong}"
                                                                Visibility="{Binding IsWeakest, Converter={StaticResource Visible}}">
                                                            <TextBlock Text="svagast" FontSize="10.5" Foreground="{StaticResource Brush.TextDim}" />
                                                        </Border>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Heuristic}" FontSize="13" />
                                                            <TextBlock Text="{Binding Tx}" FontSize="11" FontFamily="{StaticResource Font.Mono}"
                                                                       Foreground="{StaticResource Brush.TextDim}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </Button>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCut}" Value="True">
                                                <Setter TargetName="Link" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                <Setter TargetName="Link" Property="Background" Value="{StaticResource Brush.AccentTint}" />
                                                <Setter TargetName="Scissors" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Chain" Property="Fill" Value="{StaticResource Brush.Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDashed}" Value="True">
                                                <Setter TargetName="Chain" Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="4,4,0,8">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PairLast}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                            <Border CornerRadius="8" Padding="10,8" Background="{StaticResource Brush.SurfaceRaised}">
                                <DockPanel>
                                    <controls:GridIcon DockPanel.Dock="Left" Size="14" Data="{StaticResource Icon.Kind.Wallet}"
                                                       Foreground="{StaticResource Brush.TextDim}" Margin="0,1,8,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding PairResult}" FontSize="12.5" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- Not in the same cluster: the two with their clusters and a broken line, and only Stäng. -->
                        <StackPanel Visibility="{Binding IsApart, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding PairFromText}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" />
                            <Rectangle Width="1.5" Height="22" HorizontalAlignment="Left" Margin="3,4" StrokeThickness="1.5"
                                       Stroke="{StaticResource Brush.Error}" StrokeDashArray="2 2" />
                            <TextBlock Text="{Binding PairToText}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" />
                            <Border Margin="0,10,0,0" CornerRadius="8" Padding="10,8" Background="{StaticResource Brush.ErrorTint}">
                                <TextBlock Text="{x:Static vm:InspectorFormsViewModel.ApartText}" FontSize="12.5" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Skäl (frivilligt)" Style="{StaticResource Text.FormLabel}"
                               Visibility="{Binding IsApart, Converter={x:Static controls:InvertVisibility.Instance}}" />
                    <TextBox x:Name="SplitReasonBox" Visibility="{Binding IsApart, Converter={x:Static controls:InvertVisibility.Instance}}" Style="{StaticResource TextBox.Reason}" AutomationProperties.Name="Skäl"
                             Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <controls:GridIcon Size="13" Data="{StaticResource Icon.Hold}" Foreground="{StaticResource Brush.TextDim}" />
                        <TextBlock Text="Håller, slås inte ihop igen" Style="{StaticResource Text.FormNote}" />
                    </StackPanel>
                </StackPanel>

                <!-- Annan kedja: the chain, the coin when several came in, the transaction and the reason. -->
                <StackPanel Visibility="{Binding IsCrossChainOpen, Converter={StaticResource Visible}}">
                    <TextBlock Text="Fortsätter på" Style="{StaticResource Text.FormLabel}" />
                    <ItemsControl ItemsSource="{Binding Chains}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChainChoice}">
                                <Button Style="{StaticResource Button.Chip}" Content="{Binding Name}" ToolTip="{Binding ToolTip}"
                                        IsEnabled="{Binding IsBuilt}"
                                        Visibility="{Binding IsShown, Converter={StaticResource Visible}}"
                                        Command="{Binding DataContext.ChooseChainCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding ShowsCoins, Converter={StaticResource Visible}}">
                        <TextBlock Text="Myntet som gick vidare" Style="{StaticResource Text.FormLabel}" Margin="0,6,0,5" />
                        <ItemsControl ItemsSource="{Binding Coins}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CoinChoice}">
                                    <Button Style="{StaticResource Button.Bare}" ToolTip="{Binding ToolTip}"
                                            AutomationProperties.Name="{Binding Text}"
                                            Command="{Binding DataContext.ChooseCoinCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Border x:Name="Row" CornerRadius="5" Padding="6,5" Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="Dot" Width="12" Height="12" StrokeThickness="1.2"
                                                         Stroke="{StaticResource Brush.TextDim}" />
                                                <TextBlock x:Name="Coin" Text="{Binding Text}" FontSize="13" Margin="8,0,0,0"
                                                           Foreground="{StaticResource Brush.TextMuted}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsChosen}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Accent}" />
                                            <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                                            <Setter TargetName="Coin" Property="Foreground" Value="{StaticResource Brush.Text}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="{Binding TxLabel}" Style="{StaticResource Text.FormLabel}" />
                    <Grid>
                        <TextBox x:Name="TxBox" Style="{StaticResource TextBox.Form}" AutomationProperties.Name="Tx på den andra kedjan"
                                 FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Padding="8,0,28,0"
                                 Text="{Binding TxText, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:GridIcon Size="14" HorizontalAlignment="Right" Margin="0,0,9,0" IsHitTestVisible="False"
                                           Data="{StaticResource Icon.Kind.Check}" Foreground="{StaticResource Brush.Success}"
                                           ToolTip="Känns igen"
                                           Visibility="{Binding IsTxRecognised, Converter={StaticResource Visible}}" />
                    </Grid>
                    <TextBlock Text="Skäl (frivilligt)" Style="{StaticResource Text.FormLabel}" />
                    <TextBox Style="{StaticResource TextBox.Reason}" AutomationProperties.Name="Skäl"
                             Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <controls:GridIcon Size="13" Data="{StaticResource Icon.Link}"
                                           Foreground="{StaticResource Brush.Kind.OtherChain}" />
                        <TextBlock Text="Ritas lila och streckad, som en bedömning" Style="{StaticResource Text.FormNote}" />
                    </StackPanel>
                </StackPanel>

                <!-- What the case refused, and Avbryt (Esc) and the store button (Enter). -->
                <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Error}" Margin="0,10,0,0" />
                <DockPanel Margin="0,14,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Height="32" Padding="12,0"
                            FontSize="13.5" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}"
                            Visibility="{Binding IsApart, Converter={x:Static controls:InvertVisibility.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SubmitText}" />
                            <TextBlock Text="Enter" Margin="7,0,0,0" FontWeight="Normal" Opacity="0.6" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Height="32" Padding="12,0"
                            FontSize="13.5" Margin="0,0,8,0" Command="{Binding CancelCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CancelText}" />
                            <TextBlock Text="Esc" Margin="7,0,0,0" Foreground="{StaticResource Brush.TextDim}" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
