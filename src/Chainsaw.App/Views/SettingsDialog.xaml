<UserControl x:Class="Chainsaw.App.Views.SettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:exits="clr-namespace:Chainsaw.App.Exits"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:views="clr-namespace:Chainsaw.App.Views"
             xmlns:network="clr-namespace:Chainsaw.Modules.Network.Contracts;assembly=Chainsaw.Modules.Network.Contracts"
             xmlns:chains="clr-namespace:Chainsaw.Modules.Chains.Contracts;assembly=Chainsaw.Modules.Chains.Contracts"
             Focusable="False" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="OnKey">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A page in the menu: 32 px, the chosen one on the selected surface, as in Gawk's dialog. -->
        <Style x:Key="Settings.Menu" TargetType="Button" BasedOn="{StaticResource Button.MenuItem}">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One option of a segmented choice: the chosen one on the selected surface. -->
        <Style x:Key="Settings.Segment" TargetType="Button">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="1"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The frame around a segmented choice. -->
        <Style x:Key="Settings.SegmentFrame" TargetType="Border">
            <Setter Property="Padding" Value="2" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
            <Setter Property="Background" Value="#262A2E" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A row of a page: the title and its explanation to the left, the choice to the right. -->
        <Style x:Key="Settings.Row" TargetType="Border">
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.SubmenuHover}" />
        </Style>

        <!-- A row that is not built yet: toned, with its tag. -->
        <Style x:Key="Settings.RowNotBuilt" TargetType="Border" BasedOn="{StaticResource Settings.Row}">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>

        <Style x:Key="Settings.RowTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="Settings.RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Settings.Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The tag Inte byggt än beside a title. -->
        <Style x:Key="Settings.Tag" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A button at the right of a row: Byt …, Visa. -->
        <Style x:Key="Settings.Button" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The switch: magenta and to the right when on (sketch ST1a). -->
        <Style x:Key="Settings.Switch" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Track" CornerRadius="10" Background="{StaticResource Brush.BorderStrong}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource Brush.Text}"
                                     HorizontalAlignment="Left" Margin="2,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding LocksWithWindows}" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A switch whose state is its Tag: magenta and to the right when on. -->
        <Style x:Key="Settings.TagSwitch" TargetType="Button" BasedOn="{StaticResource Settings.Switch}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Track" CornerRadius="10" Background="{StaticResource Brush.BorderStrong}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource Brush.Text}"
                                     HorizontalAlignment="Left" Margin="2,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The form's switch Lokal: magenta and to the right when the endpoint is the user's own node. -->
        <Style x:Key="Sources.LocalSwitch" TargetType="Button" BasedOn="{StaticResource Settings.Switch}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Track" CornerRadius="10" Background="{StaticResource Brush.BorderStrong}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource Brush.Text}"
                                     HorizontalAlignment="Left" Margin="2,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding NewLocal}" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A way of saying a hit (sketch BV4a): a tile with its icon, tinted in the accent while the way is on (its Tag);
             the icon takes the tile's BorderBrush as its colour. -->
        <Style x:Key="Settings.WayTile" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.AccentTint}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A round button with a ring: Lyssna (sketch BV4a) and an exit's power button. -->
        <Style x:Key="Settings.RoundButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="15" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A card of the way out: the chosen one in the accent (sketch ST1a). -->
        <Style x:Key="Settings.Card" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
            <Setter Property="Background" Value="#2F3236" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5" CornerRadius="10" Padding="14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An option of a segmented choice. -->
        <DataTemplate x:Key="Settings.Option" DataType="{x:Type vm:SettingsChoice}">
            <Button Style="{StaticResource Settings.Segment}" Content="{Binding Label}" CommandParameter="{Binding}"
                    Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="Settings.Options">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- A small label over a field in a folded-out exit. -->
        <Style x:Key="Exit.Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- A quiet button in a folded-out exit: Kontrollera nu, Avbryt, Ta bort utgången …. -->
        <Style x:Key="Exit.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!--
          An exit as a row of the table (sketch UT3b): its dot, its name, its place, what it is seen as (the address and
          country, a spinner while it is asked, a warning in yellow when the country is not the one its place says) and
          its power button; a click folds it out with its name and place, the box Kontroll and Ta bort utgången ….
        -->
        <DataTemplate x:Key="Settings.ExitRow" DataType="{x:Type vm:ExitRowViewModel}">
            <Border x:Name="Row" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border}" Background="Transparent">
                <StackPanel>
                    <Border x:Name="Head" Height="54" Padding="16,0,12,0" Background="Transparent" Cursor="Hand"
                            ToolTip="Visa namn, plats och kontroll">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                          Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="21" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource Brush.TextDim}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                            <TextBlock x:Name="Place" Grid.Column="2" Text="{Binding PlaceText}" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent"
                                        ToolTip="{Binding SeenTip}" ClipToBounds="True">
                                <Grid Width="14" Height="14" Margin="0,0,8,0" Visibility="{Binding IsChecking, Converter={StaticResource Visible}}">
                                    <Ellipse Width="10.8" Height="10.8" StrokeThickness="1.5" Stroke="{StaticResource Brush.SurfaceRaised}" />
                                    <Path Width="14" Height="14" Stretch="None" StrokeThickness="1.5" Stroke="{StaticResource Brush.TextMuted}"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M7,2.35 A4.65,4.65 0 0 1 11.65,7"
                                          RenderTransformOrigin="0.5,0.5" Loaded="OnSpinnerLoaded">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                                <controls:GridIcon x:Name="SeenIcon" Size="14" Margin="0,0,8,0" Data="{StaticResource Icon.Check}"
                                                   Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center"
                                                   Visibility="{Binding HasCheckIcon, Converter={StaticResource Visible}}" />
                                <TextBlock x:Name="Seen" Text="{Binding SeenText}" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextDim}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SeenSubText}" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextDim}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="Power" Style="{StaticResource Settings.RoundButton}" Width="32" Height="32"
                                        Command="{Binding DataContext.PowerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding ActionText}"
                                        AutomationProperties.Name="{Binding ActionName}">
                                    <controls:GridIcon Size="16" Data="{StaticResource Icon.Power}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                                <Border Width="32" Height="32">
                                    <controls:GridIcon x:Name="Chevron" Size="14" Data="{StaticResource Icon.ChevronRight}"
                                                       Foreground="{StaticResource Brush.TextDim}" RenderTransformOrigin="0.5,0.5">
                                        <controls:GridIcon.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </controls:GridIcon.RenderTransform>
                                    </controls:GridIcon>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Folded out: the name and the place to the left, the box Kontroll to the right. -->
                    <Grid Margin="37,6,20,18" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Namn" Style="{StaticResource Exit.Label}" />
                            <TextBox Style="{StaticResource TextBox.Field}" Height="34" FontSize="13.5" AutomationProperties.Name="Namn"
                                     Background="{StaticResource Brush.Surface}" MaxLength="{x:Static network:ExitRules.MaximumNameLength}"
                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="OnExitFieldLeft">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.DescribeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Plats" Style="{StaticResource Exit.Label}" Margin="0,12,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="CountryButton" Height="34" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                              AutomationProperties.Name="Land" ToolTip="Välj land">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Box" CornerRadius="8" Background="{StaticResource Brush.Surface}" Padding="10,0,8,0"
                                                    BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <DockPanel>
                                        <controls:GridIcon DockPanel.Dock="Left" Size="14" Data="{StaticResource Icon.Globe}"
                                                           Foreground="{StaticResource Brush.TextDim}" Margin="0,0,8,0" />
                                        <controls:GridIcon DockPanel.Dock="Right" Size="12" Data="{StaticResource Icon.ChevronDown}"
                                                           Foreground="{StaticResource Brush.TextDim}" />
                                        <TextBlock x:Name="CountryText" Text="{Binding EditCountry.Name, FallbackValue=Land}" FontSize="13.5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=CountryButton}" PlacementTarget="{Binding ElementName=CountryButton}"
                                       Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True"
                                       Closed="OnCountriesClosed" Tag="{Binding ElementName=CountryButton}">
                                    <Border Width="220" MaxHeight="260" CornerRadius="8" Padding="4" Background="{StaticResource Brush.Floating}"
                                            BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                            <ItemsControl x:Name="CountryList" ItemsSource="{x:Static exits:ExitPlace.Countries}"
                                                          Focusable="False" AutomationProperties.Name="Länder">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type exits:Country}">
                                                        <Button Style="{StaticResource Button.MenuItem}" Height="30" Content="{Binding Name}"
                                                                FontSize="13.5" Click="OnCountryPicked"
                                                                Tag="{Binding DataContext, ElementName=CountryList}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                                <TextBox Grid.Column="2" Style="{StaticResource TextBox.Field}" Height="34" FontSize="13.5" Tag="Stad, valfri"
                                         Background="{StaticResource Brush.Surface}" AutomationProperties.Name="Stad"
                                         MaxLength="{x:Static network:ExitRules.MaximumPlaceLength}"
                                         Text="{Binding EditCity, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="OnExitFieldLeft">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.DescribeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Grid>
                            <Button Style="{StaticResource Exit.Ghost}" Margin="0,12,0,0" BorderBrush="Transparent" Padding="8,0,10,0"
                                    CommandParameter="{Binding}" AutomationProperties.Name="Ta bort utgången"
                                    Command="{Binding DataContext.AskRemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:GridIcon Size="14" Data="{StaticResource Icon.Trash}" Margin="0,0,8,0"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Ta bort utgången …" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Grid.Column="2" CornerRadius="10" Padding="16,14" Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionText}" FontSize="12"
                                               Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" />
                                    <controls:GridIcon DockPanel.Dock="Left" Size="16" Data="{StaticResource Icon.ShieldCheck}"
                                                       Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,8,0" />
                                    <TextBlock Text="Kontroll" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Facts}" Focusable="False" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type exits:ExitFact}">
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock DockPanel.Dock="Left" Width="92" Text="{Binding Key}" FontSize="12.5"
                                                           Foreground="{StaticResource Brush.TextDim}" />
                                                <TextBlock x:Name="Value" Text="{Binding Value}" FontSize="12.5" TextWrapping="Wrap"
                                                           Foreground="{StaticResource Brush.Text}" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsAddress}" Value="True">
                                                    <Setter TargetName="Value" Property="FontFamily" Value="{StaticResource Font.Mono}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static exits:ExitFactTone.Quiet}">
                                                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static exits:ExitFactTone.Warning}">
                                                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Brush.Pending}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource Exit.Ghost}" Margin="0,4,0,0" CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanCheck}" AutomationProperties.Name="Kontrollera nu"
                                        ToolTip="Bara en ansluten utgång kan kontrolleras"
                                        Visibility="{Binding DataContext.CanCheck, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Visible}}"
                                        Command="{Binding DataContext.CheckNowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:GridIcon Size="14" Data="{StaticResource Icon.Refresh}" Margin="0,0,8,0"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="Kontrollera nu" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{x:Static exits:ExitCheckWords.AboutText}" FontSize="11.5" Margin="0,10,0,0"
                                           Foreground="{StaticResource Brush.TextDim}" TextWrapping="Wrap" LineHeight="17" />
                            </StackPanel>
                        </Border>

                        <!-- Ta bort …? asked under both halves, in the error's tone. -->
                        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0" Padding="14,12" CornerRadius="10"
                                Background="{StaticResource Brush.ErrorTint}" BorderBrush="{StaticResource Brush.ErrorEdge}"
                                BorderThickness="1" Visibility="{Binding IsRemoving, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Height="30" Padding="12,0" Margin="8,0,0,0" FontSize="13" Cursor="Hand"
                                        Style="{StaticResource Exit.Ghost}" Foreground="{StaticResource Brush.Error}"
                                        BorderBrush="{StaticResource Brush.ErrorEdge}" Background="{StaticResource Brush.ErrorTint}"
                                        Content="Ta bort" CommandParameter="{Binding}" AutomationProperties.Name="Ta bort utgången nu"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource Exit.Ghost}" CommandParameter="{Binding}"
                                        ToolTip="Avbryt (Esc)"
                                        Command="{Binding DataContext.CancelRemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Avbryt" />
                                        <TextBlock Text="Esc" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding RemoveText}" FontSize="13" TextWrapping="Wrap" LineHeight="19"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Head" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Head" Property="Background" Value="{StaticResource Brush.Surface}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Surface}" />
                    <Setter TargetName="Chevron" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="90" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPlace}" Value="False">
                    <Setter TargetName="Place" Property="Foreground" Value="{StaticResource Brush.TextFaint}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter TargetName="Power" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                    <Setter TargetName="Power" Property="Foreground" Value="{StaticResource Brush.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static exits:ExitRowState.Connected}">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static exits:ExitRowState.Connecting}">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Pending}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static exits:ExitRowState.Failed}">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSeenAddress}" Value="True">
                    <Setter TargetName="Seen" Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter TargetName="Seen" Property="Foreground" Value="{StaticResource Brush.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Check}" Value="{x:Static exits:ExitCheckState.Mismatch}">
                    <Setter TargetName="SeenIcon" Property="Data" Value="{StaticResource Icon.Alert}" />
                    <Setter TargetName="SeenIcon" Property="Foreground" Value="{StaticResource Brush.Pending}" />
                    <Setter TargetName="Seen" Property="Foreground" Value="{StaticResource Brush.Pending}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Check}" Value="{x:Static exits:ExitCheckState.Failed}">
                    <Setter TargetName="SeenIcon" Property="Data" Value="{StaticResource Icon.Offline}" />
                    <Setter TargetName="SeenIcon" Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== The page Källor (sketch KL2b, without the lines at the items: the user's decision 2026-11-08) ===== -->

        <!-- A dot: filled in its state's colour, or a ring when it is not tried or switched off. -->
        <Style x:Key="Sources.Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{StaticResource Brush.TextFaint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Dot}" Value="{x:Static vm:EndpointDot.Answered}">
                    <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                    <Setter Property="Stroke" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Dot}" Value="{x:Static vm:EndpointDot.Behind}">
                    <Setter Property="Fill" Value="{StaticResource Brush.Pending}" />
                    <Setter Property="Stroke" Value="{StaticResource Brush.Pending}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Dot}" Value="{x:Static vm:EndpointDot.Failed}">
                    <Setter Property="Fill" Value="{StaticResource Brush.Error}" />
                    <Setter Property="Stroke" Value="{StaticResource Brush.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Dot}" Value="{x:Static vm:EndpointDot.Untried}">
                    <Setter Property="Stroke" Value="{StaticResource Brush.TextDim}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A row of the middle column: a chain or a supplier; the chosen one on the raised surface, no strip. -->
        <Style x:Key="Sources.ListRow" TargetType="Button">
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="9" BorderThickness="1"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A chain in the middle column: its dot, its name, and the mode with how many are on. -->
        <DataTemplate x:Key="Sources.Chain" DataType="{x:Type vm:SourceChainChip}">
            <Button x:Name="Row" Style="{StaticResource Sources.ListRow}" ToolTip="{Binding Tip}"
                    AutomationProperties.Name="{Binding Tip}" CommandParameter="{Binding}"
                    Command="{Binding DataContext.ShowChipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource Sources.Dot}" Margin="0,0,11,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" />
                        <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{StaticResource Brush.TextDim}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBuilt}" Value="False">
                    <Setter TargetName="Row" Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A supplier of attribution in the middle column, under Etiketter: the same kind of row. -->
        <DataTemplate x:Key="Sources.Supplier" DataType="{x:Type vm:AttributionSupplierViewModel}">
            <Button Style="{StaticResource Sources.ListRow}" AutomationProperties.Name="{Binding Name}"
                    CommandParameter="{Binding}"
                    Command="{Binding DataContext.ShowSupplierCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource Sources.Dot}" Margin="0,0,11,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" />
                        <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{StaticResource Brush.TextDim}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!--
          The keyboard's ring around a mode. WPF shows a focus visual only when focus came from the keyboard, so a click
          on a mode does not leave an accent frame around it (which made the switch look broken).
        -->
        <Style x:Key="Sources.ModeFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle RadiusX="7" RadiusY="7" Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One of the three modes as an icon: the chosen one on the selected surface, in the accent (Av in cream). -->
        <DataTemplate x:Key="Sources.Mode" DataType="{x:Type vm:SettingsChoice}">
            <Button x:Name="Mode" Width="34" Height="28" Margin="1,0" Cursor="Hand"
                    FocusVisualStyle="{StaticResource Sources.ModeFocus}"
                    Background="Transparent" Foreground="{StaticResource Brush.TextDim}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Label}"
                    Command="{Binding DataContext.ChooseModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <Button.ToolTip>
                    <TextBlock MaxWidth="260" TextWrapping="Wrap">
                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". " /><Run Text="{Binding Hint, Mode=OneWay}" />
                    </TextBlock>
                </Button.ToolTip>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="7" BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <controls:GridIcon x:Name="Icon" Size="16" Data="{StaticResource Icon.Bolt}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Value}" Value="{x:Static chains:SourceMode.Priority}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource Icon.ListOrdered}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Value}" Value="{x:Static chains:SourceMode.Off}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource Icon.Power}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Mode" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                    <Setter TargetName="Mode" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding Value}" Value="{x:Static chains:SourceMode.Off}" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Mode" Property="Foreground" Value="{StaticResource Brush.Text}" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A switch whose state is IsOn: the accent and to the right when on. -->
        <Style x:Key="Sources.Switch" TargetType="Button" BasedOn="{StaticResource Settings.Switch}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Track" CornerRadius="9" Background="Transparent" BorderThickness="1.5"
                                BorderBrush="{StaticResource Brush.TextFaint}">
                            <Ellipse x:Name="Knob" Width="11" Height="11" Fill="{StaticResource Brush.TextDim}"
                                     HorizontalAlignment="Left" Margin="1.5,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Brush.OnAccent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The handle and place in Prioriterad: drag it, or Alt+↑ and Alt+↓. -->
        <DataTemplate x:Key="Sources.Handle" DataType="{x:Type vm:EndpointRowViewModel}">
            <StackPanel Orientation="Horizontal" Margin="-6,0,6,0"
                        Visibility="{Binding IsPriority, Converter={StaticResource Visible}}">
                <Button x:Name="Handle" Style="{StaticResource Button.Icon}" Width="20" Height="28" Cursor="SizeNS"
                        ToolTip="Dra för att ordna (Alt+↑ och Alt+↓)" AutomationProperties.Name="Flytta"
                        PreviewMouseLeftButtonDown="OnHandleDown">
                    <controls:GridIcon Size="14" Data="{StaticResource Icon.Grip}" Foreground="{StaticResource Brush.TextDim}" />
                </Button>
                <TextBlock Text="{Binding Position}" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}"
                           VerticalAlignment="Center" MinWidth="10" />
            </StackPanel>
        </DataTemplate>

        <!-- The mark beside a name: ↓ 3 block efter or the clock and Väntar in the warning colour, × Svarar inte in red. -->
        <DataTemplate x:Key="Sources.Note" DataType="{x:Type vm:EndpointRowViewModel}">
            <StackPanel x:Name="Note" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                        Background="Transparent" ToolTip="{Binding NoteTip}"
                        Visibility="{Binding HasNote, Converter={StaticResource Visible}}">
                <controls:GridIcon x:Name="Icon" Size="12" Data="{StaticResource Icon.ArrowDown}" Margin="0,0,4,0"
                                   Foreground="{StaticResource Brush.Pending}" VerticalAlignment="Center" />
                <TextBlock x:Name="Words" Text="{Binding Note}" FontSize="12" Foreground="{StaticResource Brush.Pending}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding NoteKind}" Value="{x:Static vm:EndpointNote.Waiting}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource Icon.Clock}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NoteKind}" Value="{x:Static vm:EndpointNote.Failed}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource Icon.Cross}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Brush.Error}" />
                    <Setter TargetName="Words" Property="Foreground" Value="{StaticResource Brush.Error}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
          The endpoint in use as a raised card: the handle in Prioriterad, the dot, the name, ★, the house for the own
          node, the switch and × on hovering, and the latency large; under it the address and what the latest probe
          answered. No bar under it (the user's decision 2026-11-08).
        -->
        <!-- A fingerprint as a picture: eight by four cells, one per byte, with its words under it. -->
        <DataTemplate x:Key="Sources.Art" DataType="{x:Type vm:FingerprintArt}">
            <StackPanel Margin="0,0,18,0">
                <Border x:Name="Frame" Padding="5" CornerRadius="8" BorderThickness="1.5" HorizontalAlignment="Left"
                        Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.PendingEdge}">
                    <ItemsControl x:Name="Grid" ItemsSource="{Binding Cells}" Focusable="False" Width="120" Height="60">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="8" Rows="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Width="13" Height="13" RadiusX="2.5" RadiusY="2.5" Fill="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="11.5" Margin="0,7,0,0"
                           Foreground="{StaticResource Brush.TextMuted}" />
                <TextBlock x:Name="Short" Text="{Binding Short}" FontSize="11.5" FontFamily="Cascadia Mono, Consolas"
                           Margin="0,3,0,0" Foreground="{StaticResource Brush.TextMuted}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:NodePinTone.Good}">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:NodePinTone.Bad}">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Brush.ErrorEdge}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Error}" />
                    <Setter TargetName="Short" Property="Foreground" Value="{StaticResource Brush.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:NodePinTone.Faded}">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Brush.Submenu}" />
                    <Setter TargetName="Grid" Property="Opacity" Value="0.55" />
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                    <Setter TargetName="Short" Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
          The box of the own node's certificate (sketch KL3b): the state with when and by whom, the picture or the two
          side by side, who issued it and how long it is valid with Kopiera, the note, the question before trusting the
          new or removing the pin, and the buttons.
        -->
        <DataTemplate x:Key="Sources.PinBox" DataType="{x:Type vm:NodePinViewModel}">
            <Grid Width="456" Margin="0,6,0,24">
                <Border CornerRadius="12" Background="{StaticResource Brush.Floating}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="12" Background="{StaticResource Brush.Floating}" BorderThickness="1.5"
                        BorderBrush="{StaticResource Brush.BorderStrong}" Padding="18,16">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding WhenText}" FontSize="12"
                                       Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal">
                                <controls:GridIcon x:Name="StateIcon" Size="16" Data="{StaticResource Icon.Shield}"
                                                   Foreground="{StaticResource Brush.Pending}" Margin="0,0,9,0" />
                                <TextBlock x:Name="StateText" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="13.5"
                                           Foreground="{StaticResource Brush.Pending}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,14,0,0">
                            <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Arts}" Focusable="False"
                                          ItemTemplate="{StaticResource Sources.Art}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel Visibility="{Binding IsSingle, Converter={StaticResource Visible}}"
                                        TextElement.FontSize="12.5">
                                <DockPanel>
                                    <TextBlock Text="Utfärdare" Width="64" Foreground="{StaticResource Brush.TextDim}" />
                                    <TextBlock Text="{Binding IssuerText}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock Text="Giltigt" Width="64" Foreground="{StaticResource Brush.TextDim}" />
                                    <TextBlock Text="{Binding ValidText}" TextWrapping="Wrap" />
                                </DockPanel>
                                <DockPanel Margin="0,8,0,0" Visibility="{Binding HasCopy, Converter={StaticResource Visible}}">
                                    <TextBlock Text="SHA-256" Width="64" Foreground="{StaticResource Brush.TextDim}" />
                                    <Button Style="{StaticResource Exit.Ghost}" HorizontalAlignment="Left" Click="OnCopyFingerprint"
                                            ToolTip="Kopiera hela fingeravtrycket" AutomationProperties.Name="Kopiera fingeravtrycket">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:GridIcon Size="12" Data="{StaticResource Icon.Copy}" Margin="0,0,6,0"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock Text="Kopiera" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                            </StackPanel>
                            <TextBlock Visibility="{Binding IsPair, Converter={StaticResource Visible}}" Margin="0,22,0,0"
                                       Text="{x:Static vm:NodePinViewModel.PairText}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.TextMuted}" LineHeight="19" />
                        </DockPanel>

                        <TextBlock Text="{Binding Note}" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}"
                                   TextWrapping="Wrap" LineHeight="19" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Error}" FontSize="12.5"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource Visible}}" />

                        <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="9" BorderThickness="1"
                                BorderBrush="{StaticResource Brush.PendingEdge}" Background="{StaticResource Brush.PendingTint}"
                                Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding Question}" FontSize="13" TextWrapping="Wrap" LineHeight="19" />
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Style="{StaticResource Settings.Button}" Content="Avbryt" Height="32" FontSize="13"
                                    Command="{Binding CancelConfirmCommand}"
                                    Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}" />
                            <Button Style="{StaticResource Settings.Button}" Height="32" FontSize="13" Margin="8,0,0,0"
                                    Foreground="{StaticResource Brush.Pending}" Background="{StaticResource Brush.PendingTint}"
                                    BorderBrush="{StaticResource Brush.PendingEdge}"
                                    Command="{Binding ConfirmCommand}"
                                    Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:GridIcon Size="14" Data="{StaticResource Icon.Pin}" Margin="0,0,7,0"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="{Binding ConfirmText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Settings.Button}" Height="32" FontSize="13"
                                    Command="{Binding AskTrustCommand}"
                                    Visibility="{Binding CanTrust, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:GridIcon Size="14" Data="{StaticResource Icon.Pin}" Margin="0,0,7,0"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Lita på det nya …" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Exit.Ghost}" Height="32" FontSize="13"
                                    Command="{Binding AskUnpinCommand}"
                                    Visibility="{Binding CanUnpin, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:GridIcon Size="14" Data="{StaticResource Icon.PinOff}" Margin="0,0,7,0"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Ta bort fästet …" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Primary}" Height="32" Padding="12,0" FontSize="13"
                                    Command="{Binding PinCommand}"
                                    Visibility="{Binding CanPin, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:GridIcon Size="14" Data="{StaticResource Icon.Pin}" Margin="0,0,7,0"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Fäst certifikatet" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:NodePinTone.Good}">
                    <Setter TargetName="StateIcon" Property="Data" Value="{StaticResource Icon.ShieldCheck}" />
                    <Setter TargetName="StateIcon" Property="Foreground" Value="{StaticResource Brush.Success}" />
                    <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:NodePinTone.Bad}">
                    <Setter TargetName="StateIcon" Property="Data" Value="{StaticResource Icon.ShieldX}" />
                    <Setter TargetName="StateIcon" Property="Foreground" Value="{StaticResource Brush.Error}" />
                    <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Brush.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:NodePinTone.Faded}">
                    <Setter TargetName="StateIcon" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                    <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
          The endpoint's API key on its own row (sketch NY2a): what it needs and where it is got, the key's last characters
          when it is taken, or the source's own words when it refused it; the field opens on the row when the key is
          missing or refused, or when Byt … is clicked. Only an endpoint that sends a key has the strip.
        -->
        <DataTemplate x:Key="Sources.Key" DataType="{x:Type vm:EndpointRowViewModel}">
            <StackPanel x:Name="Strip" Margin="0,10,0,0" Visibility="{Binding HasKey, Converter={StaticResource Visible}}">
                <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="0,1,0,0" Margin="0,0,0,10" />
                <DockPanel x:Name="Saved" Visibility="{Binding IsKeySaved, Converter={StaticResource Visible}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Ta bort" Margin="12,0,0,0"
                            ToolTip="Ta bort nyckeln ur valvet. Källorna som använder den slutar fråga." CommandParameter="{Binding}"
                            Command="{Binding DataContext.Sources.RemoveKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Byt …" CommandParameter="{Binding}"
                            Command="{Binding DataContext.Sources.ChangeKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:GridIcon Size="13" Data="{StaticResource Icon.Key}" Foreground="{StaticResource Brush.Success}"
                                           Margin="0,0,8,0" />
                        <TextBlock Text="Nyckel" FontSize="13" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding KeyTail}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasKeyLine, Converter={StaticResource Visible}}">
                    <controls:GridIcon x:Name="KeyIcon" Size="13" Data="{StaticResource Icon.Key}"
                                       Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="KeyLine" Text="{Binding KeyText}" FontSize="13" Foreground="{StaticResource Brush.TextMuted}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                <DockPanel Margin="0,8,0,0" Visibility="{Binding IsKeyFieldOpen, Converter={StaticResource Visible}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Avbryt" Margin="8,0,0,0" Height="32" Padding="12,0"
                            Visibility="{Binding IsChangingKey, Converter={StaticResource Visible}}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.Sources.CancelKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Spara · Enter" Margin="8,0,0,0" Height="32" Padding="14,0"
                            Click="OnSaveRowKey" />
                    <PasswordBox Style="{StaticResource PasswordBox.Field}" Tag="Klistra in nyckeln" KeyDown="OnRowKeyKey"
                                 AutomationProperties.Name="API-nyckel" />
                </DockPanel>
                <TextBlock Text="{Binding KeyError}" FontSize="12.5" Foreground="{StaticResource Brush.Error}" Margin="0,6,0,0"
                           TextWrapping="Wrap" Visibility="{Binding HasKeyError, Converter={StaticResource Visible}}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsKeyRefused}" Value="True">
                    <Setter TargetName="KeyIcon" Property="Foreground" Value="{StaticResource Brush.Error}" />
                    <Setter TargetName="KeyLine" Property="Foreground" Value="{StaticResource Brush.Error}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
          The own node's certificate (sketch KL3b): a small pin after the name in the state's colour (amber and struck
          through when it is not pinned, green when it is, red when the node shows another), with its word on a reserve's
          row. A click folds out the box with an arrow towards the pin: the fingerprint as a picture, a grid of one cell
          per byte, so that two certificates compare by eye, and the pinned and the new side by side when it changed.
        -->
        <DataTemplate x:Key="Sources.Pin" DataType="{x:Type vm:EndpointRowViewModel}">
            <Grid Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasPin, Converter={StaticResource Visible}}">
                <Button x:Name="PinButton" Cursor="Hand" ToolTip="{Binding PinTip}" AutomationProperties.Name="{Binding PinTip}"
                        CommandParameter="{Binding}" Focusable="True"
                        Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                        Command="{Binding DataContext.Sources.OpenPinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Pill" Height="22" CornerRadius="11" Padding="7,0" Background="{StaticResource Brush.PendingTint}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:GridIcon x:Name="PinIcon" Size="13" Data="{StaticResource Icon.PinOff}"
                                                       Foreground="{StaticResource Brush.Pending}" />
                                    <TextBlock x:Name="PinWord" Text="{Binding PinWord}" FontSize="11.5" Margin="5,0,1,0"
                                               Foreground="{StaticResource Brush.Pending}" VerticalAlignment="Center"
                                               Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=Collapsed, TargetNullValue=Collapsed}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Pin}" Value="{x:Static vm:EndpointPin.Pinned}">
                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource Brush.SuccessTint}" />
                                    <Setter TargetName="PinIcon" Property="Data" Value="{StaticResource Icon.Pin}" />
                                    <Setter TargetName="PinIcon" Property="Foreground" Value="{StaticResource Brush.Success}" />
                                    <Setter TargetName="PinWord" Property="Foreground" Value="{StaticResource Brush.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Pin}" Value="{x:Static vm:EndpointPin.Changed}">
                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource Brush.ErrorTint}" />
                                    <Setter TargetName="PinIcon" Property="Data" Value="{StaticResource Icon.Pin}" />
                                    <Setter TargetName="PinIcon" Property="Foreground" Value="{StaticResource Brush.Error}" />
                                    <Setter TargetName="PinWord" Property="Foreground" Value="{StaticResource Brush.Error}" />
                                </DataTrigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Brush.Text}" />
                                    <Setter TargetName="Pill" Property="BorderThickness" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Popup IsOpen="{Binding DataContext.IsPinOpen, ElementName=PinButton, Mode=TwoWay}" StaysOpen="False"
                       PlacementTarget="{Binding ElementName=PinButton}" Placement="Bottom" HorizontalOffset="-16"
                       VerticalOffset="6" AllowsTransparency="True" PopupAnimation="Fade"
                       DataContext="{Binding DataContext.Sources.NodePin, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Sources.PinBox}" />
                </Popup>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Sources.Used" DataType="{x:Type vm:EndpointRowViewModel}">
            <Border x:Name="Card" Padding="18,16,18,14" CornerRadius="12" BorderThickness="1.5" Margin="0,8,0,0"
                    Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.BorderStrong}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Run Text="{Binding MillisecondsNumber, Mode=OneWay}" FontSize="22" FontWeight="Light" />
                            <Run x:Name="Unit" Text="ms" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}" />
                        </TextBlock>
                        <Button DockPanel.Dock="Right" Width="24" Height="24"
                                Margin="4,0,0,0" ToolTip="Ta bort" AutomationProperties.Name="Ta bort" CommandParameter="{Binding}"
                                Command="{Binding DataContext.Sources.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                    <Setter Property="Opacity" Value="0" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="IsHitTestVisible" Value="True" />
                                        </DataTrigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <controls:GridIcon Size="12" Data="{StaticResource Icon.Close}" Foreground="{StaticResource Brush.TextDim}" />
                        </Button>
                        <Button DockPanel.Dock="Right" ToolTip="{Binding SwitchTip}"
                                AutomationProperties.Name="{Binding SwitchTip}" CommandParameter="{Binding}"
                                Command="{Binding DataContext.Sources.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Sources.Switch}">
                                    <Setter Property="Opacity" Value="0" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="IsHitTestVisible" Value="True" />
                                        </DataTrigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Sources.Handle}" />
                            <Ellipse Style="{StaticResource Sources.Dot}" Width="9" Height="9" Margin="0,0,10,0"
                                     ToolTip="{Binding DotTip}" />
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <controls:GridIcon Size="14" Data="{StaticResource Icon.Star}" Foreground="{StaticResource Brush.Accent}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="{Binding InUseTip}" />
                            <controls:GridIcon Size="14" Data="{StaticResource Icon.Home}" Foreground="{StaticResource Brush.TextMuted}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               ToolTip="{x:Static vm:EndpointRowViewModel.LocalTip}"
                                               Visibility="{Binding IsLocal, Converter={StaticResource Visible}}" />
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Sources.Pin}" Tag="Collapsed" />
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Sources.Note}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding AnswerText}" FontSize="12.5" Margin="14,0,0,0"
                                   Foreground="{StaticResource Brush.TextDim}" ToolTip="Senaste provet: höjd och blockhash" />
                        <TextBlock Text="{Binding Address}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                   Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Sources.Key}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasMilliseconds}" Value="False">
                    <Setter TargetName="Unit" Property="Text" Value="" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
          A reserve as a quiet row: the handle in Prioriterad, the dot, the name, the house, the mark, the address with
          the switch and × on hovering, and the latency to the right. No latency bar (the user's decision 2026-11-08).
        -->
        <DataTemplate x:Key="Sources.Reserve" DataType="{x:Type vm:EndpointRowViewModel}">
            <StackPanel>
            <Border x:Name="Card" Height="44" Padding="14,0" CornerRadius="10" BorderThickness="1.5" Margin="0,0,0,6"
                    Background="{StaticResource Brush.Floating}" BorderBrush="{StaticResource Brush.Submenu}" Opacity="0.72">
                <DockPanel>
                    <TextBlock x:Name="Ms" DockPanel.Dock="Right" Text="{Binding MillisecondsText}" FontSize="13" Width="58"
                               TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
                    <Button DockPanel.Dock="Right" Width="24" Height="24" Margin="6,0,0,0" ToolTip="Ta bort"
                            AutomationProperties.Name="Ta bort" CommandParameter="{Binding}"
                            Command="{Binding DataContext.Sources.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="IsHitTestVisible" Value="True" />
                                    </DataTrigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <controls:GridIcon Size="12" Data="{StaticResource Icon.Close}" Foreground="{StaticResource Brush.TextDim}" />
                    </Button>
                    <Button DockPanel.Dock="Right" Margin="10,0,0,0" ToolTip="{Binding SwitchTip}"
                            AutomationProperties.Name="{Binding SwitchTip}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.Sources.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Sources.Switch}">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="IsHitTestVisible" Value="True" />
                                    </DataTrigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Sources.Handle}" />
                        <Ellipse Style="{StaticResource Sources.Dot}" Margin="0,0,10,0" ToolTip="{Binding DotTip}" />
                        <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" />
                        <controls:GridIcon Size="13" Data="{StaticResource Icon.Home}" Foreground="{StaticResource Brush.TextMuted}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           ToolTip="{x:Static vm:EndpointRowViewModel.LocalTip}"
                                           Visibility="{Binding IsLocal, Converter={StaticResource Visible}}" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Sources.Pin}" Tag="Visible" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Sources.Note}" />
                        <TextBlock Text="{Binding Address}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="12,0,0,0"
                                   Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" MaxWidth="260"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding AnswerText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Sources.Key}" Margin="14,0,14,10" />
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="1" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                </Trigger>
                <Trigger SourceName="Card" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding DataContext.Sources.IsOff, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Dot}" Value="{x:Static vm:EndpointDot.Failed}">
                    <Setter TargetName="Ms" Property="Foreground" Value="{StaticResource Brush.Error}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One switched off: dashed and toned, a ring for its dot, the key when it sends one, × on hovering. -->
        <DataTemplate x:Key="Sources.Off" DataType="{x:Type vm:EndpointRowViewModel}">
            <StackPanel>
            <Grid x:Name="Card" Height="40" Margin="0,0,0,6" Opacity="0.6" Background="Transparent">
                <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1.5" StrokeDashArray="3 2"
                           Stroke="{StaticResource Brush.BorderStrong}" />
                <DockPanel Margin="14,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Sources.Switch}" ToolTip="{Binding SwitchTip}"
                            AutomationProperties.Name="{Binding SwitchTip}" CommandParameter="{Binding}" Margin="6,0,0,0"
                            Command="{Binding DataContext.Sources.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button DockPanel.Dock="Right" Width="24" Height="24" ToolTip="Ta bort" AutomationProperties.Name="Ta bort"
                            CommandParameter="{Binding}"
                            Command="{Binding DataContext.Sources.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="IsHitTestVisible" Value="True" />
                                    </DataTrigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <controls:GridIcon Size="12" Data="{StaticResource Icon.Close}" Foreground="{StaticResource Brush.TextDim}" />
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource Sources.Dot}" Margin="0,0,10,0" ToolTip="{Binding DotTip}" />
                        <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource Brush.TextMuted}"
                                   VerticalAlignment="Center" />
                        <controls:GridIcon Size="13" Data="{StaticResource Icon.Key}" Foreground="{StaticResource Brush.TextDim}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="API-nyckel ur valvet"
                                           Visibility="{Binding HasKey, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding Address}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="12,0,0,0"
                                   Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" MaxWidth="280"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Grid>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Sources.Key}" Margin="14,0,14,10" />
            </StackPanel>
        </DataTemplate>

        <!-- The quiet heading over a group: ANVÄNDS, RESERVER, ENDPOINTS, API-NYCKEL. -->
        <Style x:Key="Sources.Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
        </Style>

        <!-- A button with a dashed frame: Lägg till endpoint …. -->
        <Style x:Key="Sources.Dashed" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="Frame" RadiusX="10" RadiusY="10" StrokeThickness="1.5" StrokeDashArray="3 2"
                                       Stroke="{StaticResource Brush.BorderStrong}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Stroke" Value="{StaticResource Brush.TextDim}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="Sources.Wrap">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <!--
      The settings (sketch ST1a, as in Gawk): a dialog in the middle of the window over the darkened work. The pages in
      groups to the left, the title and a line about the page at the top, and the rows with a title and an explanation to
      the left and the choice to the right. Changes apply and are saved at once. A click on the dark part closes it, as
      Esc and × do.
    -->
    <Grid>
        <Rectangle Fill="#80000000" MouseLeftButtonDown="OnDimClicked" />
        <Grid MaxWidth="1040" MaxHeight="720" Margin="24">
            <!-- The shadow lies in a layer of its own, as under the command bar, so that it never blurs the text. -->
            <Border CornerRadius="14" Background="{StaticResource Brush.Floating}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="48" ShadowDepth="12" Direction="270" Opacity="0.6" Color="Black" />
                </Border.Effect>
            </Border>
            <Border CornerRadius="14" Background="{StaticResource Brush.Floating}" BorderBrush="{StaticResource Brush.BorderStrong}"
                    BorderThickness="1" ClipToBounds="True" AutomationProperties.Name="Inställningar">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ===== The menu: the pages in groups, Om last on its own ===== -->
                    <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.SubmenuHover}"
                            BorderThickness="0,0,1,0" CornerRadius="14,0,0,14" Padding="12,16">
                        <StackPanel>
                            <TextBlock Text="Inställningar" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Menu}" Focusable="False" AutomationProperties.Name="Sidor">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SettingsMenuGroup}">
                                        <StackPanel>
                                            <TextBlock x:Name="GroupName" Text="{Binding Name}" FontSize="13"
                                                       Foreground="{StaticResource Brush.TextDim}" Margin="10,12,0,4" />
                                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SettingsMenuItem}">
                                                        <Button Style="{StaticResource Settings.Menu}" Content="{Binding Entry.Name}"
                                                                CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.ShowItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasName}" Value="False">
                                                <Setter TargetName="GroupName" Property="Text" Value="" />
                                                <Setter TargetName="GroupName" Property="Margin" Value="0,14,0,0" />
                                                <Setter TargetName="GroupName" Property="FontSize" Value="1" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ===== The page: its title, its line, × and its rows ===== -->
                    <DockPanel Grid.Column="1">
                        <Border DockPanel.Dock="Top" Padding="28,22,20,18" BorderBrush="{StaticResource Brush.SubmenuHover}"
                                BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="32" Height="32"
                                        VerticalAlignment="Top" Command="{Binding CloseCommand}" ToolTip="Stäng (Esc)"
                                        AutomationProperties.Name="Stäng">
                                    <controls:GridIcon Size="14" Data="{StaticResource Icon.Close}"
                                                       Foreground="{StaticResource Brush.TextMuted}" />
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Lead}" FontSize="14" Foreground="{StaticResource Brush.TextDim}"
                                               Margin="0,4,0,0" Visibility="{Binding HasLead, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorText}" Style="{StaticResource Text.Error}" FontSize="13"
                                   Margin="28,0,28,14" TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource Visible}}" />

                        <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                                      Visibility="{Binding IsSourcesPage, Converter={x:Static controls:InvertVisibility.Instance}}">
                            <StackPanel Margin="28,8,28,28">

                                <!-- ===== Nätverk: the way out as two cards, the exits under VPN, and only https ===== -->
                                <StackPanel Visibility="{Binding IsNetworkPage, Converter={StaticResource Visible}}">
                                    <Border Style="{StaticResource Settings.Row}" Padding="0,16">
                                        <StackPanel>
                                            <TextBlock Text="Utgång" Style="{StaticResource Settings.RowTitle}" />
                                            <UniformGrid Columns="2" Margin="-6,12,-6,0">
                                                <Button x:Name="WindowsCard" Margin="6,0" Command="{Binding ChooseRouteCommand}"
                                                        CommandParameter="{x:Static network:ExitRoute.Windows}"
                                                        AutomationProperties.Name="Windows som utgång">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Settings.Card}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWindows}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                                                    <Setter Property="Background" Value="#392D2D" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <DockPanel>
                                                        <controls:GridIcon DockPanel.Dock="Left" Size="22" Data="{StaticResource Icon.Monitor}"
                                                                           VerticalAlignment="Top" Margin="0,0,12,0"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        <StackPanel>
                                                            <TextBlock Text="Windows" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                                                            <TextBlock Text="Datorns eget nät, med det skydd som är installerat för hela datorn."
                                                                       FontSize="13.5" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"
                                                                       TextWrapping="Wrap" LineHeight="18" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                                <Button x:Name="VpnCard" Margin="6,0" Command="{Binding ChooseRouteCommand}"
                                                        CommandParameter="{x:Static network:ExitRoute.Vpn}"
                                                        AutomationProperties.Name="VPN som utgång">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Settings.Card}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVpn}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                                                    <Setter Property="Background" Value="#392D2D" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <DockPanel>
                                                        <controls:GridIcon DockPanel.Dock="Left" Size="22" Data="{StaticResource Icon.Shield}"
                                                                           VerticalAlignment="Top" Margin="0,0,12,0"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        <StackPanel>
                                                            <TextBlock Text="VPN" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                                                            <TextBlock Text="Bara genom en ansluten utgång i Chainsaw. Utan den görs inga uppslag."
                                                                       FontSize="13.5" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"
                                                                       TextWrapping="Wrap" LineHeight="18" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </UniformGrid>

                                            <!-- Under VPN: the exits, through the same view model as the exits' panel (UT1a). -->
                                            <Border Margin="0,16,0,0" DataContext="{Binding Exits}"
                                                    Visibility="{Binding DataContext.IsVpn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}">
                                                <StackPanel>
                                                    <!-- The exits as a table (sketch UT3b): Utgång, Plats and Syns som; a row folds out. -->
                                                    <StackPanel Visibility="{Binding IsListing, Converter={StaticResource Visible}}">
                                                        <Grid Margin="16,4,12,8" TextElement.FontSize="12" TextElement.Foreground="{StaticResource Brush.TextDim}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="21" />
                                                                <ColumnDefinition Width="1.1*" />
                                                                <ColumnDefinition Width="1*" />
                                                                <ColumnDefinition Width="1.4*" />
                                                                <ColumnDefinition Width="76" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="1" Text="Utgång" />
                                                            <TextBlock Grid.Column="2" Text="Plats" />
                                                            <TextBlock Grid.Column="3" Text="Syns som" />
                                                        </Grid>
                                                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}"
                                                                Background="{StaticResource Brush.Background}" ClipToBounds="True">
                                                            <StackPanel>
                                                                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource Settings.ExitRow}"
                                                                              Focusable="False" AutomationProperties.Name="Utgångar" />
                                                                <TextBlock Text="Inga utgångar i valvet" FontSize="13" Foreground="{StaticResource Brush.TextDim}"
                                                                           Margin="16,12,16,4" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                                                                <Button x:Name="AddButton" Style="{StaticResource Button.MenuItem}" Height="42" Padding="16,0"
                                                                        Command="{Binding AddFileCommand}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <controls:GridIcon Size="15" Data="{StaticResource Icon.Plus}"
                                                                                           Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,10,0" />
                                                                        <TextBlock Text="Lägg till WireGuard-fil …" FontSize="13.5" VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource Brush.TextMuted}" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- The step that adds a file, as in the exits' panel. -->
                                                    <StackPanel Margin="10" Visibility="{Binding IsAdding, Converter={StaticResource Visible}}">
                                                        <Border Height="34" CornerRadius="6" Background="{StaticResource Brush.Background}"
                                                                BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" Padding="10,0">
                                                            <DockPanel VerticalAlignment="Center">
                                                                <controls:GridIcon DockPanel.Dock="Left" Size="16" Data="{StaticResource Icon.File}"
                                                                                   Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,8,0" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CheckText}" FontSize="12.5"
                                                                           Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFileValid}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding FileName}" FontSize="13.5" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                        </Border>
                                                        <DockPanel Margin="0,10,0,0">
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Height="34" Padding="14,0"
                                                                    FontSize="13.5" Margin="8,0,0,0" Content="Spara" Command="{Binding SaveCommand}"
                                                                    ToolTip="Spara (Enter)" IsEnabled="{Binding CanSave}" />
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Height="34"
                                                                    Padding="14,0" FontSize="13.5" Margin="8,0,0,0" Content="Avbryt"
                                                                    Command="{Binding CancelAddCommand}" ToolTip="Avbryt (Esc)" />
                                                            <TextBox x:Name="ExitNameBox" Style="{StaticResource TextBox.Field}" Height="34" FontSize="14"
                                                                     Background="{StaticResource Brush.Background}" AutomationProperties.Name="Namn"
                                                                     MaxLength="{x:Static network:ExitRules.MaximumNameLength}"
                                                                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}">
                                                                <TextBox.InputBindings>
                                                                    <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                                                                </TextBox.InputBindings>
                                                            </TextBox>
                                                        </DockPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <controls:GridIcon Size="12" Data="{StaticResource Icon.Lock}"
                                                                               Foreground="{StaticResource Brush.TextDim}" Margin="0,0,6,0" />
                                                            <TextBlock Text="Krypteras i valvet" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Error}" FontSize="13"
                                                               Margin="12,4,12,8" TextWrapping="Wrap"
                                                               Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!--
                                      Under Windows: the proxy Windows is set up with, as it is (sketch PX1a). Only a proxy
                                      set by hand gets the row that logs in with the Windows account; turned on, it folds
                                      out what is sent, to whom and what never. One found automatically gets no switch,
                                      only why. The background follows the choice.
                                    -->
                                    <StackPanel DataContext="{Binding Proxy}"
                                                Visibility="{Binding DataContext.IsWindows, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}">
                                        <Border Style="{StaticResource Settings.Row}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                    <Border Height="32" CornerRadius="8" Padding="11,0,6,0"
                                                            Background="{StaticResource Brush.Background}" BorderThickness="1.5"
                                                            BorderBrush="{StaticResource Brush.BorderStrong}" HorizontalAlignment="Right">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <controls:GridIcon Size="15" Data="{StaticResource Icon.Proxy}"
                                                                               Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,9,0" />
                                                            <TextBlock Text="{Binding AddressText}" FontFamily="Cascadia Mono, Consolas"
                                                                       FontSize="12.5" VerticalAlignment="Center" />
                                                            <Border CornerRadius="5" Padding="7,0" Height="20" Margin="9,0,0,0"
                                                                    Visibility="{Binding HasHow, Converter={StaticResource Visible}}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAutomatic}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource Brush.PendingTint}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding HowText}" FontSize="11.5" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsAutomatic}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Pending}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"
                                                                Visibility="{Binding HasProxy, Converter={StaticResource Visible}}">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Fill="{Binding Foreground, ElementName=NetLine}" />
                                                        <TextBlock x:Name="NetLine" Text="{Binding NetText}" FontSize="12" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding NetIsGood}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="Proxy" Style="{StaticResource Settings.RowTitle}" />
                                                    <TextBlock Text="Det som är inställt i Windows. Chainsaw läser det och ändrar inget."
                                                               Style="{StaticResource Settings.RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- The login with the Windows account: only for a proxy set by hand. -->
                                        <Border Style="{StaticResource Settings.Row}"
                                                Visibility="{Binding CanLogin, Converter={StaticResource Visible}}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Settings.TagSwitch}"
                                                            Command="{Binding ToggleCommand}" Tag="{Binding IsOn}"
                                                            ToolTip="{Binding SwitchTip}" AutomationProperties.Name="Logga in med Windows-kontot" />
                                                    <StackPanel Margin="0,0,16,0">
                                                        <TextBlock Text="Logga in med Windows-kontot" Style="{StaticResource Settings.RowTitle}" />
                                                        <TextBlock Text="När proxyn kräver inloggning. Bara till proxyn ovan, och bara när den ber om det."
                                                                   Style="{StaticResource Settings.RowHint}" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- The proxy refused: in plain words, red. -->
                                                <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="10" BorderThickness="1"
                                                        BorderBrush="{StaticResource Brush.ErrorEdge}" Background="{StaticResource Brush.ErrorTint}"
                                                        Visibility="{Binding IsRefused, Converter={StaticResource Visible}}">
                                                    <DockPanel>
                                                        <controls:GridIcon DockPanel.Dock="Left" Size="18" Data="{StaticResource Icon.Lock}"
                                                                           Foreground="{StaticResource Brush.Error}" Margin="0,0,12,0"
                                                                           VerticalAlignment="Center" />
                                                        <TextBlock DockPanel.Dock="Right" Text="Kerberos eller NTLM" FontSize="12"
                                                                   Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"
                                                                   Margin="12,0,0,0" />
                                                        <TextBlock Text="{Binding RefusedText}" FontSize="13" TextWrapping="Wrap"
                                                                   VerticalAlignment="Center" LineHeight="19" />
                                                    </DockPanel>
                                                </Border>

                                                <!-- Turned on: what is sent, to whom and what never, folded out in three rows. -->
                                                <Border Margin="0,12,0,0" CornerRadius="10" BorderThickness="1"
                                                        BorderBrush="{StaticResource Brush.SubmenuHover}"
                                                        Background="{StaticResource Brush.Background}"
                                                        Visibility="{Binding IsOn, Converter={StaticResource Visible}}">
                                                    <ItemsControl ItemsSource="{Binding Tells}" Focusable="False"
                                                                  AutomationProperties.Name="Vad som skickas">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:ProxyTell}">
                                                                <Border Padding="16,13" BorderThickness="0,0,0,1"
                                                                        BorderBrush="{StaticResource Brush.Surface}">
                                                                    <DockPanel>
                                                                        <Border x:Name="Tile" DockPanel.Dock="Left" Width="30" Height="30"
                                                                                CornerRadius="8" Background="{StaticResource Brush.SurfaceRaised}"
                                                                                VerticalAlignment="Top">
                                                                            <controls:GridIcon x:Name="TellIcon" Size="15"
                                                                                               Data="{StaticResource Icon.Key}"
                                                                                               Foreground="{StaticResource Brush.Text}"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <TextBlock DockPanel.Dock="Left" Width="74" Margin="14,6,0,0"
                                                                                   Text="{Binding Label}" FontSize="12"
                                                                                   Foreground="{StaticResource Brush.TextDim}" />
                                                                        <TextBlock Margin="0,5,0,0" FontSize="13" TextWrapping="Wrap" LineHeight="20">
                                                                            <Run Text="{Binding Text, Mode=OneWay}" /><Run
                                                                                Text="{Binding SubText, Mode=OneWay}"
                                                                                Foreground="{StaticResource Brush.TextMuted}" />
                                                                        </TextBlock>
                                                                    </DockPanel>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ProxyTellKind.To}">
                                                                        <Setter TargetName="TellIcon" Property="Data" Value="{StaticResource Icon.Proxy}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ProxyTellKind.Never}">
                                                                        <Setter TargetName="TellIcon" Property="Data" Value="{StaticResource Icon.ShieldX}" />
                                                                        <Setter TargetName="TellIcon" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                                        <Setter TargetName="Tile" Property="Background" Value="Transparent" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- A proxy Windows finds by itself: no switch, only why, and the way to set it by hand. -->
                                        <Border Style="{StaticResource Settings.Row}"
                                                Visibility="{Binding IsAutomatic, Converter={StaticResource Visible}}">
                                            <Grid>
                                                <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1.5" StrokeDashArray="4 3"
                                                           Stroke="{StaticResource Brush.PendingEdge}" />
                                                <DockPanel Margin="16,14">
                                                    <controls:GridIcon DockPanel.Dock="Left" Size="20" Data="{StaticResource Icon.KeyOff}"
                                                                       Foreground="{StaticResource Brush.Pending}" Margin="0,1,14,0"
                                                                       VerticalAlignment="Top" />
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Settings.Button}" Height="30"
                                                            Padding="12,0" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Top"
                                                            Command="{Binding OpenWindowsSettingsCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:GridIcon Size="13" Data="{StaticResource Icon.Open}" Margin="0,0,7,0"
                                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                            <TextBlock Text="Proxy i Windows" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <StackPanel>
                                                        <TextBlock Text="Ingen inloggning till en proxy som hittas automatiskt"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}" Margin="0,5,0,0"
                                                                   TextWrapping="Wrap" LineHeight="19"
                                                                   Text="Windows letar själv efter proxyn på nätet (WPAD eller ett skript). Vem som helst på samma nät kan svara på den frågan, och då skulle ditt Windows-konto skickas till dem. Ställ in proxyn för hand i Windows, så kommer raden fram här." />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Grid>
                                        </Border>

                                        <!-- The background follows the same choice through the same proxy. -->
                                        <Border Style="{StaticResource Settings.Row}"
                                                Visibility="{Binding HasProxy, Converter={StaticResource Visible}}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <controls:GridIcon Size="15" Data="{StaticResource Icon.Eye}" Margin="0,0,7,0"
                                                                       Foreground="{Binding Foreground, ElementName=WatchLine}" />
                                                    <TextBlock x:Name="WatchLine" Text="{Binding WatchText}" FontSize="12.5"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding WatchWaits}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Pending}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="Bevakningen när Chainsaw är stängt" Style="{StaticResource Settings.RowTitle}" />
                                                    <TextBlock Text="Går genom samma proxy och följer valet ovan. Den kör som ditt Windows-konto och får inget eget lösenord."
                                                               Style="{StaticResource Settings.RowHint}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                    <Border Style="{StaticResource Settings.Row}"
                                            Visibility="{Binding IsVpn, Converter={StaticResource Visible}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Settings.TagSwitch}"
                                                    Command="{Binding ToggleCheckExitOnConnectCommand}" Tag="{Binding ChecksExitOnConnect}"
                                                    AutomationProperties.Name="Kontrollera vid anslutning"
                                                    IsEnabled="{Binding Exits.CanCheck}" />
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Kontrollera vid anslutning" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="Frågar en gång när utgången ansluts. Stämmer inte landet säger toastern till."
                                                           Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <!-- VPN in the background (decided 2026-11-08): a plain switch for the selected exit. -->
                                    <Border Style="{StaticResource Settings.Row}"
                                            Visibility="{Binding ShowsExitInBackground, Converter={StaticResource Visible}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Settings.TagSwitch}"
                                                    Command="{Binding ToggleExitInBackgroundCommand}" Tag="{Binding ExitInBackground}"
                                                    AutomationProperties.Name="Bevaka genom utgången när Chainsaw är stängt"
                                                    IsEnabled="{Binding CanExitInBackground}" />
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Bevaka genom utgången när Chainsaw är stängt" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="Den valda utgångens WireGuard-fil sparas skyddad för din Windows-användare, utanför valvet. Tas bort när du slår av den här eller bakgrunden."
                                                           Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Settings.Row}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="Alltid" Style="{StaticResource Settings.Value}" />
                                            <StackPanel>
                                                <TextBlock Text="Bara https" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="Kakor och referer skickas aldrig. Gäller båda utgångarna."
                                                           Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ===== Låsning: the time, the lock with Windows, and the watching when Chainsaw is closed and how it
                                     tells (one row per way; the message in the middle of the screen waits for its sketch) ===== -->
                                <StackPanel Visibility="{Binding IsLockPage, Converter={StaticResource Visible}}">
                                    <Border Style="{StaticResource Settings.Row}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Settings.SegmentFrame}">
                                                <ItemsControl ItemsSource="{Binding LockChoices}" Tag="{Binding ChooseLockCommand}"
                                                              ItemTemplate="{StaticResource Settings.Option}"
                                                              ItemsPanel="{StaticResource Settings.Options}" Focusable="False"
                                                              AutomationProperties.Name="Lås efter" />
                                            </Border>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Lås efter" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="Utan inmatning. Ctrl+L låser direkt." Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Settings.Row}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Settings.Switch}"
                                                    Command="{Binding ToggleLockWithWindowsCommand}"
                                                    AutomationProperties.Name="Lås när Windows låses" />
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="När Windows låses" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="Chainsaw låses samtidigt. En ansluten utgång står kvar. Viloläge låser alltid."
                                                           Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Settings.Row}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Settings.TagSwitch}"
                                                    Command="{Binding ToggleWatchInBackgroundCommand}" Tag="{Binding WatchesInBackground}"
                                                    AutomationProperties.Name="Bevaka när Chainsaw är stängt" />
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Bevaka när Chainsaw är stängt" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="En liten process startar med Windows när en bevakning är aktiv. Den vet bara adresserna och ärendets id, och går bara genom Windows som utgång."
                                                           Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <!-- Others can change the program folder (decision 16): no Run key, said here. -->
                                    <DockPanel Margin="0,12,0,0"
                                               Visibility="{Binding HasProgramFolderWarning, Converter={StaticResource Visible}}">
                                        <controls:GridIcon DockPanel.Dock="Left" Size="16" Data="{StaticResource Icon.Alert}"
                                                           Foreground="{StaticResource Brush.Pending}" Margin="0,1,10,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding ProgramFolderWarning}" FontSize="13.5"
                                                   Foreground="{StaticResource Brush.Pending}" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <!-- When a watch hits (sketch BV4a): three ways, each a row with its icon on a tile that is
                                         tinted in the accent while the way is on. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,22,0,6">
                                        <TextBlock Text="NÄR EN BEVAKNING SLÅR TILL" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                        <Border Background="Transparent" Margin="10,0,0,0" VerticalAlignment="Center"
                                                ToolTip="Alla sätt säger bara att en bevakning har slagit till. Adress, belopp och ärende visas först efter upplåsning. Gäller också när Chainsaw är stängt.">
                                            <controls:GridIcon Size="14" Data="{StaticResource Icon.Info}"
                                                               Foreground="{StaticResource Brush.TextDim}" />
                                        </Border>
                                    </StackPanel>
                                    <Border Style="{StaticResource Settings.Row}" Padding="0,12">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource Settings.WayTile}"
                                                    Tag="{Binding AlertsInWindows}">
                                                <controls:GridIcon Size="18" Data="{StaticResource Icon.Bell}"
                                                                   Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
                                            </Border>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Settings.TagSwitch}"
                                                    Command="{Binding ToggleAlertInWindowsCommand}" Tag="{Binding AlertsInWindows}"
                                                    AutomationProperties.Name="Avisering i Windows" />
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="Avisering i Windows" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="I Windows meddelandecenter, utan detaljer." Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Settings.Row}" Padding="0,12">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource Settings.WayTile}"
                                                    Tag="{Binding AlertsWithSound}">
                                                <controls:GridIcon Size="18" Data="{StaticResource Icon.Sound}"
                                                                   Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
                                            </Border>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Settings.TagSwitch}"
                                                    Command="{Binding ToggleAlertWithSoundCommand}" Tag="{Binding AlertsWithSound}"
                                                    AutomationProperties.Name="Ljud" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Settings.RoundButton}" Margin="0,0,14,0"
                                                    Command="{Binding PlaySoundCommand}" ToolTip="Lyssna" AutomationProperties.Name="Lyssna"
                                                    Visibility="{Binding CanPreviewAlerts, Converter={StaticResource Visible}}">
                                                <controls:GridIcon Size="12" Data="{StaticResource Icon.Play}"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="Ljud" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="Ett mynt-swoosh med skrammel." Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Settings.Row}" Padding="0,12">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource Settings.WayTile}"
                                                    Tag="{Binding AlertsOnScreen}">
                                                <controls:GridIcon Size="18" Data="{StaticResource Icon.Screen}"
                                                                   Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
                                            </Border>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Settings.TagSwitch}"
                                                    Command="{Binding ToggleAlertOnScreenCommand}" Tag="{Binding AlertsOnScreen}"
                                                    AutomationProperties.Name="Meddelande mitt på skärmen" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Settings.Button}" Height="30" Padding="12,0"
                                                    FontSize="13" Margin="0,0,14,0" Content="Prova" Command="{Binding TryScreenMessageCommand}"
                                                    ToolTip="Visa meddelandet som en träff skulle" AutomationProperties.Name="Prova meddelandet"
                                                    Visibility="{Binding CanPreviewAlerts, Converter={StaticResource Visible}}" />
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="Meddelande mitt på skärmen" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="Ligger överst, över alla fönster, tills det stängs." Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                                Visibility="{Binding StartsWithWindows, Converter={StaticResource Visible}}">
                                        <controls:GridIcon Size="14" Data="{StaticResource Icon.Pin}" Foreground="{StaticResource Brush.TextDim}"
                                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Gäller också när Chainsaw är stängt. Bakgrunden startar med Windows." FontSize="13"
                                                   Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                                Visibility="{Binding HasNoAlertWay, Converter={StaticResource Visible}}">
                                        <controls:GridIcon Size="16" Data="{StaticResource Icon.Alert}" Foreground="{StaticResource Brush.Pending}"
                                                           Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Inget sätt valt. En träff syns bara i Bevakning när Chainsaw är öppet." FontSize="13.5"
                                                   Foreground="{StaticResource Brush.Pending}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- ===== Utseende: not built yet ===== -->
                                <StackPanel Visibility="{Binding IsLookPage, Converter={StaticResource Visible}}">
                                    <Border Style="{StaticResource Settings.RowNotBuilt}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Settings.SegmentFrame}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border CornerRadius="5" Padding="12,0" Height="28" Background="{StaticResource Brush.SurfaceSelected}">
                                                        <TextBlock Text="Rör sig" FontSize="13.5" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Padding="12,0" Height="28">
                                                        <TextBlock Text="Står still" FontSize="13.5" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Brush.TextDim}" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Kättingen" Style="{StaticResource Settings.RowTitle}" />
                                                    <Border Style="{StaticResource Settings.Tag}">
                                                        <TextBlock Text="{x:Static vm:SettingsViewModel.NotBuiltText}" FontSize="12"
                                                                   Foreground="{StaticResource Brush.TextDim}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Kättingen som blir DNA bakom låsskärmen." Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ===== Länkar: the link chainsaw: registered for the user ===== -->
                                <StackPanel Visibility="{Binding IsLinksPage, Converter={StaticResource Visible}}">
                                    <Border Style="{StaticResource Settings.Row}" IsEnabled="{Binding CanRegisterLinks}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Settings.TagSwitch}"
                                                    Command="{Binding ToggleLinksCommand}" Tag="{Binding IsLinkRegistered}"
                                                    AutomationProperties.Name="Öppna chainsaw:-länkar"
                                                    ToolTip="Registrera eller ta bort länken chainsaw: för dig i Windows" />
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Öppna chainsaw:-länkar" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="{Binding LinkHint}" Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <!-- Others can change the program folder (decision 16): no link, said here. -->
                                    <DockPanel Margin="0,12,0,0"
                                               Visibility="{Binding HasProgramFolderWarning, Converter={StaticResource Visible}}">
                                        <controls:GridIcon DockPanel.Dock="Left" Size="16" Data="{StaticResource Icon.Alert}"
                                                           Foreground="{StaticResource Brush.Pending}" Margin="0,1,10,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding ProgramFolderWarning}" FontSize="13.5"
                                                   Foreground="{StaticResource Brush.Pending}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </StackPanel>

                                <!-- ===== Kurser: the currency, the resolution and the sources ===== -->
                                <StackPanel Visibility="{Binding IsPricingPage, Converter={StaticResource Visible}}">
                                    <Border Style="{StaticResource Settings.Row}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Settings.SegmentFrame}">
                                                <ItemsControl ItemsSource="{Binding CurrencyChoices}" Tag="{Binding ChooseCurrencyCommand}"
                                                              ItemTemplate="{StaticResource Settings.Option}"
                                                              ItemsPanel="{StaticResource Settings.Options}" Focusable="False"
                                                              AutomationProperties.Name="Valuta" />
                                            </Border>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Valuta" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="Beloppen visas i den här valutan, under beloppet på kedjan." Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Settings.Row}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Settings.SegmentFrame}">
                                                <ItemsControl ItemsSource="{Binding ResolutionChoices}" Tag="{Binding ChooseResolutionCommand}"
                                                              ItemTemplate="{StaticResource Settings.Option}"
                                                              ItemsPanel="{StaticResource Settings.Options}" Focusable="False"
                                                              AutomationProperties.Name="Upplösning" />
                                            </Border>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Upplösning" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="Kursen för den tidsperiod som blocket bröts i." Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Settings.Row}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="Bitstamp" Style="{StaticResource Settings.Value}" />
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Källa för kryptokurser" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="Bitstamp, för BTC, ETH, USDT och USDC. Bara genom utgången."
                                                           Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Settings.Row}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="Riksbanken" Style="{StaticResource Settings.Value}" />
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Källa för växelkursen" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="Bitstamp har ingen krona; euron räknas om med Riksbankens dagskurs."
                                                           Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Settings.Row}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Rates.StoredText}"
                                                       ToolTip="{Binding Rates.StoredTip}" Style="{StaticResource Settings.Value}" />
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Sparas i ärendet" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="Varje kurs med källa, tid och SHA-256 av svaret. En kurs som är satt hämtas aldrig igen."
                                                           Style="{StaticResource Settings.RowHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ===== Profil: who fetched, and the master key ===== -->
                                <StackPanel Visibility="{Binding IsProfilePage, Converter={StaticResource Visible}}">
                                    <Border Style="{StaticResource Settings.Row}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="Namn" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,3" />
                                                    <TextBox x:Name="NameBox" Style="{StaticResource TextBox.Field}" Width="130" Height="32" FontSize="14"
                                                             Background="{StaticResource Brush.Background}" AutomationProperties.Name="Namn"
                                                             Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                                             LostKeyboardFocus="OnProfileLeft" KeyDown="OnProfileKey" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="Titel" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,3" />
                                                    <TextBox Style="{StaticResource TextBox.Field}" Width="130" Height="32" FontSize="14"
                                                             Background="{StaticResource Brush.Background}" AutomationProperties.Name="Titel"
                                                             Text="{Binding ProfileTitle, UpdateSourceTrigger=PropertyChanged}"
                                                             LostKeyboardFocus="OnProfileLeft" KeyDown="OnProfileKey" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Enhet" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,3" />
                                                    <TextBox Style="{StaticResource TextBox.Field}" Width="130" Height="32" FontSize="14"
                                                             Background="{StaticResource Brush.Background}" AutomationProperties.Name="Enhet"
                                                             Text="{Binding ProfileUnit, UpdateSourceTrigger=PropertyChanged}"
                                                             LostKeyboardFocus="OnProfileLeft" KeyDown="OnProfileKey" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Du" Style="{StaticResource Settings.RowTitle}" />
                                                <TextBlock Text="Står som den som hämtade och förseglade." Style="{StaticResource Settings.RowHint}" />
                                                <TextBlock Text="{Binding ProfileError}" Style="{StaticResource Text.Error}" FontSize="13"
                                                           Margin="0,6,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding HasProfileError, Converter={StaticResource Visible}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Settings.Row}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Settings.Button}" Content="Byt …"
                                                        Command="{Binding ToggleChangeKeyCommand}" AutomationProperties.Name="Byt huvudnyckel" />
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="Huvudnyckel" Style="{StaticResource Settings.RowTitle}" />
                                                    <TextBlock Text="Lindar om valvets nyckel. Ärendena påverkas inte."
                                                               Style="{StaticResource Settings.RowHint}" />
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- The master key's form, folded out under its row: the keys never become strings. -->
                                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsChangingKey, Converter={StaticResource Visible}}">
                                                <UniformGrid Columns="3">
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="Nuvarande" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,3" />
                                                        <PasswordBox x:Name="CurrentKeyBox" Style="{StaticResource PasswordBox.Field}" Height="32" FontSize="14" AutomationProperties.Name="Nuvarande huvudnyckel" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="Ny" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,3" />
                                                        <PasswordBox x:Name="NewKeyBox" Style="{StaticResource PasswordBox.Field}" Height="32" FontSize="14" AutomationProperties.Name="Ny huvudnyckel" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="Upprepa" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,3" />
                                                        <PasswordBox x:Name="RepeatKeyBox" Style="{StaticResource PasswordBox.Field}" Height="32" FontSize="14" AutomationProperties.Name="Upprepa ny huvudnyckel"
                                                                     KeyDown="OnKeyFormKey" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                                    <Button Style="{StaticResource Button.Secondary}" Height="32" Padding="14,0" FontSize="13.5"
                                                            Content="Avbryt" Command="{Binding ToggleChangeKeyCommand}" />
                                                    <Button Style="{StaticResource Button.Primary}" Height="32" Padding="14,0" FontSize="13.5"
                                                            Margin="8,0,0,0" Content="Byt huvudnyckel" Click="OnChangeKey"
                                                            IsEnabled="{Binding IsKeyBusy, Converter={x:Static controls:InvertConverter.Instance}}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding KeyText}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasKeyText, Converter={StaticResource Visible}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKeyError}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ===== Om Chainsaw (sketch ST2a): the version, the recovery key and the licences ===== -->
                                <StackPanel Visibility="{Binding IsAboutPage, Converter={StaticResource Visible}}">
                                    <views:AboutPage DataContext="{Binding About}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!--
                          ===== Källor (sketch KL2b): the chains and, under Etiketter, the suppliers in a middle column;
                          the shown one to the right. It fills the page under the title instead of scrolling with it. =====
                        -->
                        <Grid x:Name="SourcesPage" DataContext="{Binding Sources}" PreviewMouseMove="OnDragMove"
                              PreviewMouseLeftButtonUp="OnDragEnd" LostMouseCapture="OnDragEnd"
                              Visibility="{Binding DataContext.IsSourcesPage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="196" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <StackPanel Margin="10,14">
                                        <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource Sources.Chain}"
                                                      Focusable="False" AutomationProperties.Name="Kedjor" />
                                        <TextBlock Text="Etiketter" Style="{StaticResource Sources.Heading}" Margin="12,16,0,6"
                                                   Visibility="{Binding HasSuppliers, Converter={StaticResource Visible}}" />
                                        <ItemsControl ItemsSource="{Binding Suppliers}" ItemTemplate="{StaticResource Sources.Supplier}"
                                                      Focusable="False" AutomationProperties.Name="Etiketter" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ===== A chain ===== -->
                            <Grid Grid.Column="1" Margin="26,18,28,20"
                                  Visibility="{Binding IsChainShown, Converter={StaticResource Visible}}">
                                <!-- A chain that is not built yet says so, in the middle. -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,90,0,0"
                                            Visibility="{Binding IsNotBuilt, Converter={StaticResource Visible}}">
                                    <controls:GridIcon Size="28" Data="{StaticResource Icon.Clock}" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource Brush.TextDim}" />
                                    <TextBlock Text="{x:Static vm:SettingsViewModel.NotBuiltText}" FontSize="14" Margin="0,10,0,0"
                                               Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding NotBuiltText}" FontSize="13" Margin="0,10,0,0"
                                               Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Center" />
                                </StackPanel>

                                <DockPanel Visibility="{Binding IsBuilt, Converter={StaticResource Visible}}">
                                    <!-- The chain's name, and the mode as three icons with its name beside. -->
                                    <DockPanel DockPanel.Dock="Top" Height="36">
                                        <Border DockPanel.Dock="Right" Padding="2" CornerRadius="10" BorderThickness="1"
                                                BorderBrush="{StaticResource Brush.BorderStrong}" Background="{StaticResource Brush.Background}"
                                                VerticalAlignment="Center">
                                            <ItemsControl ItemsSource="{Binding ModeChoices}" ItemTemplate="{StaticResource Sources.Mode}"
                                                          ItemsPanel="{StaticResource Settings.Options}" Focusable="False"
                                                          AutomationProperties.Name="Läge" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ModeName}" FontSize="13" Margin="0,0,12,0"
                                                   Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ChainName}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <!-- The foot: Lägg till endpoint … dashed, when they were tried, and Prova alla nu. -->
                                    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="Auto" Height="32"
                                                Padding="12,0" Command="{Binding ProbeAllCommand}" IsEnabled="{Binding CanProbe}"
                                                ToolTip="Provar alla påslagna genom utgången, med kedjans höjd"
                                                AutomationProperties.Name="Prova alla nu">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:GridIcon Size="14" Data="{StaticResource Icon.Refresh}" Margin="0,0,7,0"
                                                                   Foreground="{StaticResource Brush.TextMuted}" />
                                                <TextBlock Text="Prova alla nu" FontSize="13" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProbeText}" FontSize="13" Margin="0,0,12,0"
                                                   Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" />
                                        <Button x:Name="AddEndpointButton" Style="{StaticResource Sources.Dashed}" HorizontalAlignment="Left"
                                                Command="{Binding ToggleAddCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:GridIcon Size="14" Data="{StaticResource Icon.Plus}" Margin="0,0,8,0"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Lägg till endpoint …" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>

                                    <!-- The form: the address (only https), the sort, a key from the vault, Lokal, Prova. -->
                                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="14,12" CornerRadius="12"
                                            BorderThickness="1.5" BorderBrush="{StaticResource Brush.BorderStrong}"
                                            Background="{StaticResource Brush.Surface}"
                                            Visibility="{Binding IsAdding, Converter={StaticResource Visible}}">
                                        <StackPanel>
                                            <TextBlock Text="Adress · bara https" FontSize="13" Foreground="{StaticResource Brush.TextDim}" />
                                            <TextBox x:Name="EndpointAddressBox" Style="{StaticResource TextBox.Field}" Height="34"
                                                     FontFamily="Cascadia Mono, Consolas" FontSize="13.5" Margin="0,4,0,0"
                                                     Background="{StaticResource Brush.Background}" AutomationProperties.Name="Adress"
                                                     MaxLength="{x:Static chains:SourceAddress.MaximumLength}"
                                                     Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <TextBlock Text="{Binding AddressProblem}" Style="{StaticResource Text.Error}" FontSize="13"
                                                       Margin="0,4,0,0" Visibility="{Binding HasAddressProblem, Converter={StaticResource Visible}}" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <TextBlock Text="Sort" FontSize="13" Foreground="{StaticResource Brush.TextDim}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Border Style="{StaticResource Settings.SegmentFrame}" Margin="0,0,16,0">
                                                    <ItemsControl ItemsSource="{Binding ApiChoices}" Tag="{Binding ChooseApiCommand}"
                                                                  ItemTemplate="{StaticResource Settings.Option}"
                                                                  ItemsPanel="{StaticResource Settings.Options}" Focusable="False"
                                                                  AutomationProperties.Name="Sort" />
                                                </Border>
                                                <controls:GridIcon Size="14" Data="{StaticResource Icon.Key}" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Brush.TextDim}" Margin="0,0,6,0" />
                                                <TextBlock Text="API-nyckel ur valvet" FontSize="13" Foreground="{StaticResource Brush.TextDim}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Border Style="{StaticResource Settings.SegmentFrame}" Margin="0,0,16,0">
                                                    <ItemsControl ItemsSource="{Binding KeyChoices}" Tag="{Binding ChooseKeyCommand}"
                                                                  ItemTemplate="{StaticResource Settings.Option}"
                                                                  ItemsPanel="{StaticResource Sources.Wrap}" Focusable="False"
                                                                  AutomationProperties.Name="API-nyckel" />
                                                </Border>
                                                <Button Style="{StaticResource Sources.LocalSwitch}" Command="{Binding ToggleLocalCommand}"
                                                        ToolTip="{x:Static vm:SourcesViewModel.LocalTip}" AutomationProperties.Name="Lokal"
                                                        Margin="0,0,8,0" />
                                                <TextBlock Text="Lokal" FontSize="13" Foreground="{StaticResource Brush.TextDim}"
                                                           VerticalAlignment="Center" ToolTip="{x:Static vm:SourcesViewModel.LocalTip}" />
                                            </WrapPanel>
                                            <DockPanel Margin="0,12,0,0">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Height="32" Padding="14,0"
                                                        FontSize="13.5" Margin="8,0,0,0" Content="Lägg till" Command="{Binding AddCommand}"
                                                        IsEnabled="{Binding CanAdd}" ToolTip="Lägg till (Enter)" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Height="32"
                                                        Padding="14,0" FontSize="13.5" Margin="8,0,0,0" Content="Avbryt"
                                                        Command="{Binding CancelAddCommand}" ToolTip="Avbryt (Esc)" />
                                                <Button DockPanel.Dock="Left" Style="{StaticResource Button.Secondary}" Height="32"
                                                        Padding="14,0" FontSize="13.5" Content="Prova" Command="{Binding TryCommand}"
                                                        IsEnabled="{Binding CanTry}"
                                                        ToolTip="Frågar efter kedjans höjd och blockets hash genom utgången, eller direkt när den är lokal" />
                                                <TextBlock Text="{Binding TryText}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" Visibility="{Binding HasTryText, Converter={StaticResource Visible}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TryAnswered}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <StackPanel>
                                            <!-- Av: no lookups, said in a dashed frame. -->
                                            <Grid Margin="0,16,0,0" Visibility="{Binding IsOff, Converter={StaticResource Visible}}">
                                                <Rectangle RadiusX="12" RadiusY="12" StrokeThickness="1.5" StrokeDashArray="3 2"
                                                           Stroke="{StaticResource Brush.BorderStrong}" />
                                                <StackPanel Orientation="Horizontal" Margin="16,14">
                                                    <controls:GridIcon Size="18" Data="{StaticResource Icon.Power}" Margin="0,0,12,0"
                                                                       Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding OffText}" FontSize="13" TextWrapping="Wrap"
                                                               Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- The endpoint in use. -->
                                            <StackPanel Visibility="{Binding HasInUse, Converter={StaticResource Visible}}">
                                                <TextBlock Text="ANVÄNDS" Style="{StaticResource Sources.Heading}" Margin="0,16,0,0" />
                                                <ContentPresenter Content="{Binding InUseRow}" ContentTemplate="{StaticResource Sources.Used}" />
                                            </StackPanel>

                                            <!-- The reserves, by latency in Snabbast or in the user's order in Prioriterad. -->
                                            <StackPanel Visibility="{Binding HasReserves, Converter={StaticResource Visible}}">
                                                <TextBlock Style="{StaticResource Sources.Heading}" Margin="0,18,0,8">
                                                    <Run Text="{Binding ReservesTitle, Mode=OneWay}" /><Run Text="  " /><Run
                                                        Text="{Binding ReservesHint, Mode=OneWay}" />
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding Reserves}" ItemTemplate="{StaticResource Sources.Reserve}"
                                                              Focusable="False" AutomationProperties.Name="Reserver" />
                                            </StackPanel>

                                            <!-- Those switched off, folded together. -->
                                            <StackPanel Visibility="{Binding HasDisabled, Converter={StaticResource Visible}}">
                                                <Button Style="{StaticResource Button.Icon}" Width="Auto" Height="24" Padding="0"
                                                        HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding ToggleDisabledCommand}"
                                                        AutomationProperties.Name="{Binding DisabledTitle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:GridIcon x:Name="FoldChevron" Size="12" Data="{StaticResource Icon.ChevronRight}"
                                                                           Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                            <controls:GridIcon.Style>
                                                                <Style TargetType="controls:GridIcon">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="0" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDisabledOpen}" Value="True">
                                                                            <Setter Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="90" />
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </controls:GridIcon.Style>
                                                        </controls:GridIcon>
                                                        <TextBlock Text="{Binding DisabledTitle}" FontSize="12.5" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <ItemsControl ItemsSource="{Binding Disabled}" ItemTemplate="{StaticResource Sources.Off}"
                                                              Margin="0,6,0,0" Focusable="False" AutomationProperties.Name="Avstängda"
                                                              Visibility="{Binding IsDisabledOpen, Converter={StaticResource Visible}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>

                            <!-- ===== A supplier of attribution: name, what it reports, its switch, its key and a note ===== -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                                          Visibility="{Binding IsSupplierShown, Converter={StaticResource Visible}}">
                                <StackPanel DataContext="{Binding Supplier}" Margin="26,18,28,20">
                                    <DockPanel Height="36">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Sources.Switch}" Command="{Binding ToggleCommand}"
                                                ToolTip="{Binding SwitchTip}" AutomationProperties.Name="{Binding SwitchTip}" />
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding About}" FontSize="13.5" Foreground="{StaticResource Brush.TextMuted}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasAbout, Converter={StaticResource Visible}}" />

                                    <TextBlock Text="API-NYCKEL" Style="{StaticResource Sources.Heading}" Margin="0,22,0,8" />
                                    <!-- A key in the vault: never shown again in clear, only that it is there. -->
                                    <Border Padding="16,0" Height="44" CornerRadius="10" BorderThickness="1.5"
                                            Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.BorderStrong}"
                                            Visibility="{Binding HasKey, Converter={StaticResource Visible}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="Auto" Height="28"
                                                    Padding="10,0" Content="Ta bort" FontSize="13" Command="{Binding RemoveKeyCommand}"
                                                    ToolTip="Tar bort nyckeln ur valvet" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:GridIcon Size="14" Data="{StaticResource Icon.Key}" Margin="0,0,10,0"
                                                                   Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                                <TextBlock Text="••••••••••••" FontSize="14" Foreground="{StaticResource Brush.TextMuted}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="Sparad i valvet" FontSize="12.5" Margin="12,0,0,0"
                                                           Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <!-- No key: a masked field, saved to the vault with Spara or Enter. -->
                                    <DockPanel Visibility="{Binding HasNoKey, Converter={StaticResource Visible}}">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Height="34" Padding="14,0"
                                                FontSize="13.5" Margin="8,0,0,0" Content="Spara" Click="OnSaveSupplierKey"
                                                ToolTip="Sparar nyckeln i valvet (Enter)" />
                                        <PasswordBox x:Name="SupplierKeyBox" Style="{StaticResource PasswordBox.Field}" Height="34"
                                                     FontSize="14" AutomationProperties.Name="API-nyckel" KeyDown="OnSupplierKeyKey" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding KeyError}" Style="{StaticResource Text.Error}" FontSize="13" Margin="0,6,0,0"
                                               TextWrapping="Wrap" Visibility="{Binding HasKeyError, Converter={StaticResource Visible}}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0"
                                                Visibility="{Binding HasNote, Converter={StaticResource Visible}}">
                                        <controls:GridIcon Size="14" Data="{StaticResource Icon.Info}" Margin="0,1,8,0"
                                                           Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding Note}" FontSize="13" Foreground="{StaticResource Brush.TextDim}"
                                                   TextWrapping="Wrap" MaxWidth="460" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
