<UserControl x:Class="Chainsaw.App.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}" mc:Ignorable="d" Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.SubmenuHover}" />
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- A tag beside the title: Inbyggd in green, Ingen nyckel in the warning colour. -->
        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!--
      Om Chainsaw (sketch ST2a): the version, the organisation's recovery key with its fingerprint in four lines of
      groups and Kopiera, the keys it revokes struck through, an honest warning when none is built in, and the licences.
      The same in the settings and over the lock screen.
    -->
    <StackPanel>
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" FontFamily="{StaticResource Font.Mono}"
                           FontSize="13" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Version" Style="{StaticResource Title}" />
                    <TextBlock Text="Bygget du kör." Style="{StaticResource Hint}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Row}" Padding="0,16,0,18">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Background="{StaticResource Brush.SuccessTint}"
                            Visibility="{Binding HasKey, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:GridIcon Size="13" Data="{StaticResource Icon.ShieldCheck}"
                                               Foreground="{StaticResource Brush.Success}" Margin="0,0,6,0" />
                            <TextBlock Text="Inbyggd" FontSize="12.5" Foreground="{StaticResource Brush.Success}" />
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Background="{StaticResource Brush.PendingTint}"
                            Visibility="{Binding HasNoKey, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:GridIcon Size="13" Data="{StaticResource Icon.Alert}"
                                               Foreground="{StaticResource Brush.Pending}" Margin="0,0,6,0" />
                            <TextBlock Text="Ingen nyckel" FontSize="12.5" Foreground="{StaticResource Brush.Pending}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Återställningsnyckel" Style="{StaticResource Title}" />
                        <TextBlock Text="{Binding KeyHint}" Style="{StaticResource Hint}" />
                    </StackPanel>
                </DockPanel>

                <!-- The fingerprint in four lines of four groups, and Kopiera at the right. -->
                <Border Margin="0,12,0,0" CornerRadius="10" Background="{StaticResource Brush.Background}"
                        BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1"
                        Visibility="{Binding HasKey, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <Button x:Name="CopyButton" DockPanel.Dock="Right" Width="108" Click="OnCopy" Cursor="Hand"
                                ToolTip="Kopiera fingeravtrycket" AutomationProperties.Name="Kopiera fingeravtrycket">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Box" Background="Transparent" BorderBrush="{StaticResource Brush.Border}"
                                            BorderThickness="1,0,0,0" CornerRadius="0,10,10,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <controls:GridIcon x:Name="CopyIcon" Size="18" HorizontalAlignment="Center">
                                    <controls:GridIcon.Style>
                                        <Style TargetType="controls:GridIcon">
                                            <Setter Property="Data" Value="{StaticResource Icon.Copy}" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource Icon.Check}" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:GridIcon.Style>
                                </controls:GridIcon>
                                <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Kopiera" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                    <Setter Property="Text" Value="Kopierat" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="16,14">
                            <TextBlock Text="FINGERAVTRYCK · SHA-256" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}"
                                       Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" AutomationProperties.Name="Fingeravtryck">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FingerprintLine}">
                                        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" Margin="0,1">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="15"
                                                               Margin="0,0,14,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock Text="Stämmer det med det administratören har, är det rätt nyckel." Style="{StaticResource Hint}"
                           Margin="0,10,0,0" Visibility="{Binding HasKey, Converter={StaticResource Visible}}" />

                <!-- No key built in: said honestly, dashed in the warning colour. -->
                <Border Margin="0,12,0,0" Padding="16,14" CornerRadius="10" Background="{StaticResource Brush.PendingTint}"
                        BorderBrush="{StaticResource Brush.PendingEdge}" BorderThickness="1.5"
                        Visibility="{Binding HasNoKey, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <controls:GridIcon DockPanel.Dock="Left" Size="20" Data="{StaticResource Icon.Alert}"
                                           Foreground="{StaticResource Brush.Pending}" VerticalAlignment="Top" Margin="0,1,12,0" />
                        <StackPanel>
                            <TextBlock Text="Ärenden skapas utan kuvert för organisationen." FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="Glöms huvudnyckeln kan ingen öppna dem. Journalens första rad i varje nytt ärende säger det."
                                       FontSize="13" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap"
                                       Margin="0,4,0,0" LineHeight="19" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- The keys revoked, struck through. -->
                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasRevoked, Converter={StaticResource Visible}}">
                    <TextBlock FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,4">
                        <Run Text="Återkallade" />
                        <Run Text="· deras kuvert tas bort ur ärenden som öppnas" FontSize="12"
                             Foreground="{StaticResource Brush.TextDim}" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Revoked}" Focusable="False" AutomationProperties.Name="Återkallade nycklar">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RevokedKey}">
                                <StackPanel Orientation="Horizontal" Height="30" Background="Transparent" ToolTip="{Binding FullText}">
                                    <controls:GridIcon Size="15" Data="{StaticResource Icon.Strike}"
                                                       Foreground="{StaticResource Brush.TextDim}" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ShortText}" FontFamily="{StaticResource Font.Mono}" FontSize="13"
                                               Foreground="{StaticResource Brush.TextDim}" TextDecorations="Strikethrough"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Row}" BorderThickness="0">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Height="32" Padding="14,0"
                            FontSize="14" Content="Visa" Command="{Binding ToggleLicensesCommand}" VerticalAlignment="Center"
                            AutomationProperties.Name="Visa licenser" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Licenser" Style="{StaticResource Title}" />
                        <TextBlock Text="WireGuard, gVisor och de andra delarna." Style="{StaticResource Hint}" />
                    </StackPanel>
                </DockPanel>
                <controls:GuideDocumentView Margin="0,12,0,0" Section="{Binding Licenses}" Compact="True"
                                            Visibility="{Binding IsShowingLicenses, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
