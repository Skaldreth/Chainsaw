<UserControl x:Class="Chainsaw.App.Views.LabelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:LabelsViewModel}"
             mc:Ignorable="d" Focusable="True" FocusVisualStyle="{x:Null}">

    <!--
      The view Etiketter (sketch ET1a): the sources as filters to the left with the library's counts under them; in the
      middle the switch between the case and the library, the filter field, and one dense list with the sanction hits in
      the graph gathered at the top in red; to the right the chosen label with its origins, Visa i grafen (G), and at
      the foot Sprid inte and Ta tillbaka. Only wiring; what happens lives in LabelsViewModel.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A small heading in capitals, as the sketch writes KÄLLOR and BIBLIOTEKET. -->
        <Style x:Key="Caps" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A row: a soft ground on hover, the raised surface and an accent edge on the left when chosen. -->
        <Style x:Key="Row" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="9" Background="Transparent">
                            <Grid>
                                <Border x:Name="Edge" Width="2" HorizontalAlignment="Left" CornerRadius="1" Margin="0,8"
                                        Background="{StaticResource Brush.Accent}" Visibility="Collapsed" />
                                <ContentPresenter Margin="10,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Floating}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                                <Setter TargetName="Edge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A source in the left column: a filter, faint while it is off. -->
        <Style x:Key="SourceRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="9" Background="Transparent" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Floating}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsOn}" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.4" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Visa i grafen on a row: shown on hover and on the chosen row, as in the sketch. -->
        <Style x:Key="RowShow" TargetType="Button" BasedOn="{StaticResource Button.Graph}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="ToolTip" Value="Visa i grafen · G" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A heading in the list: SANKTIONSTRÄFFAR I GRAFEN in red, the others in grey. -->
        <DataTemplate DataType="{x:Type vm:LabelGroupHeader}">
            <DockPanel Height="34" Margin="10,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" FontSize="11" VerticalAlignment="Bottom"
                           Margin="0,0,0,6" Foreground="{StaticResource Brush.TextDim}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                    <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,8,0" Fill="{StaticResource Brush.TextMuted}" />
                    <TextBlock x:Name="Title" Text="{Binding Title}" Style="{StaticResource Caps}" />
                    <TextBlock Text="{Binding Count}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextDim}" />
                </StackPanel>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRisk}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Kind.Sanctioned}" />
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.Kind.Sanctioned}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
          A label in the list (sketch ET1a): its sort as a small node, what it says with its node beside it and the
          address under, the cases in the library, and its marks: Sprid inte, från ett annat ärende, dots for
          independent origins (green when more than one), and the source as an icon, dashed for a suggestion.
        -->
        <DataTemplate DataType="{x:Type vm:LabelRowViewModel}">
            <Button Style="{StaticResource Row}" Height="54" Margin="0,0,0,2"
                    Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <DockPanel>
                    <Grid x:Name="Shape" DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,12,0"
                          ToolTip="{Binding Look.Name}" Background="Transparent">
                        <Rectangle x:Name="Frame" RadiusX="7" RadiusY="7" StrokeThickness="1.5"
                                   Stroke="{Binding Look.Ink, Converter={x:Static controls:GraphInkConverter.Instance}}" />
                        <controls:GridIcon Size="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding Look.Ink, Converter={x:Static controls:GraphInkConverter.Instance}}"
                                           Data="{Binding Look.Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                    </Grid>

                    <Button DockPanel.Dock="Right" Style="{StaticResource RowShow}" Margin="8,0,0,0"
                            Visibility="{Binding IsInGraph, Converter={StaticResource Visible}}"
                            Command="{Binding DataContext.ShowInGraphCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <controls:GridIcon Size="14" Data="{StaticResource Icon.Target}" />
                    </Button>
                    <Grid DockPanel.Dock="Right" Width="28" Visibility="{Binding IsInGraph, Converter={x:Static controls:InvertVisibility.Instance}}" />

                    <!-- The source as an icon in a small frame: red for a sanction list, dashed for a suggestion. -->
                    <Grid x:Name="SourceTile" DockPanel.Dock="Right" Width="26" Height="26" Margin="10,0,0,0"
                          Background="Transparent" ToolTip="{Binding SourceToolTip}">
                        <Rectangle x:Name="SourceFrame" RadiusX="7" RadiusY="7" StrokeThickness="1"
                                   Stroke="{StaticResource Brush.BorderStrong}" />
                        <controls:GridIcon x:Name="SourceIcon" Size="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Data="{Binding SourceIcon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                    </Grid>

                    <!-- Dots for independent origins: green when more than one confirms. -->
                    <ItemsControl DockPanel.Dock="Right" Width="30" ItemsSource="{Binding Dots}" Focusable="False"
                                  VerticalAlignment="Center" ToolTip="{Binding DotsToolTip}" Background="Transparent">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="6" Height="6" Margin="3,0,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Brush.TextFaint}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsConfirmed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Från ett annat ärende: the tag on a grey disc, as the mark in the graph's corner. -->
                    <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="9" Margin="6,0,0,0"
                            Background="{StaticResource Brush.Mark.OtherCase}" ToolTip="Från ett annat ärende, genom biblioteket"
                            Visibility="{Binding IsFromOtherCase, Converter={StaticResource Visible}}">
                        <controls:GridIcon Size="12" Foreground="{StaticResource Brush.Text}" Data="{StaticResource Icon.Tag}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- In a pile or in the trash: a small mark, since the hit is not drawn on its own. -->
                    <Grid DockPanel.Dock="Right" Margin="6,0,0,0" Background="Transparent" ToolTip="{Binding PlaceText}"
                          Visibility="{Binding HasPlaceMark, Converter={StaticResource Visible}}">
                        <controls:GridIcon Size="14" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"
                                           Data="{Binding PlaceIcon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                    </Grid>
                    <Grid DockPanel.Dock="Right" Margin="6,0,0,0" Background="Transparent" ToolTip="Sprid inte: stannar i ärendet"
                          Visibility="{Binding IsNoSpread, Converter={StaticResource Visible}}">
                        <controls:GridIcon Size="14" Foreground="{StaticResource Brush.TextDim}" Data="{StaticResource Icon.NoSpread}"
                                           VerticalAlignment="Center" />
                    </Grid>

                    <!-- The cases that hold it, in the library. -->
                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Cases}" Focusable="False" VerticalAlignment="Center"
                                  Visibility="{Binding HasCases, Converter={StaticResource Visible}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="20" Padding="7,0" CornerRadius="5" Margin="4,0,0,0"
                                        Background="{StaticResource Brush.SurfaceRaised}">
                                    <TextBlock Text="{Binding}" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="Words" VerticalAlignment="Center">
                        <TextBlock x:Name="Title" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Brush.Text}">
                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  " /><Run
                                Text="{Binding NodeName, Mode=OneWay}" FontSize="12" Foreground="{StaticResource Brush.TextDim}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Address}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                                   Margin="0,3,0,0" Foreground="{StaticResource Brush.TextDim}" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRound}" Value="True">
                    <Setter TargetName="Frame" Property="RadiusX" Value="13" />
                    <Setter TargetName="Frame" Property="RadiusY" Value="13" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDashed}" Value="True">
                    <Setter TargetName="Frame" Property="StrokeDashArray" Value="2.5 1.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSuggestion}" Value="True">
                    <Setter TargetName="SourceFrame" Property="StrokeDashArray" Value="3 2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSanction}" Value="True">
                    <Setter TargetName="SourceFrame" Property="Stroke" Value="{StaticResource Brush.Kind.Sanctioned}" />
                    <Setter TargetName="SourceIcon" Property="Foreground" Value="{StaticResource Brush.Kind.Sanctioned}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRetracted}" Value="True">
                    <Setter TargetName="Shape" Property="Opacity" Value="0.45" />
                    <Setter TargetName="Words" Property="Opacity" Value="0.45" />
                    <Setter TargetName="SourceTile" Property="Opacity" Value="0.45" />
                    <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- An origin of the chosen label: a disc with the source's icon, a line down to the next, and the words. -->
        <DataTemplate x:Key="Origin" DataType="{x:Type vm:LabelOriginRow}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Left" Width="28" Margin="0,0,11,0">
                    <Border DockPanel.Dock="Top" Width="28" Height="28" CornerRadius="14"
                            Background="{StaticResource Brush.SurfaceRaised}">
                        <controls:GridIcon x:Name="Icon" Size="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Data="{Binding Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                    </Border>
                    <Rectangle Width="1" Margin="0,4,0,0" Fill="{StaticResource Brush.BorderStrong}"
                               Visibility="{Binding HasLine, Converter={StaticResource Visible}}" />
                </DockPanel>
                <StackPanel x:Name="Words" Margin="0,0,0,12">
                    <TextBlock x:Name="Who" Text="{Binding Who}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="{Binding When}" FontSize="11.5" Margin="0,3,0,0" Foreground="{StaticResource Brush.TextDim}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                Visibility="{Binding HasCase, Converter={StaticResource Visible}}">
                        <controls:GridIcon x:Name="CaseIcon" Size="12" Margin="0,0,6,0" Foreground="{StaticResource Brush.TextDim}"
                                           Data="{StaticResource Icon.Tag}" VerticalAlignment="Center" />
                        <TextBlock x:Name="CaseText" Text="{Binding CaseText}" FontSize="11.5"
                                   Foreground="{StaticResource Brush.TextDim}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Why}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="18"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Visibility="{Binding HasWhy, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding Meta}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.TextDim}"
                               Visibility="{Binding HasMeta, Converter={StaticResource Visible}}" />
                </StackPanel>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSanction}" Value="True">
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Brush.Kind.Sanctioned}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOtherCase}" Value="True">
                    <Setter TargetName="CaseIcon" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                    <Setter TargetName="CaseText" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRetracted}" Value="True">
                    <Setter TargetName="Words" Property="Opacity" Value="0.5" />
                    <Setter TargetName="Who" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A chip under the chosen label's name: dashed for a judgement, red for the sanction list. -->
        <DataTemplate x:Key="Chip" DataType="{x:Type vm:LabelChip}">
            <Grid Height="22" Margin="0,0,6,6" ToolTip="{Binding ToolTip}" Background="Transparent">
                <Rectangle x:Name="Edge" RadiusX="6" RadiusY="6" StrokeThickness="1" Stroke="{StaticResource Brush.BorderStrong}" />
                <StackPanel Orientation="Horizontal" Margin="6,0,8,0" VerticalAlignment="Center">
                    <controls:GridIcon x:Name="Icon" Size="12" Margin="0,0,5,0" Foreground="{StaticResource Brush.TextMuted}"
                                       Data="{Binding Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                    <TextBlock x:Name="Words" Text="{Binding Text}" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDashed}" Value="True">
                    <Setter TargetName="Edge" Property="StrokeDashArray" Value="3 2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSanction}" Value="True">
                    <Setter TargetName="Edge" Property="Stroke" Value="{StaticResource Brush.Kind.Sanctioned}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Brush.Kind.Sanctioned}" />
                    <Setter TargetName="Words" Property="Foreground" Value="{StaticResource Brush.Kind.Sanctioned}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="84,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ===== The sources, each a filter, and the library's counts. ===== -->
        <StackPanel Grid.Column="0" Margin="0,4,0,0">
            <TextBlock Text="KÄLLOR" Style="{StaticResource Caps}" Height="28" Padding="10,8,0,0" />
            <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LabelSourceViewModel}">
                        <Button Style="{StaticResource SourceRow}" ToolTip="{Binding ToolTip}"
                                Command="{Binding DataContext.ToggleSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <DockPanel>
                                <Border x:Name="Tile" DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="8" Margin="0,0,11,0"
                                        Background="{StaticResource Brush.SurfaceRaised}">
                                    <controls:GridIcon x:Name="Icon" Size="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.TextMuted}"
                                                       Data="{Binding Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextMuted}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Brush.Text}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource Brush.TextDim}" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSanction}" Value="True">
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Brush.Kind.Sanctioned}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Rectangle Height="1" Margin="10,12" Fill="{StaticResource Brush.Border}" />
            <TextBlock Text="BIBLIOTEKET" Style="{StaticResource Caps}" Height="28" Padding="10,8,0,0" />
            <StackPanel Margin="10,2,10,0">
                <DockPanel Margin="0,0,0,9" Background="Transparent"
                           ToolTip="Etiketterna ur alla ärenden du öppnat på den här datorn, krypterade i valvet">
                    <controls:GridIcon DockPanel.Dock="Left" Size="14" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextMuted}"
                                       Data="{StaticResource Icon.Library}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LibraryCount}" FontSize="12.5" Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="Hela biblioteket" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}" />
                </DockPanel>
                <DockPanel Margin="0,0,0,9" Background="Transparent" ToolTip="Kom in från biblioteket, från andra ärenden">
                    <controls:GridIcon DockPanel.Dock="Left" Size="14" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextMuted}"
                                       Data="{StaticResource Icon.Download}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CameIn}" FontSize="12.5" Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="Kom in" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}" />
                </DockPanel>
                <DockPanel Margin="0,0,0,9" Background="Transparent" ToolTip="Etiketter ur ärendet som finns i biblioteket">
                    <controls:GridIcon DockPanel.Dock="Left" Size="14" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextMuted}"
                                       Data="{StaticResource Icon.Upload}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding WentOut}" FontSize="12.5" Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="Gick ut" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}" />
                </DockPanel>
                <DockPanel Background="Transparent" ToolTip="Märkta Sprid inte: stannar i ärendet">
                    <controls:GridIcon DockPanel.Dock="Left" Size="14" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextMuted}"
                                       Data="{StaticResource Icon.NoSpread}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding NoSpreadCount}" FontSize="12.5" Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="Sprids inte" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}" />
                </DockPanel>
            </StackPanel>
        </StackPanel>

        <!-- ===== The switch, the filter field and the list. ===== -->
        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Border DockPanel.Dock="Left" Padding="2" CornerRadius="9" BorderThickness="1" Margin="0,0,10,0"
                        BorderBrush="{StaticResource Brush.BorderStrong}" Background="{StaticResource Brush.Surface}">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ChooseScopeCommand}" CommandParameter="{x:Static vm:LabelScope.Case}"
                                ToolTip="Etiketterna i det här ärendet">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Graph}">
                                    <Setter Property="Height" Value="28" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLibrary}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ärendet" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CaseCount}" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextDim}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ChooseScopeCommand}" CommandParameter="{x:Static vm:LabelScope.Library}"
                                ToolTip="Alla ärenden du öppnat på datorn, krypterat i valvet">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Graph}">
                                    <Setter Property="Height" Value="28" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLibrary}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Biblioteket" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LibraryCount}" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextDim}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Grid>
                    <TextBox x:Name="Filter" Style="{StaticResource TextBox.Field}" Height="34" FontSize="13" Padding="30,0,10,0"
                             Tag="Filtrera på namn, adress eller ärende"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:GridIcon Size="15" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Foreground="{StaticResource Brush.TextDim}"
                                       Data="{StaticResource Icon.Search}" />
                </Grid>
            </DockPanel>

            <Border CornerRadius="12" BorderThickness="1" Padding="6" BorderBrush="{StaticResource Brush.Border}"
                    Background="{StaticResource Brush.Graph.Lane}">
                <Grid>
                    <!-- A ListBox only for its virtualizing and ScrollIntoView: the rows choose, not the ListBox. -->
                    <ListBox x:Name="List" ItemsSource="{Binding Items}" Focusable="False" Background="Transparent"
                             BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                             Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="20"
                                Visibility="{Binding HasItems, Converter={x:Static controls:InvertVisibility.Instance}}">
                        <controls:GridIcon Size="40" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextFaint}"
                                           Data="{StaticResource Icon.Tag}" />
                        <TextBlock Text="{Binding EmptyMessage}" FontSize="13.5" Margin="0,14,0,0" TextWrapping="Wrap"
                                   TextAlignment="Center" LineHeight="21" Foreground="{StaticResource Brush.TextDim}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>

        <!-- ===== The chosen label; without one the panel is removed. ===== -->
        <Border Grid.Column="4" Width="384" CornerRadius="14" BorderThickness="1" ClipToBounds="True"
                BorderBrush="{StaticResource Brush.Border}" Background="{StaticResource Brush.Surface}"
                Visibility="{Binding HasSelected, Converter={StaticResource Visible}}">
            <DockPanel DataContext="{Binding Selected}">
                <!-- The head: the sort, the name, the address with Kopiera, the chips, what it says and its node. -->
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,16">
                    <DockPanel>
                        <Grid DockPanel.Dock="Left" Width="42" Height="42" Margin="0,0,13,0" ToolTip="{Binding Look.Name}"
                              Background="Transparent">
                            <Rectangle x:Name="BigFrame" StrokeThickness="1.5"
                                       Stroke="{Binding Look.Ink, Converter={x:Static controls:GraphInkConverter.Instance}}">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="RadiusX" Value="11" />
                                        <Setter Property="RadiusY" Value="11" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRound}" Value="True">
                                                <Setter Property="RadiusX" Value="21" />
                                                <Setter Property="RadiusY" Value="21" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDashed}" Value="True">
                                                <Setter Property="StrokeDashArray" Value="3 2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <controls:GridIcon Size="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding Look.Ink, Converter={x:Static controls:GraphInkConverter.Instance}}"
                                               Data="{Binding Look.Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Brush.Text}" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding Address}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                           VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}"
                                           ToolTip="{Binding FullAddress}" />
                                <Button Style="{StaticResource Button.Icon}" Width="22" Height="22" Margin="4,0,0,0"
                                        Click="OnCopyAddress" ToolTip="Kopiera hela adressen">
                                    <controls:GridIcon Size="12" Data="{StaticResource Icon.Copy}" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource Chip}" Focusable="False"
                                  Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="{Binding Title}" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="21">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRetracted}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" ToolTip="Noden i grafen" Background="Transparent"
                                Visibility="{Binding IsInGraph, Converter={StaticResource Visible}}">
                        <controls:GridIcon Size="14" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextDim}"
                                           Data="{StaticResource Icon.Graph}" />
                        <TextBlock Text="{Binding NodeInfo}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="310"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                    </StackPanel>

                    <Border Margin="0,12,0,0" Padding="11,9" CornerRadius="9" Background="{StaticResource Brush.SurfaceRaised}"
                            Visibility="{Binding IsRetracted, Converter={StaticResource Visible}}">
                        <DockPanel>
                            <controls:GridIcon DockPanel.Dock="Left" Size="14" Margin="0,1,9,0" VerticalAlignment="Top"
                                               Foreground="{StaticResource Brush.TextMuted}" Data="{StaticResource Icon.Undo}" />
                            <TextBlock Text="{Binding RetractedText}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                        </DockPanel>
                    </Border>

                    <Button Style="{StaticResource Button.Primary}" Height="38" Margin="0,14,0,0"
                            Command="{Binding DataContext.ShowInGraphCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip="Visa i grafen · G"
                            Visibility="{Binding IsInGraph, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:GridIcon Size="15" Margin="0,0,8,0" Foreground="{StaticResource Brush.OnAccent}"
                                               Data="{StaticResource Icon.Target}" />
                            <TextBlock Text="Visa i grafen" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="G" FontSize="11" Margin="8,0,0,0" Opacity="0.7" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- The foot: Sprid inte and Ta tillbaka, for a label in the case the user can change. -->
                <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="20,12,20,16"
                        BorderBrush="{StaticResource Brush.Border}" Background="{StaticResource Brush.Floating}"
                        Visibility="{Binding DataContext.HasActions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <DockPanel Background="Transparent" Visibility="{Binding ShowsSpread, Converter={StaticResource Visible}}"
                                   ToolTip="Etiketten stannar i ärendet och går inte till biblioteket eller till andra ärenden">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Toggle.Switch}"
                                          AutomationProperties.Name="Sprid inte"
                                          IsChecked="{Binding IsNoSpread, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleSpreadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <controls:GridIcon DockPanel.Dock="Left" Size="15" Margin="0,0,10,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextMuted}" Data="{StaticResource Icon.NoSpread}" />
                            <TextBlock Text="Sprid inte" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                        </DockPanel>
                        <TextBlock Text="{Binding SpreadNote}" FontSize="11.5" Margin="25,4,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextDim}"
                                   Visibility="{Binding HasSpreadNote, Converter={StaticResource Visible}}" />

                        <Button Style="{StaticResource Button.Secondary}" Height="34" Margin="0,10,0,0"
                                Command="{Binding DataContext.BeginRetractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="Tas tillbaka också i biblioteket. Skälet är frivilligt."
                                Visibility="{Binding DataContext.ShowsRetractButton, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <controls:GridIcon Size="14" Margin="0,0,8,0" Data="{StaticResource Icon.Undo}" />
                                <TextBlock Text="Ta tillbaka …" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Ta tillbaka folded out: the optional reason, Avbryt (Esc) and Ta tillbaka (Enter). -->
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding DataContext.IsRetracting, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}">
                            <TextBox x:Name="Reason" Style="{StaticResource TextBox.Field}" Height="34" FontSize="13"
                                     Tag="Skäl (frivilligt)" KeyDown="OnReasonKey"
                                     Text="{Binding DataContext.RetractReason, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                            <DockPanel Margin="0,8,0,0" LastChildFill="False">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Height="32" Padding="12,0"
                                        Content="Ta tillbaka" ToolTip="Ta tillbaka · Enter"
                                        Command="{Binding DataContext.ConfirmRetractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Height="32" Padding="12,0"
                                        Margin="0,0,8,0" Content="Avbryt" ToolTip="Avbryt · Esc"
                                        Command="{Binding DataContext.CancelRetractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The origins: who, when, which case and why, one per row. -->
                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="20,14,20,10">
                        <StackPanel>
                            <TextBlock Text="{Binding OriginTitle}" Style="{StaticResource Caps}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Origins}" ItemTemplate="{StaticResource Origin}" Focusable="False" />
                            <Button HorizontalAlignment="Left" Cursor="Hand" Focusable="False" ToolTip="Öppnar Guiden om etiketter"
                                    Command="{Binding DataContext.WhyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding HasWhy, Converter={StaticResource Visible}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <Border x:Name="Ring" Width="18" Height="18" CornerRadius="9" BorderThickness="1"
                                                    BorderBrush="{StaticResource Brush.BorderHover}" Margin="0,0,6,0">
                                                <controls:GridIcon Size="12" Foreground="{StaticResource Brush.TextMuted}"
                                                                   Data="{StaticResource Icon.Question}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Name="Words" Text="Varför?" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.TextMuted}" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Words" Property="Foreground" Value="{StaticResource Brush.Text}" />
                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Brush.Text}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
