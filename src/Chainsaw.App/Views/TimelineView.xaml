<UserControl x:Class="Chainsaw.App.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:TimelineViewModel}"
             mc:Ignorable="d" Focusable="True" FocusVisualStyle="{x:Null}">

    <!--
      The view Tidslinje (sketch TL3a): the zoom, the chips and the method in the head, the lanes, and the overview strip
      at the bottom; to the right the chosen event with the facts from the chain, the events on its actor's lane, what is
      a judgement in a dashed box and Visa i grafen. Only wiring; what happens lives in TimelineViewModel, and the lanes
      are drawn by TimelineChart.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A choice of the zoom: the chosen one on the selected ground. -->
        <Style x:Key="Zoom" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Height="28" Padding="12,0" CornerRadius="7" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="12.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A quiet pill: a chip, the hours' way back. -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Height="28" Padding="8,0,9,0" CornerRadius="14" BorderThickness="1"
                                BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row of a list: a soft ground on hover, the raised ground when chosen. -->
        <Style x:Key="Row" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Padding="8,0" CornerRadius="7" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caps" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Nothing to show yet: said honestly, with the view's icon, never with made-up lanes. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80" MaxWidth="440"
                    Visibility="{Binding HasEvents, Converter={x:Static controls:InvertVisibility.Instance}}">
            <controls:GridIcon Size="40" Foreground="{StaticResource Brush.TextFaint}" HorizontalAlignment="Center"
                               Data="{StaticResource Icon.Timeline}" />
            <TextBlock Text="{x:Static vm:TimelineViewModel.EmptyText}" FontSize="13.5" Margin="0,14,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="21" Foreground="{StaticResource Brush.TextDim}" />
            <TextBlock Text="{Binding Problem}" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{StaticResource Brush.Error}" Visibility="{Binding HasProblem, Converter={StaticResource Visible}}" />
        </StackPanel>

        <Grid x:Name="Room" Margin="84,16,20,16" Visibility="{Binding HasEvents, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- ===== The lanes, with the zoom, the chips and the method over them, and the strip under them. ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">
                    <Border DockPanel.Dock="Left" Padding="2" CornerRadius="9" BorderThickness="1" Margin="0,0,8,0"
                            VerticalAlignment="Center" BorderBrush="{StaticResource Brush.BorderStrong}"
                            Background="{StaticResource Brush.Surface}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Zoom}" Content="Dygn" ToolTip="Dygn · Ctrl+−" Tag="{Binding IsDays}"
                                    Command="{Binding ShowDaysCommand}" />
                            <Button Style="{StaticResource Zoom}" Content="Timmar" ToolTip="Timmar · Ctrl++" Tag="{Binding IsHours}"
                                    Command="{Binding ShowHoursCommand}" />
                        </StackPanel>
                    </Border>

                    <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Chips}" Focusable="False" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TimelineChip}">
                                <Button Style="{StaticResource Ghost}" ToolTip="{Binding ToolTip}" CommandParameter="{Binding Filter}"
                                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="Dot" Width="8" Height="8" StrokeThickness="1.5" VerticalAlignment="Center"
                                                 Stroke="{Binding Brush, Converter={x:Static controls:ResourceKeyConverter.Instance}}"
                                                 Fill="{Binding Brush, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                                        <TextBlock x:Name="Words" Text="{Binding Name}" FontSize="12" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="False">
                                        <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                                        <Setter TargetName="Words" Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                                        <Setter TargetName="Words" Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The method, dashed: what the colours rest on is a judgement by it. -->
                    <Grid DockPanel.Dock="Right" Height="30" VerticalAlignment="Center" Background="Transparent"
                          ToolTip="Spårade belopp räknas med spårningsmetoden och är en bedömning">
                        <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="1" StrokeDashArray="3 2" SnapsToDevicePixels="True"
                                   Stroke="{StaticResource Brush.BorderHover}" />
                        <TextBlock Text="{Binding MethodText}" FontSize="12.5" FontWeight="SemiBold" Margin="11,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource Brush.Text}" />
                    </Grid>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <controls:TimelineChart x:Name="Chart" Picture="{Binding Picture}" PickCommand="{Binding PickCommand}" />

                    <!-- In the hours: how many events lie outside, and a way back to the days. -->
                    <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,4,0,0"
                            Command="{Binding ShowDaysCommand}" ToolTip="Tidigare händelser · tillbaka till dygn"
                            Visibility="{Binding HasBefore, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding BeforeText}" FontSize="11.5" Foreground="{StaticResource Brush.TextMuted}" />
                    </Button>
                    <Button Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,26,0,0"
                            Command="{Binding ShowDaysCommand}" ToolTip="Senare händelser · tillbaka till dygn"
                            Visibility="{Binding HasAfter, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding AfterText}" FontSize="11.5" Foreground="{StaticResource Brush.TextMuted}" />
                    </Button>
                </Grid>

                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border}" Margin="0,8,0,0"
                        Padding="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RangeText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                            <TextBlock Text="{Binding CountText}" FontSize="11.5" Margin="0,3,0,0"
                                       Foreground="{StaticResource Brush.TextDim}" />
                        </StackPanel>
                        <controls:TimelineStripView Grid.Column="1" Height="46" Margin="0,0,20,0" Strip="{Binding Strip}"
                                                    ToolTip="Hela ärendet · rutan är det som visas ovanför" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== The inspector: the chosen event. ===== -->
            <Border Grid.Column="2" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource Brush.Border}"
                    Background="{StaticResource Brush.Surface}" ClipToBounds="True"
                    Visibility="{Binding HasDetail, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Button.Primary}" Height="38" Margin="20,16,20,18"
                            Command="{Binding ShowInGraphCommand}" ToolTip="Visa i grafen · G">
                        <StackPanel Orientation="Horizontal">
                            <controls:GridIcon Size="15" Foreground="{StaticResource Brush.OnAccent}" VerticalAlignment="Center"
                                               Data="{StaticResource Icon.Target}" />
                            <TextBlock Text="Visa i grafen" FontSize="13.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="G" FontSize="11" FontWeight="Normal" Opacity="0.7" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="20,18,20,0">
                        <StackPanel>
                            <!-- The head: the icon in the kind's colour, the title and what it is. -->
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" BorderThickness="1.5"
                                        BorderBrush="{Binding Detail.Brush, Converter={x:Static controls:ResourceKeyConverter.Instance}}">
                                    <controls:GridIcon Size="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding Detail.Brush, Converter={x:Static controls:ResourceKeyConverter.Instance}}"
                                                       Data="{Binding Detail.Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Detail.Title}" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource Brush.Text}" />
                                    <TextBlock Text="{Binding Detail.Line}" FontSize="12" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource Brush.TextMuted}" />
                                </StackPanel>
                            </DockPanel>

                            <!-- The amount, large, and its value at the time. -->
                            <DockPanel Margin="0,16,0,0" Visibility="{Binding Detail.HasAmount, Converter={StaticResource Visible}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail.Value}" FontSize="13" VerticalAlignment="Bottom"
                                           Margin="0,0,0,4" Foreground="{StaticResource Brush.TextMuted}"
                                           ToolTip="Kursen vid blocktiden · Bitstamp i euro × Riksbanken" />
                                <TextBlock VerticalAlignment="Bottom">
                                    <Run Text="{Binding Detail.Amount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold"
                                         Foreground="{StaticResource Brush.Text}" />
                                    <Run Text="{Binding Detail.Unit, Mode=OneWay}" FontSize="13" Foreground="{StaticResource Brush.TextMuted}" />
                                </TextBlock>
                            </DockPanel>

                            <!-- The facts: from the chain, every one checkable with any tool. -->
                            <Border Margin="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border}">
                                <ItemsControl ItemsSource="{Binding Detail.Facts}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TimelineFact}">
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border}" MinHeight="34">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="86" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontSize="12.5" Margin="0,8"
                                                               Foreground="{StaticResource Brush.TextDim}" />
                                                    <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding Value}" FontSize="12.5" Margin="0,8"
                                                               TextWrapping="Wrap" LineHeight="18" Foreground="{StaticResource Brush.Text}" />
                                                    <Button Grid.Column="2" Style="{StaticResource Row}" Height="24" VerticalAlignment="Center"
                                                            ToolTip="Kopiera" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Visibility="{Binding CanCopy, Converter={StaticResource Visible}}">
                                                        <controls:GridIcon Size="13" Foreground="{StaticResource Brush.TextMuted}"
                                                                           Data="{StaticResource Icon.Copy}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMono}" Value="True">
                                                    <Setter TargetName="Value" Property="FontFamily" Value="Cascadia Mono, Consolas" />
                                                    <Setter TargetName="Value" Property="FontSize" Value="12" />
                                                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- The events on the chosen actor's lane. -->
                            <TextBlock Text="{Binding SequenceTitle}" Style="{StaticResource Caps}" Margin="0,18,0,6" />
                            <ItemsControl ItemsSource="{Binding Sequence}" Focusable="False" Margin="-8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TimelineRow}">
                                        <Button Style="{StaticResource Row}" Height="30" Tag="{Binding IsSelected}" CommandParameter="{Binding Id}"
                                                Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <DockPanel>
                                                <Ellipse DockPanel.Dock="Left" Width="6" Height="6" VerticalAlignment="Center"
                                                         Fill="{Binding Brush, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding When}" Width="92" FontSize="12" Margin="10,0,0,0"
                                                           VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush.Text}" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" Margin="10,0,8,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource Brush.TextMuted}" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- What is a judgement, dashed, with Varför?. -->
                            <Grid Margin="0,14,0,0" Visibility="{Binding Detail.IsJudged, Converter={StaticResource Visible}}">
                                <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1" StrokeDashArray="3 2" SnapsToDevicePixels="True"
                                           Stroke="{StaticResource Brush.BorderHover}" />
                                <DockPanel Margin="12,10">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Row}" Height="22" Command="{Binding AskWhyCommand}"
                                            ToolTip="Öppnar Guiden bredvid · ?">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:GridIcon Size="12" Foreground="{StaticResource Brush.TextMuted}"
                                                               Data="{StaticResource Icon.Question}" />
                                            <TextBlock Text="Varför?" FontSize="12" Margin="5,0,0,0" Foreground="{StaticResource Brush.TextMuted}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding Detail.Judgement}" FontSize="12" TextWrapping="Wrap" LineHeight="17"
                                               VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
                                </DockPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
