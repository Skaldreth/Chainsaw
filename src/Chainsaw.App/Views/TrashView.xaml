<UserControl x:Class="Chainsaw.App.Views.TrashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:TrashViewModel}"
             mc:Ignorable="d" Background="{StaticResource Brush.Background}">

    <!--
      The trash's own view (sketch SO2a), opened by a click on the bin: the head with the title, what lies in it,
      Lägg tillbaka allt and close; then one card per throw, its head the thrown things as small shapes laid like a deck
      of cards, and its tree with real branch lines folded out under it; and the cases thrown on the start page as tiles,
      a pile with cards behind it. Lägg tillbaka shows on hover. Empty, the bin is a large icon sunk into the surface.
      Only wiring; what happens lives in TrashViewModel.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TrashTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />

            <!-- A card's ground, a step below the panels, and its tree's a step below the card (sketch SO2a). -->
            <SolidColorBrush x:Key="Brush.TrashCard" Color="#26292D" />
            <SolidColorBrush x:Key="Brush.TrashTree" Color="#232629" />
            <SolidColorBrush x:Key="Brush.TrashTileHover" Color="#292C30" />
            <!-- A light grey between the text and the muted text, for the tiles' icons and the empty bin's title. -->
            <SolidColorBrush x:Key="Brush.TextLight" Color="#C9CDCF" />
            <!-- The watch's own tone, faint, behind the card's "bevakas". -->
            <SolidColorBrush x:Key="Brush.WatchTint" Color="#1A9AD0DC" />
            <!-- The empty bin's ink: darker than the ground, so that with its light lower edge it reads as sunk in. -->
            <SolidColorBrush x:Key="Brush.TrashSunk" Color="#1C1F22" />

            <!-- A section's heading: small capitals, its count, and a line to the right edge. -->
            <Style x:Key="Text.TrashSection" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- A card: lifts its edge on hover, and shows its Lägg tillbaka (tagged Reveal) only then. -->
            <Style x:Key="Border.TrashCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                <Setter Property="Background" Value="{StaticResource Brush.TrashCard}" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The card's Lägg tillbaka: a quiet framed button, shown on the card's hover. -->
            <Style x:Key="Button.CardBack" TargetType="Button" BasedOn="{StaticResource Button.TrashQuiet}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="11,0" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Opacity" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}"
                                 Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A round button with the undo icon: a row's or a tile's Lägg tillbaka, shown on its hover. -->
            <Style x:Key="Button.RoundBack" TargetType="Button">
                <!-- Its row's or tile's border is the nearest Border above it; the template itself draws none. -->
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Ring" Fill="{TemplateBinding Background}"
                                         Stroke="{StaticResource Brush.BorderStrong}" StrokeThickness="1" />
                                <controls:GridIcon Size="13" Data="{StaticResource Icon.Undo}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Fill" Value="{StaticResource Brush.SurfaceSelected}" />
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.BorderHover}" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Opacity" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}"
                                 Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A row of the tree: a light hover behind it. -->
            <Style x:Key="Border.TrashRow" TargetType="Border">
                <Setter Property="Height" Value="38" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Brush.Floating}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A tile on the start page's grid: lifts a pixel and brightens its edge a step on hover. -->
            <Style x:Key="Border.TrashTile" TargetType="Border">
                <Setter Property="Height" Value="72" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,0,12,0" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                <Setter Property="Background" Value="{StaticResource Brush.TrashCard}" />
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                        <Setter Property="Background" Value="{StaticResource Brush.TrashTileHover}" />
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TranslateTransform Y="-1" />
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The undo icon and a word, for a framed Lägg tillbaka. -->
            <DataTemplate x:Key="BackLabel">
                <StackPanel Orientation="Horizontal">
                    <controls:GridIcon Size="13" Data="{StaticResource Icon.Undo}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Margin="0,0,7,0" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>

            <!-- The fold arrow in a card's head: down when folded, up when the tree is out. -->
            <Style x:Key="Toggle.CardHead" TargetType="ToggleButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="120,26,56,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The head: the bin, the title and what lies in it; Lägg tillbaka allt and close. -->
        <DockPanel MaxWidth="980" HorizontalAlignment="Stretch">
            <controls:GridIcon DockPanel.Dock="Left" Size="26" Data="{StaticResource Icon.Trash}"
                               Foreground="{StaticResource Brush.TextMuted}" Margin="2,0,16,0" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Margin="10,0,0,0" VerticalAlignment="Center"
                    Command="{Binding CloseCommand}" ToolTip="Tillbaka till grafen · Esc"
                    AutomationProperties.Name="Stäng soptunnan">
                <controls:GridIcon Size="16" Data="{StaticResource Icon.Close}" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.TrashQuiet}" Height="32" Padding="12,0"
                    FontSize="12.5" Background="Transparent" VerticalAlignment="Center"
                    Command="{Binding RestoreEverythingCommand}" Content="Lägg tillbaka allt"
                    ContentTemplate="{StaticResource BackLabel}" ToolTip="Lägger tillbaka allt där det stod"
                    Visibility="{Binding IsEmpty, Converter={x:Static controls:InvertVisibility.Instance}}" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Static vm:TrashViewModel.Title}" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SubText}" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}"
                           Margin="0,3,0,0"
                           Visibility="{Binding IsEmpty, Converter={x:Static controls:InvertVisibility.Instance}}" />
            </StackPanel>
        </DockPanel>

        <!-- Empty: the bin large and sunk into the surface (a light lower edge, a shadow above), and one quiet line. -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-64,0,0,90"
                    Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
            <Grid HorizontalAlignment="Center">
                <controls:GridIcon Size="120" Data="{StaticResource Icon.Trash}" Margin="0,-1,0,0"
                                   Foreground="#59000000" />
                <controls:GridIcon Size="120" Data="{StaticResource Icon.Trash}" Margin="0,1.5,0,0"
                                   Foreground="#12FFFFFF" />
                <controls:GridIcon Size="120" Data="{StaticResource Icon.Trash}"
                                   Foreground="{StaticResource Brush.TrashSunk}" />
            </Grid>
            <TextBlock Text="{x:Static vm:TrashViewModel.EmptyTitle}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextLight}" HorizontalAlignment="Center" Margin="0,22,0,0" />
            <TextBlock Text="{x:Static vm:TrashViewModel.EmptyText}" FontSize="13"
                       Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,22,0,0"
                      Visibility="{Binding IsEmpty, Converter={x:Static controls:InvertVisibility.Instance}}">
            <StackPanel MaxWidth="980" Margin="0,0,0,40">

                <!-- The case: one card per throw. -->
                <StackPanel Visibility="{Binding HasThrows, Converter={StaticResource Visible}}">
                    <DockPanel Height="28" Margin="0,0,0,10">
                        <TextBlock Text="{x:Static vm:TrashViewModel.ThrowsTitle}" Style="{StaticResource Text.TrashSection}" />
                        <TextBlock Text="{Binding ThrowsCount}" FontSize="12" Foreground="{StaticResource Brush.TextDim}"
                                   Margin="10,0,10,0" VerticalAlignment="Center" />
                        <Rectangle Height="1" Fill="{StaticResource Brush.Border}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TrashThrowGroup}">
                                <Border Style="{StaticResource Border.TrashCard}">
                                    <StackPanel>
                                        <!-- The head folds the tree in and out. -->
                                        <ToggleButton x:Name="Fold" Style="{StaticResource Toggle.CardHead}" Height="58"
                                                      Padding="16,0,12,0">
                                            <DockPanel>
                                                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Deck}" Focusable="False"
                                                              VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:TrashRowViewModel}">
                                                            <ContentPresenter x:Name="Card" Content="{Binding}"
                                                                              ContentTemplate="{StaticResource Trash.KindDeck}"
                                                                              Margin="-12,0,0,0" />
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                                    <Setter TargetName="Card" Property="Margin" Value="0" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <controls:GridIcon x:Name="Chevron" DockPanel.Dock="Right" Size="15"
                                                                   Data="{StaticResource Icon.ChevronDown}"
                                                                   Foreground="{StaticResource Brush.TextDim}" Margin="8,0,4,0"
                                                                   VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                                                   Visibility="{Binding HasTree, Converter={StaticResource Visible}}" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.CardBack}"
                                                        Command="{Binding DataContext.RestoreAllCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Content="Lägg tillbaka"
                                                        ContentTemplate="{StaticResource BackLabel}" VerticalAlignment="Center"
                                                        ToolTip="Lägger tillbaka hela slängningen i grafen, där den stod" />
                                                <Border DockPanel.Dock="Right" Height="24" CornerRadius="12" Padding="9,0"
                                                        Margin="0,0,10,0" Background="{StaticResource Brush.WatchTint}"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Bevakningen fortsätter medan det ligger i soptunnan"
                                                        Visibility="{Binding IsWatched, Converter={StaticResource Visible}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:GridIcon Size="13" Data="{StaticResource Icon.Eye}"
                                                                           Foreground="{StaticResource Brush.Watch}" Margin="0,0,6,0" />
                                                        <TextBlock Text="bevakas" FontSize="11.5" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Brush.Watch}" />
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.Text}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Meta}" FontSize="12" Margin="0,3,0,0"
                                                               Foreground="{StaticResource Brush.TextDim}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </ToggleButton>

                                        <!-- The tree, under a line, a step darker; rails and elbows join the rows. -->
                                        <Border x:Name="Tree" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border}"
                                                Background="{StaticResource Brush.TrashTree}" CornerRadius="0,0,12,12"
                                                Padding="8,6,8,8">
                                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:TrashRowViewModel}">
                                                        <Border Style="{StaticResource Border.TrashRow}">
                                                            <Grid>
                                                                <ItemsControl ItemsSource="{Binding Rails}" Focusable="False"
                                                                              IsHitTestVisible="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <Grid />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Rectangle Width="1" HorizontalAlignment="Left"
                                                                                       Fill="{StaticResource Brush.BorderStrong}"
                                                                                       Margin="{Binding Converter={x:Static controls:LeftMarginConverter.Instance}}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Border x:Name="Elbow" Width="11" Height="19" HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top" BorderThickness="1,0,0,1"
                                                                        CornerRadius="0,0,0,7" BorderBrush="{StaticResource Brush.BorderStrong}"
                                                                        IsHitTestVisible="False"
                                                                        Margin="{Binding ElbowLeft, Converter={x:Static controls:LeftMarginConverter.Instance}}" />
                                                                <DockPanel Margin="{Binding TreePad, Converter={x:Static controls:LeftMarginConverter.Instance}}">
                                                                    <ContentPresenter x:Name="Shape" DockPanel.Dock="Left" Content="{Binding}"
                                                                                      ContentTemplate="{StaticResource Trash.KindTree}"
                                                                                      Margin="0,0,10,0" />
                                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.RoundBack}"
                                                                            Margin="8,0,6,0" VerticalAlignment="Center"
                                                                            Command="{Binding DataContext.RestoreCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}" ToolTip="{Binding RestoreToolTip}"
                                                                            AutomationProperties.Name="{Binding RestoreText}" />
                                                                    <TextBlock x:Name="Role" DockPanel.Dock="Right" Text="{Binding TrashRole}"
                                                                               FontSize="11.5" Foreground="{StaticResource Brush.TextFaint}"
                                                                               VerticalAlignment="Center" />
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="13"
                                                                                   Foreground="{StaticResource Brush.Text}" />
                                                                        <controls:GridIcon Size="14" Data="{StaticResource Icon.Eye}"
                                                                                           Foreground="{StaticResource Brush.Watch}"
                                                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                                                           ToolTip="Bevakas. Bevakningen fortsätter medan noden ligger i soptunnan."
                                                                                           Visibility="{Binding IsWatched, Converter={StaticResource Visible}}" />
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                                                                <Setter TargetName="Elbow" Property="Visibility" Value="Collapsed" />
                                                                <Setter TargetName="Role" Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsRoot}" Value="False">
                                                                <Setter TargetName="Shape" Property="Opacity" Value="0.85" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=Fold}" Value="True">
                                        <Setter TargetName="Tree" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=Fold}" Value="False">
                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasTree}" Value="False">
                                        <Setter TargetName="Tree" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Fold" Property="Cursor" Value="Arrow" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- The start page: piles and cases as tiles, like the nodes they were on it. -->
                <StackPanel Visibility="{Binding HasCases, Converter={StaticResource Visible}}">
                    <DockPanel Height="28" Margin="0,8,0,18" ToolTip="{x:Static vm:TrashViewModel.CasesText}">
                        <TextBlock Text="{x:Static vm:TrashViewModel.CasesTitle}" Style="{StaticResource Text.TrashSection}" />
                        <TextBlock FontSize="12" Foreground="{StaticResource Brush.TextDim}" Margin="10,0,10,0"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding CasesCount, Mode=OneWay}" /><Run Text=" · filerna ligger kvar" />
                        </TextBlock>
                        <Rectangle Height="1" Fill="{StaticResource Brush.Border}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Piles}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TrashPileRow}">
                                <!-- A pile: two cards behind the tile, a little higher and narrower each. -->
                                <Grid Margin="0,0,10,10">
                                    <Border Height="72" Margin="12,-8,12,8" CornerRadius="11" BorderThickness="1"
                                            BorderBrush="{StaticResource Brush.TrashTree}" Background="{StaticResource Brush.Underlay}"
                                            VerticalAlignment="Top" />
                                    <Border Height="72" Margin="6,-4,6,4" CornerRadius="11" BorderThickness="1"
                                            BorderBrush="{StaticResource Brush.Border}" Background="{StaticResource Brush.TrashTree}"
                                            VerticalAlignment="Top" />
                                    <Border Style="{StaticResource Border.TrashTile}" ToolTip="{Binding CasesToolTip}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" BorderThickness="1.5"
                                                    BorderBrush="{StaticResource Brush.BorderHover}" Margin="0,0,12,0">
                                                <controls:GridIcon Size="16" Data="{StaticResource Icon.Layers}"
                                                                   Foreground="{StaticResource Brush.TextLight}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.RoundBack}"
                                                    Command="{Binding DataContext.RestorePileCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Center"
                                                    ToolTip="Lägger tillbaka högen med alla ärenden i den på startsidan"
                                                    AutomationProperties.Name="Lägg tillbaka högen" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Meta}" FontSize="11.5" Margin="0,3,0,0"
                                                           Foreground="{StaticResource Brush.TextDim}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Cases}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TrashCaseRow}">
                                <Grid Margin="0,0,10,10">
                                    <Border Style="{StaticResource Border.TrashTile}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" BorderThickness="1.5"
                                                    BorderBrush="{StaticResource Brush.BorderHover}" Margin="0,0,12,0">
                                                <controls:GridIcon Size="16" Data="{StaticResource Icon.Folder}"
                                                                   Foreground="{StaticResource Brush.TextLight}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.RoundBack}"
                                                    Command="{Binding DataContext.RestoreCaseCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Center"
                                                    ToolTip="Lägger tillbaka ärendet på startsidan"
                                                    AutomationProperties.Name="Lägg tillbaka ärendet" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CaseNumber}" FontSize="13.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11.5" Margin="0,3,0,0" Foreground="{StaticResource Brush.TextDim}">
                                                    <Run Text="slängt " /><Run Text="{Binding When, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
