<UserControl x:Class="Chainsaw.App.Views.TrashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:TrashViewModel}"
             mc:Ignorable="d" Background="{StaticResource Brush.Background}">

    <!--
      The trash's own view (sketch SO1a), opened by a click on the bin: the head with how many throws and how many are
      hidden in the graph, and that nothing leaves the case; then per throw a line (when, who, how many, Lägg tillbaka
      allt) and its indented tree with Lägg tillbaka on each row (the row and what hangs under it); and the cases thrown
      on the start page. Only wiring; what happens lives in TrashViewModel.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TrashTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />

            <!-- A row of the tree: a light hover, and its Lägg tillbaka comes up from faint. -->
            <Style x:Key="Row" TargetType="Border">
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8,0,6,0" />
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Button.RowBack" TargetType="Button" BasedOn="{StaticResource Button.TrashQuiet}">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="Opacity" Value="0.55" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                                 Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="BackLabel">
                <StackPanel Orientation="Horizontal">
                    <controls:GridIcon Size="12" Data="{StaticResource Icon.Undo}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Margin="0,0,6,0" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="100,18,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The head: the count, and that nothing leaves the case. -->
        <DockPanel Height="30">
            <TextBlock Text="{Binding HeadText}" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.TextFaint}" Margin="0,0,6,0"
                         VerticalAlignment="Center" />
                <TextBlock Text="{x:Static vm:TrashViewModel.NothingRemovedText}" FontSize="12.5"
                           Foreground="{StaticResource Brush.TextDim}" />
                <Button Style="{StaticResource Button.Icon}" Margin="16,0,0,0" Command="{Binding CloseCommand}"
                        ToolTip="Tillbaka till grafen · Esc" AutomationProperties.Name="Stäng soptunnan">
                    <controls:GridIcon Size="16" Data="{StaticResource Icon.Close}" />
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Nothing in the trash: a large dashed ring with the icon, and how to throw. -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60"
                    Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
            <Grid Width="76" Height="76" HorizontalAlignment="Center">
                <Ellipse Stroke="{StaticResource Brush.BorderStrong}" StrokeThickness="1.5" StrokeDashArray="3 3" />
                <controls:GridIcon Size="30" Data="{StaticResource Icon.Trash}" Foreground="{StaticResource Brush.TextFaint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{x:Static vm:TrashViewModel.EmptyTitle}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,12,0,0" />
            <TextBlock Text="{x:Static vm:TrashViewModel.EmptyText}" FontSize="12.5"
                       Foreground="{StaticResource Brush.TextFaint}" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,14,0,0"
                      Visibility="{Binding IsEmpty, Converter={x:Static controls:InvertVisibility.Instance}}">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                <!-- One throw: its line, then its tree. -->
                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TrashThrowGroup}">
                            <StackPanel Margin="0,0,0,14">
                                <Border Height="40" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <controls:GridIcon Size="14" Data="{StaticResource Icon.Trash}"
                                                           Foreground="{StaticResource Brush.TextDim}" Margin="0,0,10,0"
                                                           VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.TrashQuiet}"
                                                Command="{Binding DataContext.RestoreAllCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Content="Lägg tillbaka allt"
                                                ContentTemplate="{StaticResource BackLabel}" VerticalAlignment="Center"
                                                ToolTip="Lägger tillbaka hela slängningen i grafen, där den stod" />
                                        <TextBlock FontSize="12.5" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.TextDim}">
                                            <Run Text="{Binding When, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}" />
                                            <Run Text=" · " /><Run Text="{Binding By, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding Count, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TrashRowViewModel}">
                                            <Border Style="{StaticResource Row}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="{Binding Indent}" />
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Width="18"
                                                               Style="{StaticResource Text.TrashGlyph}" FontSize="13" />
                                                    <ContentPresenter DockPanel.Dock="Left" Content="{Binding}"
                                                                      ContentTemplate="{StaticResource Trash.Kind}"
                                                                      Margin="2,0,8,0" />
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.RowBack}"
                                                            Command="{Binding DataContext.RestoreCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Content="{Binding RestoreText}"
                                                            ContentTemplate="{StaticResource BackLabel}"
                                                            ToolTip="{Binding RestoreToolTip}" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="13" />
                                                        <TextBlock Text="{Binding TrashRole}" FontSize="11.5" Margin="8,0,0,0"
                                                                   Foreground="{StaticResource Brush.TextFaint}"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0"
                                                                    Visibility="{Binding IsWatched, Converter={StaticResource Visible}}"
                                                                    ToolTip="Bevakningen fortsätter medan noden ligger i soptunnan">
                                                            <controls:GridIcon Size="13" Data="{StaticResource Icon.Eye}"
                                                                               Foreground="{StaticResource Brush.Watch}"
                                                                               Margin="0,0,4,0" />
                                                            <TextBlock Text="bevakas" FontSize="11.5" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Brush.TextDim}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The cases thrown on the start page, which lie on this computer. -->
                <StackPanel Visibility="{Binding HasCases, Converter={StaticResource Visible}}" Margin="0,4,0,0">
                    <Border Height="40" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <controls:GridIcon Size="14" Data="{StaticResource Icon.Folder}"
                                               Foreground="{StaticResource Brush.TextDim}" Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.TrashQuiet}"
                                    Command="{Binding RestoreAllCasesCommand}" Content="Lägg tillbaka allt"
                                    ContentTemplate="{StaticResource BackLabel}" VerticalAlignment="Center"
                                    ToolTip="Lägger tillbaka alla ärenden på startsidan" />
                            <TextBlock FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextDim}">
                                <Run Text="{x:Static vm:TrashViewModel.CasesTitle}" Foreground="{StaticResource Brush.TextMuted}" />
                                <Run Text=" · " /><Run Text="{x:Static vm:TrashViewModel.CasesText}" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Cases}" Focusable="False" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TrashCaseRow}">
                                <Border Style="{StaticResource Row}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.RowBack}"
                                                Command="{Binding DataContext.RestoreCaseCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Content="Lägg tillbaka"
                                                ContentTemplate="{StaticResource BackLabel}" VerticalAlignment="Center"
                                                ToolTip="Lägger tillbaka ärendet på startsidan" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CaseNumber}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding When}" FontSize="11.5" Margin="10,0,0,0"
                                                       Foreground="{StaticResource Brush.TextFaint}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
