<UserControl x:Class="Chainsaw.App.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:graph="clr-namespace:Chainsaw.App.Graph"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:views="clr-namespace:Chainsaw.App.Views"
             xmlns:contracts="clr-namespace:Chainsaw.Modules.Tracing.Contracts;assembly=Chainsaw.Modules.Tracing.Contracts">

    <!--
      The graph (sketch GR4) inside the shell (SH1b): the surface with the switch, the method and the amounts in its top
      corner, the legend's ? in its bottom corner and the inspector to the right. The page has no header of its own.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A sort in the legend: its icon in its frame, and its name. -->
        <DataTemplate x:Key="LegendSort" DataType="{x:Type graph:SortLook}">
            <StackPanel Margin="0,0,0,10" Width="72">
                <Border x:Name="Frame" Width="26" Height="26" CornerRadius="7" BorderThickness="1.5" HorizontalAlignment="Center"
                        BorderBrush="{Binding Ink, Converter={x:Static controls:GraphInkConverter.Instance}}">
                    <controls:GridIcon Size="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Ink, Converter={x:Static controls:GraphInkConverter.Instance}}"
                                       Data="{Binding Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                </Border>
                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                           HorizontalAlignment="Center" Margin="0,5,0,0" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Shape}" Value="{x:Static graph:NodeShape.Round}">
                    <Setter TargetName="Frame" Property="CornerRadius" Value="13" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A mark in the legend: its disc and what it means. -->
        <DataTemplate x:Key="LegendBadge" DataType="{x:Type graph:BadgeLook}">
            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                <Border Width="18" Height="18" CornerRadius="9"
                        Background="{Binding Ink, Converter={x:Static controls:GraphInkConverter.Instance}}">
                    <controls:GridIcon Size="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Background}"
                                       Data="{Binding Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                </Border>
                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                           VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <!-- The checks and suggestions (sketch KF1a) where the inspector stands. -->
        <KeyBinding Key="J" Modifiers="Control" Command="{Binding Checks.ToggleCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="InspectorColumn" Width="280" />
        </Grid.ColumnDefinitions>

        <!-- ===== The surface ===== -->
        <Grid Grid.Column="0">
            <controls:GraphCanvas x:Name="Canvas" AutomationProperties.Name="Grafen" />

            <!-- In place of the graph: no case, no start point, reading or failed; never made-up data. -->
            <TextBlock Text="{Binding EmptyText}" FontSize="13" Foreground="{StaticResource Brush.TextDim}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0,40,80"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" IsHitTestVisible="False" />

            <!-- What was traced and how, and what the last step said: top left, beside the pill's column. -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="84,14,0,0" MaxWidth="520"
                        IsHitTestVisible="False">
                <TextBlock Text="{Binding TraceText}" FontSize="12" Foreground="{StaticResource Brush.TextDim}" />
                <TextBlock Text="{Binding Notice}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <!-- The graph's corner: the switch, the method (always shown) and the amounts on the lines. -->
            <StackPanel x:Name="Corner" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,12,16,0">
                <TextBlock Text="{Binding OfflineWord}" FontSize="12" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"
                           Margin="0,0,12,0" ToolTip="{Binding OfflineTip}"
                           Visibility="{Binding ShowsOffline, Converter={StaticResource Visible}}" />
                <!-- Förslag · N (sketch KF1a, Ctrl+J): the list of checks and suggestions where the inspector stands. -->
                <Button Style="{StaticResource Button.Graph}" Margin="0,0,10,0" Command="{Binding Checks.ToggleCommand}"
                        ToolTip="Kontroller och förslag · Ctrl+J" AutomationProperties.Name="Kontroller och förslag">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Stroke="{StaticResource Brush.Accent}" StrokeDashArray="2 1.5"
                                 VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding Checks.ButtonText}" />
                    </StackPanel>
                </Button>
                <!-- Områden i grafen (sketch KF1b): which sorts of areas are drawn behind the actors. -->
                <Grid Margin="0,0,10,0">
                    <Button Style="{StaticResource Button.Graph}" Command="{Binding Checks.ToggleMenuCommand}"
                            ToolTip="Områden i grafen. Z ritar en egen yta runt valda aktörer (Ctrl+klick)."
                            AutomationProperties.Name="Områden i grafen">
                        <StackPanel Orientation="Horizontal">
                            <controls:GridIcon Size="16" Data="{StaticResource Icon.Layers}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="{Binding Checks.AreaCountText}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Border Margin="0,36,0,0" Width="210" Padding="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                            CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}"
                            Background="{StaticResource Brush.Floating}"
                            Visibility="{Binding Checks.IsMenuOpen, Converter={StaticResource Visible}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.4" Color="Black" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Områden i grafen" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}"
                                       Margin="8,2,0,6" />
                            <ItemsControl ItemsSource="{Binding Checks.Sorts}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AreaSortItem}">
                                        <Button Style="{StaticResource Button.MenuItem}" Height="30" CommandParameter="{Binding Sort}"
                                                Command="{Binding DataContext.Checks.ToggleSortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <DockPanel>
                                                <Border x:Name="Box" DockPanel.Dock="Left" Width="14" Height="14" CornerRadius="3"
                                                        BorderThickness="1.2" BorderBrush="{StaticResource Brush.TextDim}" Margin="0,0,9,0">
                                                    <controls:GridIcon x:Name="Tick" Size="12" Data="{StaticResource Icon.Kind.Check}"
                                                                       Foreground="{StaticResource Brush.OnAccent}" Visibility="Hidden" />
                                                </Border>
                                                <Border DockPanel.Dock="Left" Width="14" Height="10" CornerRadius="3" Margin="0,0,9,0"
                                                        BorderThickness="1" Opacity="0.7"
                                                        BorderBrush="{Binding TintKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="11.5"
                                                           Foreground="{StaticResource Brush.TextDim}" />
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                            </DockPanel>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsShown}" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}" />
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="FreeButton" ToolTip="Fri yta"
                                AutomationProperties.Name="Fri yta" CommandParameter="{x:Static contracts:GraphLayout.Free}"
                                Command="{Binding ShowLayoutCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Segment}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFree}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <controls:GridIcon Size="16"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Data="{StaticResource Icon.Layout.Free}" />
                        </Button>
                        <Button x:Name="HopsButton" ToolTip="Hoppkolumner"
                                AutomationProperties.Name="Hoppkolumner"
                                CommandParameter="{x:Static contracts:GraphLayout.HopColumns}"
                                Command="{Binding ShowLayoutCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Segment}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHopColumns}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <controls:GridIcon Size="16"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Data="{StaticResource Icon.Layout.Hops}" />
                        </Button>
                    </StackPanel>
                </Border>
                <!-- A click switches the method; a right click opens the Guide at the method (sketch GD1b). -->
                <Button Style="{StaticResource Button.Graph}" Content="{Binding MethodText}" ToolTip="{Binding MethodToolTip}"
                        Command="{Binding ToggleMethodCommand}" AutomationProperties.Name="Spårningsmetod" Margin="0,0,10,0">
                    <Button.InputBindings>
                        <MouseBinding Gesture="RightClick" Command="{Binding OpenMethodGuideCommand}" />
                    </Button.InputBindings>
                </Button>
                <Button Style="{StaticResource Button.Graph}" Content="{Binding LabelsText}" ToolTip="Belopp på linjerna"
                        Command="{Binding CycleLabelsCommand}" AutomationProperties.Name="Belopp på linjerna" />
            </StackPanel>

            <!-- The form for an own area (sketch KF1b): under the corner, while it is open. -->
            <views:AreaForm DataContext="{Binding Checks}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,56,16,0" Visibility="{Binding IsFormOpen, Converter={StaticResource Visible}}" />

            <!-- The visual language behind the ? (sketches GR3a and GR3c). -->
            <Button Style="{StaticResource Button.Help}" Content="?" FontSize="13" HorizontalAlignment="Left"
                    VerticalAlignment="Bottom" Margin="18,0,0,18" AutomationProperties.Name="Bildspråket"
                    ToolTip="Bildspråket. I grafen: Esc väljer inget, E expanderar, F passar in, + och − zoomar."
                    Command="{Binding ToggleLegendCommand}" />
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,56" Width="420" Padding="14"
                    CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}"
                    Background="{StaticResource Brush.Floating}"
                    Visibility="{Binding IsLegendOpen, Converter={StaticResource Visible}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="12" Direction="270" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding LegendSorts}" ItemTemplate="{StaticResource LegendSort}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding LegendBadges}" ItemTemplate="{StaticResource LegendBadge}" Focusable="False"
                                  Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <!-- The lines: thickness is the amount, style is certainty. -->
                    <WrapPanel Margin="0,6,0,0">
                        <WrapPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                <Setter Property="Margin" Value="6,0,0,0" />
                            </Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Orientation" Value="Horizontal" />
                                <Setter Property="Margin" Value="0,0,14,6" />
                            </Style>
                        </WrapPanel.Resources>
                        <StackPanel>
                            <Line X1="0" X2="34" Y1="8" Y2="8" StrokeThickness="4" Stroke="{StaticResource Brush.Accent}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="Spårat, tjock = stort" />
                        </StackPanel>
                        <StackPanel>
                            <Line X1="0" X2="34" Y1="8" Y2="8" StrokeThickness="1.1"
                                  Stroke="{StaticResource Brush.Graph.Untraced}" />
                            <TextBlock Text="Inte spårat" />
                        </StackPanel>
                        <StackPanel>
                            <Line X1="0" X2="34" Y1="8" Y2="8" StrokeThickness="1.6" Stroke="{StaticResource Brush.Accent}"
                                  StrokeDashArray="1.2 3" StrokeDashCap="Round" />
                            <TextBlock Text="Streckat = osäkert" />
                        </StackPanel>
                        <StackPanel>
                            <Line X1="0" X2="34" Y1="8" Y2="8" StrokeThickness="1.6" StrokeDashArray="4 3"
                                  Stroke="{StaticResource Brush.Kind.OtherChain}" />
                            <TextBlock Text="Annan kedja" />
                        </StackPanel>
                        <StackPanel>
                            <Path Data="M0 14 C6 -2 28 -2 34 14" StrokeThickness="1.1"
                                  Stroke="{StaticResource Brush.Graph.Untraced}" />
                            <TextBlock Text="Pengar som vänder" />
                        </StackPanel>
                    </WrapPanel>
                    <Button Style="{StaticResource Button.Link}" Content="Guiden: Grafen och bildspråket" Margin="0,4,0,0"
                            CommandParameter="{x:Static graph:GuideTopic.Graph}" Command="{Binding OpenGuideTopicCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== The inspector (sketch GR4): what is chosen, its facts, Varför? and the Guide ===== -->
        <Border Grid.Column="1" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1,0,0,0">
            <Grid>
                <TextBlock Text="Välj en aktör eller en linje." FontSize="13" Foreground="{StaticResource Brush.TextDim}"
                           Margin="18" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasInspection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                              Visibility="{Binding HasInspection, Converter={StaticResource Visible}}">
                    <StackPanel Margin="18" DataContext="{Binding Inspection}">
                        <DockPanel>
                            <Border x:Name="HeadFrame" Width="30" Height="30" BorderThickness="1.5" DockPanel.Dock="Left"
                                    BorderBrush="{Binding Ink, Converter={x:Static controls:GraphInkConverter.Instance}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Shape}" Value="{x:Static graph:NodeShape.Round}">
                                                <Setter Property="CornerRadius" Value="15" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <controls:GridIcon Size="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Ink, Converter={x:Static controls:GraphInkConverter.Instance}}"
                                                   Data="{Binding Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Margin="10,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        </DockPanel>

                        <!-- The start point (sketch GR5): the flag under the heading; the node keeps its own sort. -->
                        <Border HorizontalAlignment="Left" Height="24" CornerRadius="12" Padding="6,0,9,0" Margin="0,10,0,0"
                                Background="{StaticResource Brush.SurfaceRaised}"
                                Visibility="{Binding IsStartPoint, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <controls:GridIcon Size="13" VerticalAlignment="Center" Data="{StaticResource Icon.Flag}"
                                                   Foreground="{StaticResource Brush.Mark.Start}" />
                                <TextBlock Text="Startpunkt" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextMuted}" />
                            </StackPanel>
                        </Border>

                        <!-- The tabs (sketch AN1b): Fakta and Historik, with the number of events. -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                    DataContext="{Binding DataContext.History, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding HasNode, Converter={StaticResource Visible}}">
                            <Button Command="{Binding ShowFactsCommand}" AutomationProperties.Name="Fakta">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Tab}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFactsShown}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Fakta" />
                            </Button>
                            <Button Command="{Binding ShowHistoryCommand}" AutomationProperties.Name="Historik"
                                    ToolTip="Det som hänt med noden, i tidsordning">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Tab}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShown}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Historik" />
                                    <TextBlock Text="{Binding CountText}" Margin="6,0,0,0" Foreground="{StaticResource Brush.TextDim}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- The history (sketch AN1b), in place of the facts while its tab is chosen. -->
                        <views:InspectorHistoryView
                            DataContext="{Binding DataContext.History, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Visibility="{Binding IsShown, Converter={StaticResource Visible}}" />

                        <StackPanel Visibility="{Binding DataContext.History.IsFactsShown, Converter={StaticResource Visible},
                                                         RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ItemsControl ItemsSource="{Binding Facts}" Focusable="False" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type graph:InspectorFact}">
                                    <StackPanel Margin="0,0,12,10">
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}" />
                                        <TextBlock Text="{Binding Value}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Här (sketch KF1a): the checks and suggestions that concern the chosen actor. -->
                        <ItemsControl Focusable="False" Margin="0,0,0,10"
                                      ItemsSource="{Binding DataContext.Checks.Here, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HereLine}">
                                    <DockPanel Margin="0,0,0,5">
                                        <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0">
                                            <Ellipse x:Name="Ring" StrokeThickness="1.1"
                                                     Stroke="{Binding Look.TintKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                                            <controls:GridIcon Size="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{Binding Look.TintKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}"
                                                               Data="{Binding Look.Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontSize="11"
                                                   Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                            <Setter TargetName="Ring" Property="StrokeDashArray" Value="2.5 2" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The forms (sketch IN1a): Etikett (L), Bryt upp (U) and Annan kedja (K), folded out here. -->
                        <views:InspectorFormsView
                            DataContext="{Binding DataContext.Forms, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                        <!-- Expanding: one step through Tracing and Chains, never on the UI thread. -->
                        <Button Style="{StaticResource Button.Secondary}" Height="34" Margin="0,4,0,0"
                                Content="{Binding DataContext.ExpandText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Command="{Binding DataContext.ExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                IsEnabled="{Binding DataContext.CanExpand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding CanExpand, Converter={StaticResource Visible}}"
                                ToolTip="Hämta ett steg till härifrån (E)" />

                        <!-- Addresses, txids and blocks in full, so that every step can be checked against the chain. -->
                        <ItemsControl ItemsSource="{Binding Details}" Focusable="False" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             Foreground="{StaticResource Brush.TextMuted}" FontFamily="{StaticResource Font.Mono}"
                                             FontSize="11" TextWrapping="Wrap" Padding="0" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Varför? opens the Guide beside the graph with the answers on top (sketch GD1b). -->
                        <Button Style="{StaticResource Button.Link}" Content="Varför?" Margin="0,10,0,0"
                                Command="{Binding DataContext.AskWhyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                AutomationProperties.Name="Varför?" ToolTip="Förklaringen i Guiden, bredvid grafen" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- The checks and suggestions (sketch KF1a) fold out where the inspector stands, over it. -->
                <views:ChecksPanel DataContext="{Binding Checks}"
                                   Visibility="{Binding IsOpen, Converter={StaticResource Visible}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
