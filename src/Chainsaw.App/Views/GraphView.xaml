<UserControl x:Class="Chainsaw.App.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:graph="clr-namespace:Chainsaw.App.Graph"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:views="clr-namespace:Chainsaw.App.Views"
             xmlns:contracts="clr-namespace:Chainsaw.Modules.Tracing.Contracts;assembly=Chainsaw.Modules.Tracing.Contracts">

    <!--
      The graph (sketch GR4) inside the shell (SH1b): the surface with the switch, the method and the amounts in its top
      corner, the legend's ? in its bottom corner and the inspector to the right. The page has no header of its own.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!--
          An action over the chosen node (sketch IN2b): a 34 px square with the icon at 18 px; Expandera, the main one, in
          the accent. Never holds the keyboard, so that E, L, B, U and K go on working in the graph.
        -->
        <Style x:Key="Button.NodeTool" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderThickness="1.5" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="Tag" Value="{x:Null}" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                </MultiTrigger>
                <Trigger Property="Tag" Value="On">
                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                </Trigger>
                <Trigger Property="Tag" Value="Main">
                    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!--
          A pick in the selection view (sketch EX2): a quiet chip, 28 px, lit with a lighter frame when on. It never takes
          the keyboard, so that Esc, Enter and L go on working in the view.
        -->
        <Style x:Key="Toggle.Pick" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A smaller pick in the filter panel (sketch EX2: the window's ±48 h, ±7 d, Allt and the groups): 24 px. -->
        <Style x:Key="Toggle.Small" TargetType="ToggleButton" BasedOn="{StaticResource Toggle.Pick}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <!-- A third of the direction's segment (sketch EX2: In, Ut, Alla), framed by its row. -->
        <Style x:Key="Toggle.Third" TargetType="ToggleButton" BasedOn="{StaticResource Toggle.Pick}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A small switch in the filter panel (sketch EX2): 28 × 16, grey, the knob to the right when on. -->
        <Style x:Key="Toggle.Mini" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <DockPanel Background="Transparent">
                            <Border x:Name="Track" DockPanel.Dock="Left" Width="28" Height="16" CornerRadius="8"
                                    Background="{StaticResource Brush.BorderStrong}" Margin="0,0,10,0">
                                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{StaticResource Brush.Text}"
                                         HorizontalAlignment="Left" Margin="2,0,0,0" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.TextDim}" />
                                <Setter TargetName="Knob" Property="Margin" Value="14,0,0,0" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A word button in the selection view's bar (sketch EX2: Avbryt · Esc, Plocka ut · Enter). -->
        <Style x:Key="Button.Bar" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plocka ut: the accent with cream on it when something is chosen, quiet and unusable otherwise. -->
        <Style x:Key="Button.Take" TargetType="Button" BasedOn="{StaticResource Button.Bar}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.SurfaceSelected}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <!-- The checks and suggestions (sketch KF2b) where the inspector stands; Ctrl+Z takes back the last decision. -->
        <KeyBinding Key="J" Modifiers="Control" Command="{Binding Checks.ToggleCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding Checks.UndoCommand}" />
    </UserControl.InputBindings>

    <!-- The page clips at its edges, so that the inspector's shadow never reaches up over the title bar. -->
    <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="InspectorColumn" Width="280" />
        </Grid.ColumnDefinitions>

        <!-- ===== The surface ===== -->
        <Grid Grid.Column="0">
            <controls:GraphCanvas x:Name="Canvas" AutomationProperties.Name="Grafen" />

            <!--
              The selection view's chrome (sketch EX2) over the canvas, which draws the dots: the line at the top, the
              modes and the picks in the top right corner, the filter panel at the left beside the pill, and the bar at
              the bottom with what is chosen, Avbryt · Esc and Plocka ut · Enter.
            -->
            <Grid x:Name="HeldBackChrome" DataContext="{Binding HeldBack}"
                  Visibility="{Binding DataContext.HasHeldBack, ElementName=Canvas, Converter={StaticResource Visible}}"
                  IsVisibleChanged="OnHeldBackShown">
                <TextBlock Text="{Binding HeaderText}" FontSize="12" Foreground="{StaticResource Brush.TextDim}"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="372,18,0,0" IsHitTestVisible="False" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0">
                    <controls:PickButton Style="{StaticResource Toggle.Pick}" Content="Spiral" Margin="0,0,6,0"
                                  ToolTip="Tx:erna på en spiral från adressen" IsChecked="{Binding IsSpiral, Mode=OneWay}"
                                  Command="{Binding ShowSpiralCommand}" />
                    <controls:PickButton Style="{StaticResource Toggle.Pick}" Content="Tidsbåge"
                                  ToolTip="Vinkeln är tiden, avståndet beloppet" IsChecked="{Binding IsTimeArc, Mode=OneWay}"
                                  Command="{Binding ShowTimeArcCommand}" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsSpiral, Converter={StaticResource Visible}}">
                        <Rectangle Width="1" Height="18" Margin="9,0" Fill="{StaticResource Brush.BorderStrong}" />
                        <controls:PickButton Style="{StaticResource Toggle.Pick}" Content="Tid" Margin="0,0,6,0" ToolTip="Nyast innerst"
                                      IsChecked="{Binding IsByTime, Mode=OneWay}" Command="{Binding ByTimeCommand}" />
                        <controls:PickButton Style="{StaticResource Toggle.Pick}" Content="Belopp" ToolTip="Störst innerst"
                                      IsChecked="{Binding IsByAmount, Mode=OneWay}" Command="{Binding ByAmountCommand}" />
                    </StackPanel>
                    <Rectangle Width="1" Height="18" Margin="9,0" Fill="{StaticResource Brush.BorderStrong}" />
                    <controls:PickButton Style="{StaticResource Toggle.Pick}" Content="Klick" Margin="0,0,6,0"
                                  ToolTip="Klick väljer, Shift-klick väljer ett intervall"
                                  IsChecked="{Binding IsClick, Mode=OneWay}" Command="{Binding UseClickCommand}" />
                    <controls:PickButton Style="{StaticResource Toggle.Pick}" Content="Lasso · L" ToolTip="Dra en ring runt det du vill ha"
                                  IsChecked="{Binding IsLasso, Mode=OneWay}" Command="{Binding UseLassoCommand}" />
                    <Rectangle Width="1" Height="18" Margin="9,0" Fill="{StaticResource Brush.BorderStrong}" />
                    <controls:PickButton Style="{StaticResource Toggle.Pick}" Content="Största 10" Margin="0,0,6,0"
                                  ToolTip="De tio största som visas" Command="{Binding ChooseLargestCommand}" />
                    <controls:PickButton Style="{StaticResource Toggle.Pick}" Margin="0,0,6,0" ToolTip="Alla som pulserar"
                                  Command="{Binding ChoosePulsingCommand}"
                                  Visibility="{Binding HasPulsing, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Error}" Margin="0,0,6,0" />
                            <TextBlock Text="Välj pulserande" />
                        </StackPanel>
                    </controls:PickButton>
                    <controls:PickButton Style="{StaticResource Toggle.Pick}" Content="Rensa"
                                  Command="{Binding ClearChoiceCommand}"
                                  Visibility="{Binding HasSelection, Converter={StaticResource Visible}}" />
                </StackPanel>

                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="84,52,0,0" Width="268"
                        Padding="16,14,16,16" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{StaticResource Brush.Border}" Background="{StaticResource Brush.Surface}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.4" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="Filter" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Återställ" FontSize="11.5"
                                    Foreground="{StaticResource Brush.TextDim}" Focusable="False" Command="{Binding ResetCommand}" />
                            <TextBlock Text="{Binding FilterCountText}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                                       Margin="8,0,0,0" VerticalAlignment="Bottom" />
                        </DockPanel>

                        <DockPanel Margin="0,0,0,7">
                            <TextBlock Text="Belopp" FontSize="12" Foreground="{StaticResource Brush.TextDim}" />
                            <TextBlock Text="{Binding AmountText}" FontSize="12" Foreground="{StaticResource Brush.Text}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                        <controls:HistogramTrack Kind="Range" Height="44" BarWidth="8" Margin="0,0,0,14"
                                                 Bars="{Binding AmountBars}" Low="{Binding Low}" High="{Binding High}" />

                        <TextBlock Text="Riktning" FontSize="12" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,7" />
                        <Border BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}" CornerRadius="6"
                                Margin="0,0,0,14" ClipToBounds="True">
                            <UniformGrid Columns="3">
                                <controls:PickButton Style="{StaticResource Toggle.Third}" Content="In"
                                              IsChecked="{Binding IsIn, Mode=OneWay}" Command="{Binding ShowInCommand}" />
                                <controls:PickButton Style="{StaticResource Toggle.Third}" Content="Ut"
                                              IsChecked="{Binding IsOut, Mode=OneWay}" Command="{Binding ShowOutCommand}" />
                                <controls:PickButton Style="{StaticResource Toggle.Third}" Content="Alla"
                                              IsChecked="{Binding IsAll, Mode=OneWay}" Command="{Binding ShowAllCommand}" />
                            </UniformGrid>
                        </Border>

                        <DockPanel Margin="0,0,0,7">
                            <TextBlock Text="Tid" FontSize="12" Foreground="{StaticResource Brush.TextDim}" />
                            <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{StaticResource Brush.Text}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                        <controls:HistogramTrack x:Name="TimeTrack" Kind="Window" Height="36" BarWidth="5" Margin="0,0,0,7"
                                                 Cursor="Hand" ToolTip="Dra fönstret längs tiden"
                                                 Bars="{Binding TimeBars}" Low="{Binding WindowStart, Mode=OneWay}"
                                                 High="{Binding WindowEnd, Mode=OneWay}" Marker="{Binding ArrivalShare}"
                                                 WindowMoved="OnTimeWindowMoved" />
                        <WrapPanel Margin="0,0,0,8">
                            <controls:PickButton Style="{StaticResource Toggle.Small}" Content="±48 h"
                                          IsChecked="{Binding IsTwoDays, Mode=OneWay}" Command="{Binding TwoDaysWindowCommand}" />
                            <controls:PickButton Style="{StaticResource Toggle.Small}" Content="±7 d"
                                          IsChecked="{Binding IsOneWeek, Mode=OneWay}" Command="{Binding OneWeekWindowCommand}" />
                            <controls:PickButton Style="{StaticResource Toggle.Small}" Content="Allt"
                                          IsChecked="{Binding IsWholeTime, Mode=OneWay}" Command="{Binding WholeTimeCommand}" />
                        </WrapPanel>

                        <TextBlock Text="Motpart" FontSize="12" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,7" />
                        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GroupChip}">
                                    <controls:PickButton Style="{StaticResource Toggle.Small}" IsChecked="{Binding IsOn, Mode=OneWay}"
                                                  Command="{Binding ToggleCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,6,0"
                                                     Fill="{Binding Ink, Converter={x:Static controls:GraphInkConverter.Instance}}" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </controls:PickButton>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsOn}" Value="False">
                                            <Setter TargetName="Dot" Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ToggleButton Style="{StaticResource Toggle.Mini}" Content="Dölj damm"
                                      ToolTip="Under 0,0001 BTC, ofta adressförgiftning" IsChecked="{Binding HideDust}" />
                        <ToggleButton Style="{StaticResource Toggle.Mini}" Content="Bara de som inte finns i grafen"
                                      ToolTip="Döljer motparter som redan är noder" IsChecked="{Binding OnlyNotInGraph}" />
                        <ToggleButton Style="{StaticResource Toggle.Mini}" Content="Gruppera per motpart" Margin="0"
                                      ToolTip="En prick per motpart, med antalet tx" IsChecked="{Binding GroupByCounterparty}" />

                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border}" Margin="0,14,0,0"
                                Padding="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Markeringar" FontSize="11.5" Foreground="{StaticResource Brush.TextFaint}"
                                           Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Ellipse Width="10" Height="10" Stroke="{StaticResource Brush.Error}" StrokeThickness="1.5"
                                             Margin="0,0,8,0" />
                                    <TextBlock Text="Sonar: negativ etikett" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Ellipse Width="10" Height="10" Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.5"
                                             Margin="0,0,8,0" />
                                    <TextBlock Text="Sonar: nära det spårade beloppet" FontSize="11.5"
                                               Foreground="{StaticResource Brush.TextDim}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Ellipse Width="7" Height="7" Stroke="{StaticResource Brush.Text}" StrokeThickness="1.5"
                                             Margin="1.5,0,9.5,0" />
                                    <TextBlock Text="Finns redan i grafen" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="6" Height="6" Fill="{StaticResource Brush.TextMuted}" Margin="2,0,10,0">
                                        <Rectangle.LayoutTransform>
                                            <RotateTransform Angle="45" />
                                        </Rectangle.LayoutTransform>
                                    </Rectangle>
                                    <TextBlock Text="Etikett från ett annat ärende" FontSize="11.5"
                                               Foreground="{StaticResource Brush.TextDim}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Height="40"
                        Padding="14,0,6,0" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{StaticResource Brush.BorderStrong}" Background="{StaticResource Brush.SurfaceRaised}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CountText}" FontSize="13" Foreground="{StaticResource Brush.TextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Style="{StaticResource Button.Bar}" Content="Avbryt · Esc" Margin="0,0,10,0"
                                Command="{Binding CancelCommand}" />
                        <Button Style="{StaticResource Button.Take}" Content="{Binding TakeText}"
                                IsEnabled="{Binding HasSelection}" Command="{Binding TakeCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- In place of the graph while it is read or could not be; never made-up data. -->
            <TextBlock Text="{Binding EmptyText}" FontSize="14" Foreground="{StaticResource Brush.TextDim}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0,40,80"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" IsHitTestVisible="False"
                       Visibility="{Binding Start.IsShown, Converter={x:Static controls:InvertVisibility.Instance}}" />

            <!-- With no case, or no start point, the empty graph guides instead (sketch GR6c). -->
            <views:GraphStartView x:Name="StartView" DataContext="{Binding Start}"
                                  Visibility="{Binding IsShown, Converter={StaticResource Visible}}" />

            <!--
              The chosen node's actions as icons over it (sketch IN2b), only those that apply; under the node when there
              is no room above. The view keeps it at the node through pans, zooms and drags.
            -->
            <Grid x:Name="NodeTools" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Visibility="{Binding HasNodeTools, Converter={StaticResource Visible}}" SizeChanged="OnOverNodeSized">
                <Border CornerRadius="12" Background="{StaticResource Brush.SurfaceRaised}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="12" Padding="3" BorderThickness="1.5" BorderBrush="{StaticResource Brush.BorderStrong}"
                        Background="{StaticResource Brush.SurfaceRaised}">
                    <ItemsControl ItemsSource="{Binding NodeTools}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NodeMenuRow}">
                                <Button x:Name="Tool" Style="{StaticResource Button.NodeTool}" IsEnabled="{Binding IsEnabled}"
                                        AutomationProperties.Name="{Binding Label}" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.RunMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button.ToolTip>
                                        <TextBlock>
                                            <Run Text="{Binding Label, Mode=OneWay}" />
                                            <Run Text="{Binding Key, Mode=OneWay}" Foreground="{StaticResource Brush.TextDim}" />
                                        </TextBlock>
                                    </Button.ToolTip>
                                    <controls:GridIcon Size="18"
                                                       Data="{Binding Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Action}" Value="{x:Static vm:NodeMenuAction.Expand}">
                                        <Setter TargetName="Tool" Property="Tag" Value="Main" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <!--
              The open form (Etikett L, Bryt upp U, Annan kedja K) in a panel beside the node (sketch IN1b), to its right,
              or its left when there is no room, with a small arrow pointing at it.
            -->
            <Grid x:Name="NodeForm" HorizontalAlignment="Left" VerticalAlignment="Top" Width="316"
                  Visibility="{Binding Forms.IsOpen, Converter={StaticResource Visible}}" SizeChanged="OnOverNodeSized"
                  IsVisibleChanged="OnBesideNodeShown">
                <Border CornerRadius="12" Background="{StaticResource Brush.Floating}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="36" ShadowDepth="12" Direction="270" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="12" Padding="14" BorderThickness="1.5" BorderBrush="{StaticResource Brush.BorderStrong}"
                        Background="{StaticResource Brush.Floating}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <controls:GridIcon DockPanel.Dock="Left" Size="16" Foreground="{StaticResource Brush.Accent}"
                                               VerticalAlignment="Center"
                                               Data="{Binding Forms.FormIcon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Forms.FormKey}" FontSize="12"
                                       Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Forms.FormTitle}" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <views:InspectorFormsView DataContext="{Binding Forms}" />
                    </StackPanel>
                </Border>
                <Border x:Name="Caret" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="{StaticResource Brush.Floating}" BorderBrush="{StaticResource Brush.BorderStrong}"
                        BorderThickness="1.5,0,0,1.5" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <RotateTransform x:Name="CaretTurn" Angle="45" />
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <!-- What was traced and how: top left, beside the pill's column. -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="84,14,0,0" MaxWidth="520"
                        IsHitTestVisible="False">
                <TextBlock Text="{Binding TraceText}" FontSize="13" Foreground="{StaticResource Brush.TextDim}" />
                <!-- What the last step said goes to the toaster (sketch TO1a), not here. -->
            </StackPanel>

            <!-- The graph's corner: the switch, the method (always shown) and the amounts on the lines. -->
            <StackPanel x:Name="Corner" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,12,16,0" Visibility="{Binding ShowsCorner, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding OfflineWord}" FontSize="13" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"
                           Margin="0,0,12,0" ToolTip="{Binding OfflineTip}"
                           Visibility="{Binding ShowsOffline, Converter={StaticResource Visible}}" />
                <!--
                  The graph's corner as one row of icons (the user's wish 2026-11-07), as the actions over a node: the
                  checks and suggestions, the areas, the layout, the method (always shown) and the amounts on the lines.
                  A dot on an icon says that something is there; the words are in the tips.
                -->
                <Grid VerticalAlignment="Top">
                    <Border CornerRadius="12" Background="{StaticResource Brush.SurfaceRaised}" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" Color="Black" />
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="12" Padding="3" BorderThickness="1.5" BorderBrush="{StaticResource Brush.BorderStrong}"
                            Background="{StaticResource Brush.SurfaceRaised}">
                        <StackPanel Orientation="Horizontal">
                            <!--
                              Förslag · N (sketch KF2b, Ctrl+J): the panel where the inspector stands. The count of
                              suggestions that wait stands in an accent badge, and only when something waits.
                            -->
                            <Button Style="{StaticResource Button.NodeTool}" Width="Auto" Command="{Binding Checks.ToggleCommand}"
                                    ToolTip="{Binding Checks.ToolTipText}" AutomationProperties.Name="Kontroller och förslag">
                                <StackPanel Orientation="Horizontal" Margin="9,0,8,0">
                                    <controls:GridIcon Size="16" Data="{StaticResource Icon.Suggest}" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Förslag" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <Border MinWidth="18" Height="18" CornerRadius="9" Padding="5,0" Margin="8,0,0,0"
                                            Background="{StaticResource Brush.Accent}" VerticalAlignment="Center"
                                            Visibility="{Binding Checks.HasWaiting, Converter={StaticResource Visible}}">
                                        <TextBlock Text="{Binding Checks.WaitingText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.OnAccent}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <!-- Områden i grafen (sketch KF1b): which sorts of areas are drawn behind the actors. -->
                            <Grid>
                                <Button x:Name="AreasButton" Style="{StaticResource Button.NodeTool}"
                                        Command="{Binding Checks.ToggleMenuCommand}"
                                        IsHitTestVisible="{Binding IsOpen, ElementName=AreasMenu, Converter={x:Static controls:InvertConverter.Instance}}"
                                        ToolTip="Områden i grafen. Z ritar en egen yta runt valda aktörer (Ctrl+klick)."
                                        AutomationProperties.Name="Områden i grafen">
                                    <Grid>
                                        <controls:GridIcon Size="18" Data="{StaticResource Icon.Layers}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.TextMuted}"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"
                                                 Visibility="{Binding Checks.HasAreas, Converter={StaticResource Visible}}" />
                                    </Grid>
                                </Button>
                                <!--
                                  The menu hangs under the button in a popup of its own, so that it never stretches the corner's row,
                                  and a click anywhere else closes it.
                                -->
                                <Popup x:Name="AreasMenu" PlacementTarget="{Binding ElementName=AreasButton}" Placement="Bottom"
                                       VerticalOffset="6" AllowsTransparency="True" StaysOpen="False" Focusable="False"
                                       IsOpen="{Binding Checks.IsMenuOpen, Mode=OneWay}" Closed="OnAreasMenuClosed">
                                <Border Margin="16,0,16,24" Width="210" Padding="8"
                                        CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}"
                                        Background="{StaticResource Brush.Floating}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.4" Color="Black" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="Områden i grafen" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}"
                                                   Margin="8,2,0,6" />
                                        <ItemsControl ItemsSource="{Binding Checks.Sorts}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AreaSortItem}">
                                                    <Button Style="{StaticResource Button.MenuItem}" Height="30" CommandParameter="{Binding Sort}"
                                                            Command="{Binding DataContext.Checks.ToggleSortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <DockPanel>
                                                            <Border x:Name="Box" DockPanel.Dock="Left" Width="14" Height="14" CornerRadius="3"
                                                                    BorderThickness="1.2" BorderBrush="{StaticResource Brush.TextDim}" Margin="0,0,9,0">
                                                                <controls:GridIcon x:Name="Tick" Size="12" Data="{StaticResource Icon.Kind.Check}"
                                                                                   Foreground="{StaticResource Brush.OnAccent}" Visibility="Hidden" />
                                                            </Border>
                                                            <Border DockPanel.Dock="Left" Width="14" Height="10" CornerRadius="3" Margin="0,0,9,0"
                                                                    BorderThickness="1" Opacity="0.7"
                                                                    BorderBrush="{Binding TintKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="12.5"
                                                                       Foreground="{StaticResource Brush.TextDim}" />
                                                            <TextBlock Text="{Binding Name}" FontSize="13.5" />
                                                        </DockPanel>
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsShown}" Value="True">
                                                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}" />
                                                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                </Popup>
                            </Grid>
                            <Rectangle Width="1.5" Height="20" Margin="5,0" Fill="{StaticResource Brush.BorderStrong}" />
                            <Button x:Name="FreeButton" ToolTip="Fri yta" AutomationProperties.Name="Fri yta"
                                    CommandParameter="{x:Static contracts:GraphLayout.Free}" Command="{Binding ShowLayoutCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.NodeTool}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFree}" Value="True">
                                                <Setter Property="Tag" Value="On" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <controls:GridIcon Size="18" Data="{StaticResource Icon.Layout.Free}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button x:Name="HopsButton" ToolTip="Hoppkolumner" AutomationProperties.Name="Hoppkolumner"
                                    CommandParameter="{x:Static contracts:GraphLayout.HopColumns}" Command="{Binding ShowLayoutCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.NodeTool}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHopColumns}" Value="True">
                                                <Setter Property="Tag" Value="On" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <controls:GridIcon Size="18" Data="{StaticResource Icon.Layout.Hops}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Rectangle Width="1.5" Height="20" Margin="5,0" Fill="{StaticResource Brush.BorderStrong}" />
                            <!-- The method, always shown: a click switches it, a right click opens the Guide at it (GD1b). -->
                            <Button Style="{StaticResource Button.NodeTool}" Width="NaN" MinWidth="34"
                                    ToolTip="{Binding MethodToolTip}" Command="{Binding ToggleMethodCommand}"
                                    AutomationProperties.Name="Spårningsmetod">
                                <Button.InputBindings>
                                    <MouseBinding Gesture="RightClick" Command="{Binding OpenMethodGuideCommand}" />
                                </Button.InputBindings>
                                <TextBlock Text="{Binding MethodText}" FontSize="13" FontWeight="SemiBold" Margin="9,0" />
                            </Button>
                            <Button Style="{StaticResource Button.NodeTool}" ToolTip="{Binding LabelsToolTip}"
                                    Command="{Binding CycleLabelsCommand}" AutomationProperties.Name="Belopp på linjerna">
                                <controls:GridIcon Size="18" Data="{StaticResource Icon.Amounts}">
                                    <controls:GridIcon.Style>
                                        <Style TargetType="controls:GridIcon">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowsNoAmounts}" Value="True">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:GridIcon.Style>
                                </controls:GridIcon>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
            <!-- The form for an own area (sketch KF1b): under the corner, while it is open. -->
            <views:AreaForm DataContext="{Binding Checks}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,56,16,0" Visibility="{Binding IsFormOpen, Converter={StaticResource Visible}}" />

            <!--
              The watch form (sketch BV3a) in a panel beside the watched node, as the forms in IN1b, with an arrow at it;
              it glides in when it opens.
            -->
            <Grid x:Name="WatchPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Width="340"
                  Visibility="{Binding IsWatchFormOpen, Converter={StaticResource Visible}}" SizeChanged="OnOverNodeSized"
                  IsVisibleChanged="OnBesideNodeShown">
                <Border CornerRadius="14" Background="{StaticResource Brush.Floating}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                </Border>
                <views:WatchForm DataContext="{Binding WatchForm}" />
                <Border x:Name="WatchCaret" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="{StaticResource Brush.Floating}" BorderBrush="{StaticResource Brush.BorderStrong}"
                        BorderThickness="1.5,0,0,1.5" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <RotateTransform x:Name="WatchCaretTurn" Angle="45" />
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <!-- The node's menu (right click, sketch BV2a): the forms, Bevaka …, Expandera and Kopiera adress. -->
            <Border x:Name="NodeMenu" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Padding="5"
                    CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}"
                    Background="{StaticResource Brush.SurfaceRaised}"
                    Visibility="{Binding IsMenuOpen, Converter={StaticResource Visible}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <ItemsControl ItemsSource="{Binding MenuRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NodeMenuRow}">
                            <StackPanel>
                                <Border Height="1" Margin="6,4" Background="{StaticResource Brush.BorderStrong}"
                                        Visibility="{Binding HasGapBefore, Converter={StaticResource Visible}}" />
                                <Button Style="{StaticResource Button.MenuItem}" IsEnabled="{Binding IsEnabled}" Height="30"
                                        Command="{Binding DataContext.RunMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <DockPanel>
                                        <controls:GridIcon Size="16" Data="{Binding Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}"
                                                           Foreground="{StaticResource Brush.TextMuted}" DockPanel.Dock="Left" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Key}" FontSize="12" Foreground="{StaticResource Brush.TextDim}"
                                                   DockPanel.Dock="Right" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" FontSize="13.5" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!--
              The visual language behind the ? (sketch GR7a), in the lower right corner (sketch SO1a), where
              it never meets the pill at the left edge however low the window is. -->
            <Button Style="{StaticResource Button.Help}" HorizontalAlignment="Right"
                    Visibility="{Binding ShowsCorner, Converter={StaticResource Visible}}"
                    VerticalAlignment="Bottom" Margin="0,0,18,18" AutomationProperties.Name="Bildspråket"
                    ToolTip="Bildspråket. I grafen: Esc väljer inget, E expanderar, F passar in, + och − zoomar."
                    Command="{Binding ToggleLegendCommand}" />
            <views:GraphLegendView HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,64"
                                   Visibility="{Binding IsLegendOpen, Converter={StaticResource Visible}}" />
        </Grid>

        <!--
          The inspector's shadow over the graph, in a layer of its own as under the pill, so that the inspector's text is
          never drawn through the effect and stays sharp.
        -->
        <Border x:Name="InspectorShadow" Grid.Column="1" Background="{StaticResource Brush.Surface}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="180" Opacity="0.4" Color="Black" />
            </Border.Effect>
        </Border>

        <!-- ===== The inspector (sketch GR4): what is chosen, its facts, Varför? and the Guide ===== -->
        <Border x:Name="Inspector" Grid.Column="1" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1,0,0,0">
            <Grid>
                <TextBlock Text="Välj en aktör eller en linje." FontSize="14" Foreground="{StaticResource Brush.TextDim}"
                           Margin="18" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasInspection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                              Visibility="{Binding HasInspection, Converter={StaticResource Visible}}">
                    <StackPanel Margin="18" DataContext="{Binding Inspection}">
                        <DockPanel>
                            <!-- Varför? as a round icon in the heading's corner (sketch IN2b): the Guide's answers. -->
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Help}" Margin="8,0,0,0"
                                    VerticalAlignment="Center" AutomationProperties.Name="Varför?"
                                    ToolTip="Varför? Förklaringen i Guiden, bredvid grafen"
                                    Command="{Binding DataContext.AskWhyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Border x:Name="HeadFrame" Width="30" Height="30" BorderThickness="1.5" DockPanel.Dock="Left"
                                    BorderBrush="{Binding Ink, Converter={x:Static controls:GraphInkConverter.Instance}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Shape}" Value="{x:Static graph:NodeShape.Round}">
                                                <Setter Property="CornerRadius" Value="15" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <controls:GridIcon Size="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Ink, Converter={x:Static controls:GraphInkConverter.Instance}}"
                                                   Data="{Binding Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Margin="10,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        </DockPanel>

                        <!-- The start point (sketch GR5): the flag under the heading; the node keeps its own sort. -->
                        <Border HorizontalAlignment="Left" Height="24" CornerRadius="12" Padding="6,0,9,0" Margin="0,10,0,0"
                                Background="{StaticResource Brush.SurfaceRaised}"
                                Visibility="{Binding IsStartPoint, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <controls:GridIcon Size="13" VerticalAlignment="Center" Data="{StaticResource Icon.Flag}"
                                                   Foreground="{StaticResource Brush.Mark.Start}" />
                                <TextBlock Text="Startpunkt" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextMuted}" />
                            </StackPanel>
                        </Border>

                        <!-- The tabs (sketch AN1b): Fakta and Historik, with the number of events. -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                    DataContext="{Binding DataContext.History, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding HasNode, Converter={StaticResource Visible}}">
                            <Button Command="{Binding ShowFactsCommand}" AutomationProperties.Name="Fakta">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Tab}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFactsShown}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Fakta" />
                            </Button>
                            <Button Command="{Binding ShowHistoryCommand}" AutomationProperties.Name="Historik"
                                    ToolTip="Det som hänt med noden, i tidsordning">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Tab}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShown}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Historik" />
                                    <TextBlock Text="{Binding CountText}" Margin="6,0,0,0" Foreground="{StaticResource Brush.TextDim}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- The history (sketch AN1b), in place of the facts while its tab is chosen. -->
                        <views:InspectorHistoryView
                            DataContext="{Binding DataContext.History, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Visibility="{Binding IsShown, Converter={StaticResource Visible}}" />

                        <StackPanel Visibility="{Binding DataContext.History.IsFactsShown, Converter={StaticResource Visible},
                                                         RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ItemsControl ItemsSource="{Binding Facts}" Focusable="False" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type graph:InspectorFact}">
                                    <StackPanel Margin="0,0,12,10">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}" />
                                        <TextBlock Text="{Binding Value}" FontSize="13.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The balance per token (sketch TK1a): in, out and left, the issuer and the snowflake. -->
                        <StackPanel Visibility="{Binding HasBalances, Converter={StaticResource Visible}}" Margin="0,0,0,10">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Token" FontSize="12" Foreground="{StaticResource Brush.TextDim}" />
                                <TextBlock Grid.Column="1" Text="In" FontSize="12" TextAlignment="Right" Foreground="{StaticResource Brush.TextDim}" />
                                <TextBlock Grid.Column="2" Text="Ut" FontSize="12" TextAlignment="Right" Foreground="{StaticResource Brush.TextDim}" />
                                <TextBlock Grid.Column="3" Text="Kvar" FontSize="12" TextAlignment="Right" Foreground="{StaticResource Brush.TextDim}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Balances}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type graph:TokenBalanceRow}">
                                        <Grid Margin="0,0,0,6" ToolTip="{Binding FreezeText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Glyph}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,5,0" />
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" />
                                                    <controls:GridIcon Size="12" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Brush.Mark.Freeze}"
                                                                       Data="{StaticResource Icon.Snow}"
                                                                       Visibility="{Binding CanBeFrozen, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Note}" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding In}" FontSize="12.5" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Out}" FontSize="12.5" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Left}" FontSize="12.5" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="{StaticResource Brush.SurfaceRaised}" CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                                    Visibility="{Binding HasFreezeText, Converter={StaticResource Visible}}">
                                <DockPanel>
                                    <controls:GridIcon DockPanel.Dock="Left" Size="14" Margin="0,1,8,0" VerticalAlignment="Top"
                                                       Foreground="{StaticResource Brush.Mark.Freeze}" Data="{StaticResource Icon.Snow}" />
                                    <TextBlock Text="{Binding FreezeText}" FontSize="12.5" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- Här (sketch KF1a): the checks and suggestions that concern the chosen actor. -->
                        <ItemsControl Focusable="False" Margin="0,0,0,10"
                                      ItemsSource="{Binding DataContext.Checks.Here, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HereLine}">
                                    <DockPanel Margin="0,0,0,5">
                                        <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0">
                                            <Ellipse x:Name="Ring" StrokeThickness="1.1"
                                                     Stroke="{Binding Look.TintKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                                            <controls:GridIcon Size="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{Binding Look.TintKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}"
                                                               Data="{Binding Look.Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontSize="12"
                                                   Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                            <Setter TargetName="Ring" Property="StrokeDashArray" Value="2.5 2" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Addresses, txids and blocks in full, so that every step can be checked against the chain. -->
                        <ItemsControl ItemsSource="{Binding Details}" Focusable="False" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="26" Height="26"
                                                Margin="6,-4,0,0" VerticalAlignment="Top" AutomationProperties.Name="Kopiera"
                                                ToolTip="Kopiera" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <controls:GridIcon Size="14" Data="{StaticResource Icon.Copy}" />
                                        </Button>
                                        <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 Foreground="{StaticResource Brush.TextMuted}" FontFamily="{StaticResource Font.Mono}"
                                                 SelectionBrush="{StaticResource Brush.Accent}" CaretBrush="{StaticResource Brush.Text}"
                                                 FontSize="12" TextWrapping="Wrap" Padding="0" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- The checks and suggestions (sketch KF1a) fold out where the inspector stands, over it. -->
                <views:ChecksPanel DataContext="{Binding Checks}"
                                   Visibility="{Binding IsOpen, Converter={StaticResource Visible}}" />
            </Grid>
        </Border>

        <!--
          The inspector's left edge is dragged to make it wider or narrower; the width is kept while Chainsaw runs. A small
          grip in the middle of the edge always shows that it can be dragged, and a dark grey line along the whole edge
          fades in when the pointer rests there a moment (and stays while dragging).
        -->
        <GridSplitter x:Name="InspectorEdge" Grid.Column="1" Width="8" HorizontalAlignment="Left" Margin="-4,0,0,0"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"
                      Cursor="SizeWE" Focusable="False" DragCompleted="OnInspectorResized"
                      AutomationProperties.Name="Inspektörens bredd">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Line" Width="2" HorizontalAlignment="Center" Opacity="0"
                                   Fill="{StaticResource Brush.BorderHover}" />
                        <Border x:Name="Grip" Width="4" Height="36" CornerRadius="2" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Background="{StaticResource Brush.BorderStrong}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{StaticResource Brush.BorderHover}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="Opacity"
                                                         To="1" BeginTime="0:0:0.35" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Fill" Value="{StaticResource Brush.TextDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>
    </Grid>
</UserControl>
