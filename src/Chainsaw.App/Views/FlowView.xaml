<UserControl x:Class="Chainsaw.App.Views.FlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:FlowViewModel}"
             mc:Ignorable="d" Focusable="True" FocusVisualStyle="{x:Null}">

    <!--
      The view Flöde (sketch FL1a): the method, dashed since the split is a judgement, the striped key for what is
      uncertain and the unit in the head, the Sankey under them; to the right where the victims' money ended per colour
      and, at the bottom, the chosen band's ways with what they rest on, Varför? and Visa vägen i grafen. Only wiring;
      what happens lives in FlowViewModel, and the Sankey is drawn by FlowChart.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A choice in a segmented control: the method, the asset or the unit; the chosen one on the selected ground. -->
        <Style x:Key="Segment" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Height="28" Padding="11,0" CornerRadius="7" Background="Transparent">
                            <TextBlock x:Name="Words" Text="{Binding Text}" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                                <Setter TargetName="Words" Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SegmentItem" DataType="{x:Type vm:ExposureChoice}">
            <Button Style="{StaticResource Segment}" ToolTip="{Binding ToolTip}"
                    Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding Value}" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="InRow">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- A quiet text button: Varför? and the method's ?. -->
        <Style x:Key="Quiet" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Padding="4,0" CornerRadius="6" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caps" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Nothing to show yet: said honestly, with the view's icon, never with made-up bands. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80" MaxWidth="460"
                    Visibility="{Binding HasFlow, Converter={x:Static controls:InvertVisibility.Instance}}">
            <controls:GridIcon Size="40" Foreground="{StaticResource Brush.TextFaint}" HorizontalAlignment="Center"
                               Data="{StaticResource Icon.Flow}" />
            <TextBlock Text="{x:Static vm:FlowViewModel.EmptyText}" FontSize="13.5" Margin="0,14,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="21" Foreground="{StaticResource Brush.TextDim}" />
            <TextBlock Text="{Binding Problem}" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{StaticResource Brush.Error}" Visibility="{Binding HasProblem, Converter={StaticResource Visible}}" />
        </StackPanel>

        <Grid x:Name="Room" Margin="84,0,0,0" Visibility="{Binding HasFlow, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- ===== The Sankey, with the method, the key and the unit over it. ===== -->
            <Grid Grid.Column="0" Margin="0,16,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Metod" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextDim}"
                               ToolTip="Spårningsmetoden avgör hur ett belopp delas när pengar från flera håll blandas · ?" />
                    <Grid DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Rectangle RadiusX="9" RadiusY="9" StrokeThickness="1" StrokeDashArray="3 2" SnapsToDevicePixels="True"
                                   Stroke="{StaticResource Brush.BorderHover}" Fill="{StaticResource Brush.Surface}" />
                        <ItemsControl Margin="2" ItemsSource="{Binding Methods}" Tag="{Binding SetMethodCommand}" Focusable="False"
                                      ItemTemplate="{StaticResource SegmentItem}" ItemsPanel="{StaticResource InRow}" />
                    </Grid>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Quiet}" Margin="8,0,0,0" Height="22" VerticalAlignment="Center"
                            Command="{Binding AskMethodsCommand}" ToolTip="Spårningsmetoderna i Guiden · ?">
                        <Border Width="20" Height="20" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Brush.BorderHover}">
                            <controls:GridIcon Size="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextMuted}" Data="{StaticResource Icon.Question}" />
                        </Border>
                    </Button>

                    <!-- The unit: the asset, and the currency when every part has a value. -->
                    <Border DockPanel.Dock="Right" Padding="2" CornerRadius="9" BorderThickness="1" VerticalAlignment="Center"
                            BorderBrush="{StaticResource Brush.BorderStrong}" Background="{StaticResource Brush.Surface}"
                            Visibility="{Binding HasUnits, Converter={StaticResource Visible}}">
                        <ItemsControl ItemsSource="{Binding Units}" Tag="{Binding SetUnitCommand}" Focusable="False"
                                      ItemTemplate="{StaticResource SegmentItem}" ItemsPanel="{StaticResource InRow}" />
                    </Border>

                    <!-- The assets, only when the graph moves more than one (principle 7). -->
                    <Border DockPanel.Dock="Right" Padding="2" CornerRadius="9" BorderThickness="1" Margin="0,0,10,0"
                            VerticalAlignment="Center" BorderBrush="{StaticResource Brush.BorderStrong}"
                            Background="{StaticResource Brush.Surface}"
                            Visibility="{Binding HasAssets, Converter={StaticResource Visible}}">
                        <ItemsControl ItemsSource="{Binding Assets}" Tag="{Binding PickAssetCommand}" Focusable="False"
                                      ItemTemplate="{StaticResource SegmentItem}" ItemsPanel="{StaticResource InRow}" />
                    </Border>

                    <!-- The key for what is uncertain: striped and dashed, only when a way rests on something uncertain. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center"
                                Background="Transparent"
                                ToolTip="Streckat är en bedömning: vägen bygger på något osäkert, till exempel en trolig utgång ur en mixer"
                                Visibility="{Binding HasGuess, Converter={StaticResource Visible}}">
                        <Grid Width="22" Height="12" ClipToBounds="True">
                            <Rectangle RadiusX="2" RadiusY="2" StrokeThickness="1" StrokeDashArray="3 2"
                                       Stroke="{StaticResource Brush.Kind.OtherChain}" />
                            <Path Stroke="{StaticResource Brush.Kind.OtherChain}" Opacity="0.7" StrokeThickness="1"
                                  Data="M3,11 L10,1 M9,11 L16,1 M15,11 L21,3" />
                        </Grid>
                        <TextBlock Text="förslag" FontSize="12" Margin="7,0,0,0" Foreground="{StaticResource Brush.TextMuted}" />
                    </StackPanel>
                </DockPanel>

                <controls:FlowChart x:Name="Chart" Grid.Row="1" Margin="0,16,0,0" Picture="{Binding Picture}" Lit="{Binding Lit}"
                                    PickCommand="{Binding PickCommand}" />

                <TextBlock Grid.Row="2" Text="{Binding Note}" FontSize="11.5" Margin="0,6,0,0"
                           Foreground="{StaticResource Brush.TextDim}" Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
            </Grid>

            <!-- ===== The side: where the victims' money ended, and the chosen band. ===== -->
            <!-- Under the work, as the graph's inspector (sketch IN5a): 20 px more room on the left than the content's 20. -->
            <controls:UnderPanel Grid.Column="2" Padding="20,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border}"
                            Background="{StaticResource Brush.Floating}" Padding="20,16,20,18" CornerRadius="0"
                            Visibility="{Binding HasDetail, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <DockPanel>
                                <controls:SortMark DockPanel.Dock="Left" Width="36" Height="36" Look="{Binding Detail.Look}" />
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Detail.Percent}" FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Foreground="{StaticResource Brush.Text}" />
                                    <TextBlock Text="av offrens" FontSize="11.5" HorizontalAlignment="Right"
                                               Foreground="{StaticResource Brush.TextDim}" />
                                </StackPanel>
                                <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Detail.Name}" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource Brush.Text}" />
                                    <TextBlock Text="{Binding Detail.Line}" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                </StackPanel>
                            </DockPanel>

                            <!-- The ways: the actors as chips, the amount and the transactions behind every step. -->
                            <ItemsControl ItemsSource="{Binding Detail.Routes}" Focusable="False" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FlowRoute}">
                                        <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="10" BorderThickness="1"
                                                BorderBrush="{StaticResource Brush.BorderStrong}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" FontSize="12" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" Foreground="{StaticResource Brush.Text}" />
                                                    <ItemsControl ItemsSource="{Binding Crumbs}" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:ExposureCrumb}">
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                    <Grid Height="22">
                                                                        <Rectangle x:Name="Frame" RadiusX="6" RadiusY="6" StrokeThickness="1"
                                                                                   Stroke="{StaticResource Brush.BorderStrong}" SnapsToDevicePixels="True" />
                                                                        <TextBlock Text="{Binding Text}" FontSize="12" Margin="7,0" VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource Brush.TextMuted}" />
                                                                    </Grid>
                                                                    <TextBlock Text="›" Margin="4,0" VerticalAlignment="Center"
                                                                               Foreground="{StaticResource Brush.TextFaint}"
                                                                               Visibility="{Binding HasNext, Converter={StaticResource Visible}}" />
                                                                </StackPanel>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDashed}" Value="True">
                                                                        <Setter TargetName="Frame" Property="StrokeDashArray" Value="3 2" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Transactions}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                           Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextDim}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- What it rests on, how many more ways, and Varför?. -->
                            <WrapPanel Margin="0,2,0,0">
                                <ItemsControl ItemsSource="{Binding Detail.Basis}" Focusable="False"
                                              ItemTemplate="{StaticResource ExposureBasisChip}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Text="{Binding Detail.More}" FontSize="11.5" Margin="0,3,8,6" Foreground="{StaticResource Brush.TextDim}"
                                           Visibility="{Binding Detail.HasMore, Converter={StaticResource Visible}}" />
                                <Button Style="{StaticResource Quiet}" Height="22" Margin="0,0,0,6" Command="{Binding AskWhyCommand}"
                                        ToolTip="Öppnar Guiden bredvid · ?">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:GridIcon Size="12" Foreground="{StaticResource Brush.TextMuted}"
                                                           Data="{StaticResource Icon.Question}" />
                                        <TextBlock Text="Varför?" FontSize="11.5" Margin="5,0,0,0" Foreground="{StaticResource Brush.TextMuted}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <Button Style="{StaticResource Button.Primary}" Height="38" Margin="0,8,0,0"
                                    Command="{Binding ShowPathCommand}" ToolTip="Visa vägen i grafen · G">
                                <StackPanel Orientation="Horizontal">
                                    <controls:GridIcon Size="15" Foreground="{StaticResource Brush.OnAccent}" VerticalAlignment="Center"
                                                       Data="{StaticResource Icon.Target}" />
                                    <TextBlock Text="Visa vägen i grafen" FontSize="13.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="G" FontSize="11" FontWeight="Normal" Opacity="0.7" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Where the victims' money ended, per colour. -->
                    <StackPanel Margin="20,16,20,6">
                        <DockPanel Height="30">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding UnitText}" FontSize="12" Margin="5,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource Brush.TextDim}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text}" />
                            <TextBlock Text="FRÅN OFFREN" Style="{StaticResource Caps}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Ends}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FlowEndRow}">
                                    <Grid Height="30" ToolTip="{Binding ToolTip}" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" HorizontalAlignment="Left"
                                                   Fill="{Binding Ink, Converter={x:Static controls:GraphInkConverter.Instance}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.TextMuted}" />
                                        <Border Grid.Column="2" Height="5" CornerRadius="2.5" VerticalAlignment="Center"
                                                Background="{StaticResource Brush.SurfaceRaised}" ClipToBounds="True">
                                            <Border CornerRadius="2.5" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5"
                                                    Background="{Binding Ink, Converter={x:Static controls:GraphInkConverter.Instance}}">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Share}" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding Percent}" FontSize="12.5" TextAlignment="Right"
                                                   VerticalAlignment="Center" Foreground="{StaticResource Brush.Text}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </controls:UnderPanel>
        </Grid>
    </Grid>
</UserControl>
