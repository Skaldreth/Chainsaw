<UserControl x:Class="Chainsaw.App.Views.TrashBin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:TrashBinViewModel}"
             mc:Ignorable="d" Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Bottom">

    <!--
      The trash in the lower left corner (sketch SO1a): a round 38 px icon under the pill that grows into a round area
      as something dragged comes near, bright with a ring wave when a release throws. Never red, which means risk. The
      control is a corner of 300 px in which the round area grows; only the area itself takes the pointer. The places
      follow TrashBinViewModel in the code-behind.
    -->
    <Canvas x:Name="Corner" ClipToBounds="False">
        <Ellipse x:Name="WaveOne" Stroke="{StaticResource Brush.Text}" StrokeThickness="1.5" Opacity="0"
                 IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="WaveOneScale" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="WaveTwo" Stroke="{StaticResource Brush.Text}" StrokeThickness="1.5" Opacity="0"
                 IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="WaveTwoScale" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Border x:Name="Body" Cursor="Hand" Background="{StaticResource Brush.SurfaceRaised}"
                BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1"
                ToolTip="{x:Static vm:TrashBinViewModel.ToolTipText}" AutomationProperties.Name="Soptunnan"
                MouseLeftButtonUp="OnBodyClicked">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.45" Color="Black" />
            </Border.Effect>
            <Grid>
                <Ellipse x:Name="Dashed" Stroke="{StaticResource Brush.TextFaint}" StrokeThickness="1.5"
                         StrokeDashArray="3 3" Visibility="Collapsed" IsHitTestVisible="False" />
                <StackPanel x:Name="Inside" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:GridIcon x:Name="Icon" Size="20" Data="{StaticResource Icon.Trash}"
                                       Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="DropWord" Text="Släpp" FontSize="11.5" Foreground="{StaticResource Brush.Text}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Something lies in the trash: a small grey dot, never red. -->
        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Brush.TextMuted}"
                 Stroke="{StaticResource Brush.SurfaceRaised}" StrokeThickness="1.5" IsHitTestVisible="False" />
    </Canvas>
</UserControl>
