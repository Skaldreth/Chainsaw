<UserControl x:Class="Chainsaw.App.Views.GateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:cases="clr-namespace:Chainsaw.Modules.Cases.Contracts;assembly=Chainsaw.Modules.Cases.Contracts"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A dash at the top of the setup: the accent once the step is reached. -->
        <DataTemplate x:Key="StepDash" DataType="{x:Type vm:StepDot}">
            <Border x:Name="Dash" Height="4" CornerRadius="2" Margin="4,0" Background="{StaticResource Brush.BorderStrong}"
                    ToolTip="{Binding Name}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsReached}" Value="True">
                    <Setter TargetName="Dash" Property="Background" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A line under the lock screen's form: a small icon and a sentence. -->
        <Style x:Key="Text.Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Title bar: on the lock page only the logo and the window buttons (sketches ID8c and FS1a) ===== -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <Image DockPanel.Dock="Left" Source="{StaticResource Logo.Small}" Width="16" Height="16"
                       Margin="14,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock DockPanel.Dock="Left" Text="Chainsaw" FontWeight="SemiBold" VerticalAlignment="Center" />

                <Button DockPanel.Dock="Right" Style="{StaticResource Button.WindowClose}" Click="OnClose"
                        WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Stäng">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" StrokeThickness="1"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Window}" Click="OnMaximize"
                        WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximera">
                    <Path Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" Width="10" Height="10" StrokeThickness="1"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Window}" Click="OnMinimize"
                        WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimera">
                    <Path Data="M0,5 L10,5" Width="10" Height="10" StrokeThickness="1"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </DockPanel>
        </Border>

        <!-- ===== The page: the chain that turns into a helix (sketch ID8c), and the form beside it ===== -->
        <Grid Grid.Row="1" Background="{StaticResource Brush.Background}" ClipToBounds="True">
            <controls:ChainFigure />

            <!-- The lock screen (sketch ID8c): the form where the sketch has it on a 1440 px page. -->
            <Grid Visibility="{Binding IsLockVisible, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="760*" MinWidth="420" />
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="300*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="250*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="254*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="LockForm" Grid.Row="1" Grid.Column="1" DataContext="{Binding LockScreen}">
                    <TextBlock Text="Lås upp Chainsaw" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Text="Huvudnyckel" FontWeight="Medium" Margin="0,0,0,8" />
                    <PasswordBox x:Name="LockKey" Style="{StaticResource PasswordBox.Lock}" KeyDown="OnLockKeyDown"
                                 AutomationProperties.Name="Huvudnyckel" />
                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Error}" Margin="0,8,0,0" />
                    <Button Style="{StaticResource Button.Primary}" Height="44" Margin="0,14,0,0" Click="OnUnlock"
                            Content="{Binding UnlockLabel}"
                            IsEnabled="{Binding IsBusy, Converter={x:Static controls:InvertConverter.Instance}}" />
                    <TextBlock Text="Nyckeln låser upp valvet och ärendena. Den lagras aldrig, och utan den går ärendena inte att läsa."
                               FontSize="13.5" Foreground="{StaticResource Brush.TextDim}" TextWrapping="Wrap"
                               LineHeight="19" Margin="0,14,0,0" />

                    <StackPanel Margin="0,26,0,0">
                        <DockPanel>
                            <controls:GridIcon DockPanel.Dock="Left" Size="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                               Data="{StaticResource Icon.Shield}" />
                            <TextBlock Text="{Binding ExitText}" Style="{StaticResource Text.Note}" />
                        </DockPanel>
                        <!-- A watch has hit while Chainsaw was closed or locked (sketch ID8c): only that. -->
                        <DockPanel Margin="0,10,0,0" Visibility="{Binding HasWatchHit, Converter={StaticResource Visible}}">
                            <Border DockPanel.Dock="Left" Width="14" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Accent}" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{x:Static vm:LockViewModel.WatchHitText}" Style="{StaticResource Text.Note}"
                                       Foreground="{StaticResource Brush.Text}" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <controls:GridIcon DockPanel.Dock="Left" Size="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                               Data="{StaticResource Icon.Lock}" />
                            <TextBlock Text="{Binding AutoLockText}" Style="{StaticResource Text.Note}" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- The first-run setup (sketch FS1a): one step at a time beside the same figure. -->
            <Grid Visibility="{Binding IsFirstRunVisible, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <!-- At least clear of the chain, which moves left with a narrow window. -->
                    <ColumnDefinition Width="700*" MinWidth="420" />
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="300*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="170*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="174*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="FirstRunForm" Grid.Row="1" Grid.Column="1" DataContext="{Binding FirstRun}"
                            KeyDown="OnFirstRunKeyDown">
                    <ItemsControl ItemsSource="{Binding Dots}" ItemTemplate="{StaticResource StepDash}" Focusable="False"
                                  Margin="-4,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding StepLabel}" FontSize="13" Foreground="{StaticResource Brush.TextDim}"
                               Margin="0,16,0,0" />

                    <!-- Step 1: Welcome -->
                    <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource Visible}}">
                        <TextBlock Text="Välkommen till Chainsaw" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource Text.Lead}" Margin="0,16,0,0">
                            Ditt namn står som <Italic>utförd av</Italic> i journalen. Det lämnar aldrig datorn.
                        </TextBlock>
                        <TextBlock Text="Namn" Style="{StaticResource Text.Label}" Margin="0,16,0,6" />
                        <TextBox x:Name="NameBox" Style="{StaticResource TextBox.Field}" AutomationProperties.Name="Namn"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Titel" Style="{StaticResource Text.Label}" Margin="0,16,0,6" />
                        <TextBox Style="{StaticResource TextBox.Field}" AutomationProperties.Name="Titel"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Organisation" Style="{StaticResource Text.Label}" Margin="0,16,0,6" />
                        <TextBox Style="{StaticResource TextBox.Field}" AutomationProperties.Name="Organisation"
                                 Text="{Binding Organization, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Step 2: the master key, twice; it creates the vault -->
                    <StackPanel Visibility="{Binding IsMasterKey, Converter={StaticResource Visible}}">
                        <TextBlock Text="Välj en huvudnyckel" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource Text.Lead}" Margin="0,16,0,0"
                                   Text="Den låser upp valvet och dina ärenden. Den sparas aldrig, och utan den går ingenting att läsa." />
                        <StackPanel x:Name="MasterKeyFields"
                                    Visibility="{Binding IsMasterKeyChosen, Converter={x:Static controls:InvertVisibility.Instance}}">
                            <TextBlock Text="Huvudnyckel" Style="{StaticResource Text.Label}" Margin="0,16,0,6" />
                            <PasswordBox x:Name="FirstKey" Style="{StaticResource PasswordBox.Field}"
                                         AutomationProperties.Name="Huvudnyckel" />
                            <TextBlock Text="Minst 12 tecken. En mening är lättare att minnas än ett lösenord." FontSize="13"
                                       Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0" />
                            <TextBlock Text="Upprepa" Style="{StaticResource Text.Label}" Margin="0,16,0,6" />
                            <PasswordBox x:Name="RepeatKey" Style="{StaticResource PasswordBox.Field}"
                                         AutomationProperties.Name="Upprepa huvudnyckeln" />
                        </StackPanel>
                        <TextBlock Text="Huvudnyckeln är vald och valvet är skapat." FontSize="14"
                                   Foreground="{StaticResource Brush.Success}" Margin="0,16,0,0"
                                   Visibility="{Binding IsMasterKeyChosen, Converter={StaticResource Visible}}" />
                    </StackPanel>

                    <!-- Step 3: the exit -->
                    <StackPanel Visibility="{Binding IsExit, Converter={StaticResource Visible}}">
                        <TextBlock Text="Hur Chainsaw går ut på nätet" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource Text.Lead}" Margin="0,16,0,0"
                                   Text="Uppslag mot kedjan går genom en VPN-utgång, eller genom Windows om du väljer det i inställningarna (Ctrl+,). Utan utgång fungerar allt som redan finns i ärendet, men inget nytt hämtas." />
                        <Button x:Name="AddExitButton" Style="{StaticResource Button.Choice}" Margin="0,16,0,0" Click="OnAddExit"
                                IsEnabled="{Binding IsBusy, Converter={x:Static controls:InvertConverter.Instance}}">
                            <StackPanel Orientation="Horizontal">
                                <controls:GridIcon Size="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Data="{StaticResource Icon.Download}" />
                                <StackPanel>
                                    <TextBlock Text="Lägg till en WireGuard-fil" Foreground="{StaticResource Brush.Text}" />
                                    <TextBlock Text="Konfigurationen sparas krypterad i valvet" FontSize="13"
                                               Foreground="{StaticResource Brush.TextDim}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Choice}" Margin="0,16,0,0" Click="OnLater"
                                IsEnabled="{Binding IsBusy, Converter={x:Static controls:InvertConverter.Instance}}">
                            <StackPanel>
                                <TextBlock Text="Senare" Foreground="{StaticResource Brush.Text}" />
                                <TextBlock Text="Chainsaw arbetar offline tills en utgång finns" FontSize="13"
                                           Foreground="{StaticResource Brush.TextDim}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Step 4: the first case, which can be skipped -->
                    <StackPanel Visibility="{Binding IsFirstCase, Converter={StaticResource Visible}}">
                        <TextBlock Text="Ditt första ärende" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource Text.Lead}" Margin="0,16,0,0"
                                   Text="Ärendet blir en krypterad fil med ärendenumret som namn. Det går att hoppa över och skapa senare." />
                        <TextBlock FontSize="14" Foreground="{StaticResource Brush.Success}" Margin="0,10,0,0"
                                   Visibility="{Binding HasExit, Converter={StaticResource Visible}}">
                            <Run Text="Utgången" /> <Run Text="{Binding ExitName, Mode=OneWay}" /> <Run Text="är sparad i valvet." />
                        </TextBlock>
                        <TextBlock Text="Ärendenummer" Style="{StaticResource Text.Label}" Margin="0,16,0,6" />
                        <TextBox x:Name="CaseNumberBox" Style="{StaticResource TextBox.Field}" AutomationProperties.Name="Ärendenummer"
                                 Text="{Binding CaseNumber, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Titel" Style="{StaticResource Text.Label}" Margin="0,14,0,6" />
                        <TextBox Style="{StaticResource TextBox.Field}" AutomationProperties.Name="Titel"
                                 MaxLength="{x:Static cases:CaseTitleRules.MaximumLength}"
                                 Text="{Binding CaseTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Startpunkt" Style="{StaticResource Text.Label}" Margin="0,14,0,6" />
                        <TextBox Style="{StaticResource TextBox.Field}" AutomationProperties.Name="Startpunkt"
                                 FontFamily="{StaticResource Font.Mono}" FontSize="13.5"
                                 Text="{Binding StartPointText, UpdateSourceTrigger=PropertyChanged}" />
                        <ContentControl Content="{Binding StartPoint}" ContentTemplate="{StaticResource StartPointLine}"
                                        Focusable="False" Visibility="{Binding HasStartPoint, Converter={StaticResource Visible}}" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Error}" Margin="0,16,0,0" />

                    <DockPanel Margin="0,22,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Style="{StaticResource Button.Secondary}" Content="Tillbaka" Click="OnBack"
                                Visibility="{Binding CanGoBack, Converter={StaticResource Visible}}"
                                IsEnabled="{Binding IsBusy, Converter={x:Static controls:InvertConverter.Instance}}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="{Binding NextLabel}"
                                Click="OnNext" Margin="10,0,0,0"
                                IsEnabled="{Binding IsBusy, Converter={x:Static controls:InvertConverter.Instance}}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Hoppa över" Click="OnSkip"
                                Visibility="{Binding IsFirstCase, Converter={StaticResource Visible}}"
                                IsEnabled="{Binding IsBusy, Converter={x:Static controls:InvertConverter.Instance}}" />
                    </DockPanel>
                </StackPanel>
            </Grid>

            <!-- Om Chainsaw in the corner: the commit, and on a click the version. -->
            <Button x:Name="AboutButton" Style="{StaticResource Button.About}" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Margin="0,0,16,14" Content="{Binding LockScreen.AboutText}"
                    Click="OnAbout" />
            <Popup x:Name="AboutPopup" PlacementTarget="{Binding ElementName=AboutButton}" Placement="Top"
                   StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
                <Border Background="{StaticResource Brush.Floating}" BorderBrush="{StaticResource Brush.BorderStrong}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" MaxWidth="320">
                    <TextBlock Text="{Binding LockScreen.AboutDetails}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.TextMuted}" LineHeight="18" />
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>
