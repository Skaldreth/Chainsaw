<UserControl x:Class="Chainsaw.App.Views.WatchForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:WatchFormViewModel}"
             mc:Ignorable="d">

    <!--
      The watch form (sketches BV1a and BV2a), the same for Bevaka … on a node, Ny bevakning … and Ändra: direction,
      receivers and senders as chips (a typed address or Ctrl+click in the graph), the asset on Ethereum, an optional
      minimum and the pace from the settings. Esc cancels and Enter saves. Only wiring; what happens lives in
      WatchFormViewModel.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="74" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Segment" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Chip" DataType="{x:Type vm:WatchPartyChip}">
            <Border Height="22" Padding="7,0,4,0" Margin="0,0,4,4" CornerRadius="11" BorderThickness="1.5"
                    BorderBrush="{StaticResource Brush.Accent}" Background="{StaticResource Brush.Surface}"
                    ToolTip="{Binding ToolTip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Text}" FontSize="12" VerticalAlignment="Center" />
                    <Button Focusable="False" Cursor="Hand" Margin="4,0,0,0" ToolTip="Ta bort" Background="Transparent"
                            Command="{Binding DataContext.RemovePartyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <controls:GridIcon Size="10" Data="{StaticResource Icon.Close}" Foreground="{StaticResource Brush.TextDim}" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="Even">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>

    <Border Width="300" Padding="13" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}"
            Background="{StaticResource Brush.SurfaceRaised}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="14" Direction="270" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <DockPanel>
                <controls:GridIcon Size="16" Data="{StaticResource Icon.Eye}" Foreground="{StaticResource Brush.Accent}"
                                   DockPanel.Dock="Left" Margin="0,0,8,0" />
                <Border DockPanel.Dock="Right" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}"
                        Padding="7,1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ChainName}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" />
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- Ny bevakning: the address, recognised by its form and checksum. -->
            <TextBox Style="{StaticResource TextBox.Field}" Height="30" Margin="0,11,0,0" FontFamily="{StaticResource Font.Mono}"
                     FontSize="12.5" Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsManual, Converter={StaticResource Visible}}"
                     AutomationProperties.Name="Adress att bevaka" />

            <DockPanel Margin="0,11,0,0">
                <TextBlock Text="Riktning" Style="{StaticResource RowLabel}" />
                <Border BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}" CornerRadius="6" ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding Directions}" ItemsPanel="{StaticResource Even}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WatchChoice}">
                                <Button Style="{StaticResource Segment}" Content="{Binding Label}"
                                        Command="{Binding DataContext.ChooseDirectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Value}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </DockPanel>

            <!-- Receivers (1:n) and senders (n:1): empty means all; Ctrl+click in the graph adds to the picked row. -->
            <DockPanel Margin="0,11,0,0" Visibility="{Binding ShowsReceivers, Converter={StaticResource Visible}}">
                <TextBlock Text="Mottagare" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,4,0,0" />
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Receivers}" ItemTemplate="{StaticResource Chip}"
                                  ItemsPanel="{StaticResource Wrap}" Focusable="False" />
                    <Button Style="{StaticResource Button.Chip}" Height="22" HorizontalAlignment="Left"
                            Command="{Binding PickCommand}" CommandParameter="{x:Static vm:WatchPartyList.Receivers}"
                            ToolTip="Lägg till en adress nedan, eller Ctrl+klick på noder i grafen">
                        <StackPanel Orientation="Horizontal">
                            <controls:GridIcon Size="11" Data="{StaticResource Icon.Pick}" Margin="0,0,5,0">
                                <controls:GridIcon.Style>
                                    <Style TargetType="controls:GridIcon">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PicksReceivers}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:GridIcon.Style>
                            </controls:GridIcon>
                            <TextBlock FontSize="12" Text="Alla, eller lägg till" Foreground="{StaticResource Brush.TextDim}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,11,0,0" Visibility="{Binding ShowsSenders, Converter={StaticResource Visible}}">
                <TextBlock Text="Avsändare" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,4,0,0" />
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Senders}" ItemTemplate="{StaticResource Chip}"
                                  ItemsPanel="{StaticResource Wrap}" Focusable="False" />
                    <Button Style="{StaticResource Button.Chip}" Height="22" HorizontalAlignment="Left"
                            Command="{Binding PickCommand}" CommandParameter="{x:Static vm:WatchPartyList.Senders}"
                            ToolTip="Lägg till en adress nedan, eller Ctrl+klick på noder i grafen">
                        <StackPanel Orientation="Horizontal">
                            <controls:GridIcon Size="11" Data="{StaticResource Icon.Pick}" Margin="0,0,5,0">
                                <controls:GridIcon.Style>
                                    <Style TargetType="controls:GridIcon">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PicksSenders}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:GridIcon.Style>
                            </controls:GridIcon>
                            <TextBlock FontSize="12" Text="Alla, eller lägg till" Foreground="{StaticResource Brush.TextDim}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
            <DockPanel Margin="74,6,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Graph}" Height="26" Padding="9,0" Margin="6,0,0,0"
                        FontSize="12.5" Content="Lägg till" Command="{Binding AddPartyCommand}" />
                <TextBox Style="{StaticResource TextBox.Field}" Height="26" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                         Text="{Binding PartyText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Motpartens adress">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddPartyCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <DockPanel Margin="0,11,0,0">
                <TextBlock Text="Tillgång" Style="{StaticResource RowLabel}" />
                <Grid>
                    <TextBlock Text="BTC, den enda på Bitcoin" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}"
                               Visibility="{Binding IsBitcoin, Converter={StaticResource Visible}}" />
                    <Border BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}" CornerRadius="6" ClipToBounds="True"
                            Visibility="{Binding IsEthereum, Converter={StaticResource Visible}}">
                        <ItemsControl ItemsSource="{Binding Assets}" ItemsPanel="{StaticResource Even}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WatchChoice}">
                                    <Button Style="{StaticResource Segment}" Content="{Binding Label}"
                                            Command="{Binding DataContext.ChooseAssetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Value}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </DockPanel>

            <DockPanel Margin="0,11,0,0">
                <TextBlock Text="Minsta belopp" Style="{StaticResource RowLabel}" />
                <Grid>
                    <TextBox Style="{StaticResource TextBox.Field}" Height="26" FontSize="12.5" IsEnabled="{Binding CanHaveMinimum}"
                             Text="{Binding MinimumInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Minsta belopp" />
                    <TextBlock Text="{Binding MinimumHint}" FontSize="12.5" Foreground="{StaticResource Brush.TextFaint}" Margin="9,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MinimumInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <DockPanel Margin="0,11,0,0">
                <TextBlock Text="Hur ofta" Style="{StaticResource RowLabel}" />
                <Border BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}" CornerRadius="6" ClipToBounds="True"
                        ToolTip="Hur ofta bevakningen frågar källan: vid varje nytt block, eller högst så ofta">
                    <ItemsControl ItemsSource="{Binding Paces}" ItemsPanel="{StaticResource Even}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WatchChoice}">
                                <Button Style="{StaticResource Segment}" Content="{Binding Label}"
                                        Command="{Binding DataContext.ChoosePaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Value}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </DockPanel>

            <TextBlock Text="{x:Static vm:WatchWords.FormNote}" FontSize="11.5" Foreground="{StaticResource Brush.TextFaint}"
                       Margin="0,11,0,0" />
            <TextBlock Text="{Binding Problem}" FontSize="12.5" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap"
                       Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Style="{StaticResource Button.Graph}" Height="28" Padding="10,0" FontSize="13" Margin="0,0,6,0"
                        Command="{Binding CancelCommand}" ToolTip="Esc">Avbryt</Button>
                <Button Style="{StaticResource Button.Primary}" Height="28" Padding="10,0" Command="{Binding SaveCommand}"
                        ToolTip="Enter">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SaveText}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Enter" FontSize="11.5" Opacity="0.6" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
