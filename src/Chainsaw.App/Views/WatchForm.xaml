<UserControl x:Class="Chainsaw.App.Views.WatchForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:monitoring="clr-namespace:Chainsaw.Modules.Monitoring.Contracts;assembly=Chainsaw.Modules.Monitoring.Contracts"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:WatchFormViewModel}"
             mc:Ignorable="d">

    <!--
      The watch form (sketch BV3a), the same for Bevaka … on a node, Ny bevakning … and Ändra: only the direction shows,
      as three large icons, a sentence says what the watch does with the defaults filled in, and the counterparties, the
      minimum and how often are small extras that fold out their field. The asset shows only on Ethereum. Esc cancels
      and Enter saves. Only wiring; what happens lives in WatchFormViewModel.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="74" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Segment" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Chip" DataType="{x:Type vm:WatchPartyChip}">
            <Border Height="22" Padding="7,0,4,0" Margin="0,0,4,4" CornerRadius="11" BorderThickness="1.5"
                    BorderBrush="{StaticResource Brush.Accent}" Background="{StaticResource Brush.Surface}"
                    ToolTip="{Binding ToolTip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Text}" FontSize="12" VerticalAlignment="Center" />
                    <Button Focusable="False" Cursor="Hand" Margin="4,0,0,0" ToolTip="Ta bort" Background="Transparent"
                            Command="{Binding DataContext.RemovePartyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <controls:GridIcon Size="10" Data="{StaticResource Icon.Close}" Foreground="{StaticResource Brush.TextDim}" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- The label before a row of counterparties; a click makes it the row that additions go to. -->
        <Style x:Key="Button.Bare.Label" TargetType="Button">
            <Setter Property="Width" Value="76" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
        <!-- An extra under the sentence: + when folded in, a tick and lighter when out. -->
        <Style x:Key="Extra" TargetType="Button" BasedOn="{StaticResource Button.Chip}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <ItemsPanelTemplate x:Key="Even">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>

    <Border Width="340" Padding="18" CornerRadius="14" BorderThickness="1.5" BorderBrush="{StaticResource Brush.BorderStrong}"
            Background="{StaticResource Brush.Floating}">
        <StackPanel>
            <DockPanel>
                <controls:GridIcon Size="18" Data="{StaticResource Icon.Eye}" Foreground="{StaticResource Brush.Accent}"
                                   DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="B" FontSize="12" Foreground="{StaticResource Brush.TextDim}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- Ny bevakning: the address, recognised by its form and checksum. -->
            <TextBox Style="{StaticResource TextBox.Field}" Height="34" Margin="0,14,0,0" FontFamily="{StaticResource Font.Mono}"
                     FontSize="13" Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsManual, Converter={StaticResource Visible}}"
                     AutomationProperties.Name="Adress att bevaka" />

            <!-- The direction as three large icons, the only choice that always shows. -->
            <Border Margin="0,14,0,0" Padding="4" CornerRadius="10" Background="{StaticResource Brush.Background}">
                <ItemsControl ItemsSource="{Binding Directions}" ItemsPanel="{StaticResource Even}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WatchChoice}">
                            <Button x:Name="Tile" Focusable="False" Cursor="Hand" Height="62" Margin="2,0"
                                    Foreground="{StaticResource Brush.TextMuted}" Background="Transparent"
                                    AutomationProperties.Name="{Binding Label}" CommandParameter="{Binding Value}"
                                    Command="{Binding DataContext.ChooseDirectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <controls:GridIcon x:Name="Glyph" Size="22" HorizontalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="{Binding Label}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                                    <Setter TargetName="Tile" Property="Foreground" Value="{StaticResource Brush.Text}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static monitoring:WatchDirection.In}">
                                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.WatchIn}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static monitoring:WatchDirection.Out}">
                                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.WatchOut}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static monitoring:WatchDirection.Both}">
                                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.WatchBoth}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- What the watch does, in a sentence with what is chosen filled in. -->
            <TextBlock Text="{Binding Sentence}" FontSize="13" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap"
                       LineHeight="20" Margin="0,14,0,0" />

            <!-- Bara vissa motparter: receivers (1:n) and senders (n:1), as chips; Ctrl+click in the graph adds. -->
            <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowsParties, Converter={StaticResource Visible}}">
                <DockPanel Visibility="{Binding ShowsReceivers, Converter={StaticResource Visible}}" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Bare.Label}" Content="Bara till"
                            Command="{Binding PickCommand}" CommandParameter="{x:Static vm:WatchPartyList.Receivers}"
                            ToolTip="En adress nedan, eller Ctrl+klick på noder i grafen, läggs till här" />
                    <ItemsControl ItemsSource="{Binding Receivers}" ItemTemplate="{StaticResource Chip}"
                                  ItemsPanel="{StaticResource Wrap}" Focusable="False" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Visibility="{Binding ShowsSenders, Converter={StaticResource Visible}}" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Bare.Label}" Content="Bara från"
                            Command="{Binding PickCommand}" CommandParameter="{x:Static vm:WatchPartyList.Senders}"
                            ToolTip="En adress nedan, eller Ctrl+klick på noder i grafen, läggs till här" />
                    <ItemsControl ItemsSource="{Binding Senders}" ItemTemplate="{StaticResource Chip}"
                                  ItemsPanel="{StaticResource Wrap}" Focusable="False" VerticalAlignment="Center" />
                </DockPanel>
                <Grid>
                    <TextBox Style="{StaticResource TextBox.Field}" Height="32" FontFamily="{StaticResource Font.Mono}" FontSize="12.5"
                             Tag="Klistra in en adress, eller Ctrl+klicka i grafen"
                             Text="{Binding PartyText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Motpartens adress">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddPartyCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
            </StackPanel>

            <!-- The asset, only on Ethereum, where there is more than one. -->
            <Border Margin="0,12,0,0" BorderThickness="1.5" BorderBrush="{StaticResource Brush.BorderStrong}" CornerRadius="8"
                    ClipToBounds="True" Visibility="{Binding ShowsAssets, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding Assets}" ItemsPanel="{StaticResource Even}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WatchChoice}">
                            <Button Style="{StaticResource Segment}" Height="30" Content="{Binding Label}"
                                    Command="{Binding DataContext.ChooseAssetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Value}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <DockPanel Margin="0,12,0,0" Visibility="{Binding ShowsMinimum, Converter={StaticResource Visible}}">
                <TextBlock Text="Minsta belopp" Style="{StaticResource RowLabel}" Width="100" />
                <TextBox Style="{StaticResource TextBox.Field}" Height="32" FontSize="13" IsEnabled="{Binding CanHaveMinimum}"
                         Tag="{Binding MinimumHint}" Text="{Binding MinimumInput, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Minsta belopp" />
            </DockPanel>

            <Border Margin="0,12,0,0" BorderThickness="1.5" BorderBrush="{StaticResource Brush.BorderStrong}" CornerRadius="8"
                    ClipToBounds="True" Visibility="{Binding ShowsPace, Converter={StaticResource Visible}}"
                    ToolTip="Hur ofta bevakningen frågar källan: vid varje nytt block, eller högst så ofta">
                <ItemsControl ItemsSource="{Binding Paces}" ItemsPanel="{StaticResource Even}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WatchChoice}">
                            <Button Style="{StaticResource Segment}" Height="30" Content="{Binding Label}"
                                    Command="{Binding DataContext.ChoosePaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Value}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- The extras: each folds out its own field, and the sentence follows. -->
            <WrapPanel Margin="0,14,0,0">
                <Button Command="{Binding TogglePartiesCommand}" AutomationProperties.Name="Bara vissa motparter">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Extra}">
                            <Setter Property="Content" Value="+ Bara vissa motparter" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowsParties}" Value="True">
                                    <Setter Property="Content" Value="✓ Bara vissa motparter" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding ToggleMinimumCommand}" AutomationProperties.Name="Minsta belopp">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Extra}">
                            <Setter Property="Content" Value="+ Minsta belopp" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowsMinimum}" Value="True">
                                    <Setter Property="Content" Value="✓ Minsta belopp" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding TogglePaceCommand}" AutomationProperties.Name="Hur ofta">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Extra}">
                            <Setter Property="Content" Value="+ Hur ofta" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowsPace}" Value="True">
                                    <Setter Property="Content" Value="✓ Hur ofta" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>

            <TextBlock Text="{Binding Problem}" FontSize="12.5" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap"
                       Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Style="{StaticResource Button.Graph}" Height="34" Padding="14,0" FontSize="13.5" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" ToolTip="Esc">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Avbryt" />
                        <TextBlock Text="Esc" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Primary}" Height="34" Padding="16,0" Command="{Binding SaveCommand}"
                        ToolTip="Enter">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SaveText}" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="Enter" FontSize="11.5" Opacity="0.75" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
