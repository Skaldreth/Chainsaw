<UserControl x:Class="Chainsaw.App.Views.GuidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:guide="clr-namespace:Chainsaw.App.Guide"
             Width="440" HorizontalAlignment="Right">

    <!--
      The Guide beside the work (sketch GD1b): a panel from the right over the inspector; the rest is neither darkened
      nor blocked. The arrow goes back through what was read, Öppna i Guide takes the section to the view (F1), and
      × and Esc close.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />

        <!-- A detail of a value's step (sketch KU1a): the short name, the value, and copy for a full id. -->
        <DataTemplate x:Key="Valuation.Row" DataType="{x:Type guide:GuideValuationRow}">
            <DockPanel Margin="0,1,0,0">
                <TextBlock DockPanel.Dock="Left" Width="64" Text="{Binding Name}" FontSize="12"
                           Foreground="{StaticResource Brush.TextDim}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="22" Height="22"
                        Margin="6,-2,0,-2" ToolTip="Kopiera hela" AutomationProperties.Name="Kopiera"
                        CommandParameter="{Binding Copy}"
                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Visibility="{Binding CanCopy, Converter={StaticResource VisibleWhen}}">
                    <controls:GridIcon Size="12" Data="{StaticResource Icon.Copy}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <TextBlock Text="{Binding Value}" FontSize="12" FontFamily="{StaticResource Font.Mono}"
                           Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Copy}" />
            </DockPanel>
        </DataTemplate>

        <!--
          A step behind a value (sketch KU1a): a round mark on the thread down the left (the check in green for the
          fact from the chain), the title with its source as a small tag, the value large, and the details under it.
        -->
        <DataTemplate x:Key="Valuation.Step" DataType="{x:Type guide:GuideValuationStep}">
            <DockPanel Margin="0,0,0,14">
                <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" VerticalAlignment="Top"
                        Background="{StaticResource Brush.Surface}" BorderThickness="1.5"
                        BorderBrush="{StaticResource Brush.BorderStrong}">
                    <controls:GridIcon x:Name="Mark" Size="14"
                                       Data="{Binding Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                </Border>
                <StackPanel Margin="12,2,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}" />
                        <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="4" VerticalAlignment="Center"
                                Background="{StaticResource Brush.SurfaceHover}">
                            <TextBlock x:Name="Tag" Text="{Binding Source}" FontSize="11"
                                       Foreground="{StaticResource Brush.TextDim}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Value}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,4"
                               Foreground="{StaticResource Brush.Text}" />
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource Valuation.Row}"
                                  Focusable="False" />
                </StackPanel>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFact}" Value="True">
                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Brush.Success}" />
                    <Setter TargetName="Tag" Property="Foreground" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <!-- The shadow lies in a layer of its own, as under the pill, so that the text is not blurred. -->
        <Border Background="{StaticResource Brush.Surface}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Direction="180" Opacity="0.35" Color="Black" />
            </Border.Effect>
        </Border>
        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.BorderStrong}"
                BorderThickness="1,0,0,0">
            <DockPanel>
                <!-- The header: back, the group, Öppna i Guide and close. -->
                <Border DockPanel.Dock="Top" Height="48" Padding="8,0,10,0" BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource Button.Icon}" Command="{Binding BackCommand}"
                                ToolTip="Tillbaka" AutomationProperties.Name="Tillbaka">
                            <controls:GridIcon Size="16" Data="{StaticResource Icon.Back}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Command="{Binding CloseCommand}"
                                ToolTip="Stäng (Esc)" AutomationProperties.Name="Stäng" Margin="6,0,0,0">
                            <controls:GridIcon Size="16" Data="{StaticResource Icon.Close}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Graph}" Height="28" Padding="10,0"
                                FontSize="13" Background="Transparent" Command="{Binding OpenInGuideCommand}"
                                ToolTip="Öppna i Guide (F1)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Öppna i Guide" VerticalAlignment="Center" />
                                <controls:GridIcon Size="13" Data="{StaticResource Icon.Open}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <controls:GridIcon Size="14" Data="{StaticResource Icon.Guide}" Foreground="{StaticResource Brush.TextDim}" />
                            <TextBlock Text="{Binding HeaderText}" FontSize="13" Foreground="{StaticResource Brush.TextDim}"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!--
                  The answer for what is chosen, always at the top with the accent at its left, outside the section's
                  scrolling, so that the section can open at its marked heading while the answer stays in view. A long
                  answer scrolls on its own.
                -->
                <Border DockPanel.Dock="Top" Padding="14,12" CornerRadius="10" Margin="26,20,26,0"
                        Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.Accent}"
                        BorderThickness="2,0,0,0"
                        Visibility="{Binding Page.HasPlainAnswers, Converter={StaticResource VisibleWhen},
                                             FallbackValue=Collapsed}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Page.Label}" FontSize="12.5" Margin="0,0,0,5"
                                   Foreground="{StaticResource Brush.TextDim}" TextTrimming="CharacterEllipsis" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="220">
                            <ItemsControl ItemsSource="{Binding Page.Answers}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type guide:GuideAnswer}">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Text}" FontSize="14" LineHeight="21"
                                                       TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}"
                                                       Opacity="0.85" />
                                            <Button Style="{StaticResource Button.Link}" Content="{Binding LinkText}"
                                                    Margin="0,2,0,0" CommandParameter="{Binding Link}"
                                                    Visibility="{Binding HasLink, Converter={StaticResource VisibleWhen}}"
                                                    Command="{Binding DataContext.GoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!--
                  Varför? for a line's value (sketch KU1a): what it rests on, step by step on a thread, each rate with
                  the SHA-256 of its sealed answer, and the calculation; the section on rates opens under it.
                -->
                <Border DockPanel.Dock="Top" Margin="26,20,26,0" Padding="16,14" CornerRadius="10"
                        Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.Accent}"
                        BorderThickness="2,0,0,0"
                        Visibility="{Binding Page.HasValuation, Converter={StaticResource VisibleWhen},
                                             FallbackValue=Collapsed}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <controls:GridIcon DockPanel.Dock="Left" Size="18" Data="{StaticResource Icon.Why}"
                                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Top"
                                               Margin="0,1,10,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Page.Label}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}" />
                                <TextBlock Text="{Binding Page.Answers[0].Text}" FontSize="12.5" Margin="0,2,0,0"
                                           TextWrapping="Wrap" Foreground="{StaticResource Brush.TextDim}" />
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="420">
                            <ItemsControl ItemsSource="{Binding Page.Valuation.Parts}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type guide:GuideValuationPart}">
                                        <Grid Margin="0,0,0,10">
                                            <!-- The thread that ties the steps together, behind their marks. -->
                                            <Border Width="1.5" HorizontalAlignment="Left" Margin="12.25,14,0,40"
                                                    Background="{StaticResource Brush.BorderStrong}" />
                                            <StackPanel>
                                                <ContentControl Content="{Binding Amount}" Focusable="False"
                                                                ContentTemplate="{StaticResource Valuation.Step}" />
                                                <ContentControl Content="{Binding CryptoRate}" Focusable="False"
                                                                ContentTemplate="{StaticResource Valuation.Step}" />
                                                <ContentControl Content="{Binding FiatRate}" Focusable="False"
                                                                ContentTemplate="{StaticResource Valuation.Step}"
                                                                Visibility="{Binding HasFiatRate, Converter={StaticResource VisibleWhen}}" />
                                                <Border Margin="38,0,0,0" Padding="12,10" CornerRadius="8"
                                                        Background="{StaticResource Brush.Background}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Formula}" FontSize="12"
                                                                   FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource Brush.TextMuted}" />
                                                        <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold"
                                                                   Margin="0,4,0,0" Foreground="{StaticResource Brush.Text}" />
                                                        <TextBlock Text="{Binding Exact}" FontSize="11.5"
                                                                   Foreground="{StaticResource Brush.TextDim}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!--
                  Varför? for a replaced anchor (sketch AK1a): that the file is untouched, the chain as dots with the
                  anchor in yellow and the file's head in green, and the likely cause as a dashed tag (an assessment,
                  principle 2) with what else it can be; the section on anchors opens under it.
                -->
                <Border DockPanel.Dock="Top" Margin="26,20,26,0" Padding="16,14" CornerRadius="10"
                        Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.Pending}"
                        BorderThickness="2,0,0,0"
                        Visibility="{Binding Page.HasAnchorChange, Converter={StaticResource VisibleWhen},
                                             FallbackValue=Collapsed}">
                    <StackPanel DataContext="{Binding Page.AnchorChange}">
                        <DockPanel>
                            <controls:GridIcon DockPanel.Dock="Left" Size="18" Data="{StaticResource Icon.Why}"
                                               Foreground="{StaticResource Brush.Pending}" VerticalAlignment="Top"
                                               Margin="0,1,10,0" />
                            <TextBlock Text="{Binding Heading}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.TextDim}" />
                        </DockPanel>
                        <DockPanel Margin="28,10,0,0">
                            <controls:GridIcon DockPanel.Dock="Left" Size="14" Data="{StaticResource Icon.ShieldCheck}"
                                               Foreground="{StaticResource Brush.Success}" VerticalAlignment="Top"
                                               Margin="0,2,8,0" />
                            <TextBlock Text="{Binding ChainText}" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.Text}" />
                        </DockPanel>

                        <!-- The chain as dots: the rows before, the anchor in yellow, the file's head in green. -->
                        <Grid Margin="28,16,0,0" Height="16">
                            <Line X1="0" X2="1" Stretch="Fill" VerticalAlignment="Center" StrokeThickness="1.5"
                                  StrokeDashArray="1 3" Stroke="{StaticResource Brush.BorderStrong}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.TextDim}" Margin="0,0,14,0" />
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.TextDim}" Margin="0,0,14,0" />
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.TextDim}" Margin="0,0,14,0" />
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.TextDim}" />
                            </StackPanel>
                            <Grid HorizontalAlignment="Right" Width="200">
                                <Ellipse Width="12" Height="12" HorizontalAlignment="Left" Fill="{StaticResource Brush.Pending}" />
                                <Ellipse Width="12" Height="12" HorizontalAlignment="Right" Fill="{StaticResource Brush.Success}" />
                            </Grid>
                        </Grid>
                        <Grid Margin="28,6,0,0" HorizontalAlignment="Right" Width="260">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel DataContext="{Binding Before}">
                                <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.Pending}">
                                    <Run Text="{Binding Role, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Who, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Row, StringFormat='rad {0}'}" FontSize="12.5"
                                           Foreground="{StaticResource Brush.Text}" />
                                <TextBlock Text="{Binding Hash}" FontSize="11.5" FontFamily="{StaticResource Font.Mono}"
                                           Foreground="{StaticResource Brush.TextMuted}" ToolTip="{Binding FullHash}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" DataContext="{Binding After}" HorizontalAlignment="Right">
                                <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.Success}" TextAlignment="Right">
                                    <Run Text="{Binding Role, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Who, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Row, StringFormat='rad {0}'}" FontSize="12.5" TextAlignment="Right"
                                           Foreground="{StaticResource Brush.Text}" />
                                <TextBlock Text="{Binding Hash}" FontSize="11.5" FontFamily="{StaticResource Font.Mono}"
                                           TextAlignment="Right" Foreground="{StaticResource Brush.TextMuted}"
                                           ToolTip="{Binding FullHash}" />
                            </StackPanel>
                        </Grid>

                        <!-- The likely cause: dashed, since Chainsaw sees only the file and the anchor. -->
                        <Grid Margin="28,16,0,0" HorizontalAlignment="Left">
                            <Rectangle RadiusX="11" RadiusY="11" StrokeThickness="1.5" StrokeDashArray="3 3"
                                       Stroke="{StaticResource Brush.Pending}" />
                            <TextBlock Margin="12,3" FontSize="12" Foreground="{StaticResource Brush.Pending}"
                                       ToolTip="En bedömning: Chainsaw ser bara filen och ankaret">
                                <Run Text="Troligast: " /><Run Text="{Binding CauseShort, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding CauseName}" FontSize="14" FontWeight="SemiBold" Margin="28,10,0,0"
                                   Foreground="{StaticResource Brush.Text}" />
                        <TextBlock Text="{Binding What}" FontSize="12.5" Margin="28,4,0,0" TextWrapping="Wrap"
                                   LineHeight="18" Foreground="{StaticResource Brush.TextMuted}" />
                        <TextBlock FontSize="12.5" Margin="28,8,0,0" TextWrapping="Wrap" LineHeight="18"
                                   Foreground="{StaticResource Brush.TextMuted}">
                            <Run Text="Vad du kan göra. " Foreground="{StaticResource Brush.Text}" /><Run Text="{Binding Todo, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Also}" FontSize="12" Margin="28,8,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextDim}" />
                    </StackPanel>
                </Border>

                <!-- A line that sums several transfers ends with its total. -->
                <Border DockPanel.Dock="Top" Margin="26,8,26,0" Padding="16,8" CornerRadius="8"
                        Background="{StaticResource Brush.SurfaceRaised}"
                        Visibility="{Binding Page.Valuation.HasSeveralParts, Converter={StaticResource VisibleWhen},
                                             FallbackValue=Collapsed}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Linjen" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextDim}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Page.Valuation.Exact}" FontSize="11.5"
                                   VerticalAlignment="Center" Foreground="{StaticResource Brush.TextDim}" />
                        <TextBlock Text="{Binding Page.Valuation.Total, StringFormat='= {0}'}" FontSize="16"
                                   FontWeight="SemiBold" Margin="12,0" Foreground="{StaticResource Brush.Text}" />
                    </DockPanel>
                </Border>

                <Grid>
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False"
                                  ScrollChanged="OnScrollChanged">
                        <controls:GuideDocumentView Compact="True" Margin="26,20,26,40" Section="{Binding Page.Section}"
                                                    Anchor="{Binding Page.Anchor}" Library="{Binding Library}"
                                                    LinkCommand="{Binding GoCommand}" />
                    </ScrollViewer>

                    <!--
                      The text fades out at the bottom while there is more below, instead of a hard cut; the scroll bar
                      stays clear of it, and it is gone at the end.
                    -->
                    <Border x:Name="MoreBelow" Height="64" VerticalAlignment="Bottom" Margin="0,0,12,0"
                            IsHitTestVisible="False" Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="{StaticResource Color.Surface.Clear}" />
                                <GradientStop Offset="1" Color="{StaticResource Color.Surface}" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
