<UserControl x:Class="Chainsaw.App.Views.GuidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:guide="clr-namespace:Chainsaw.App.Guide"
             Width="440" HorizontalAlignment="Right">

    <!--
      The Guide beside the work (sketch GD1b): a panel from the right over the inspector; the rest is neither darkened
      nor blocked. The arrow goes back through what was read, Öppna i Guide takes the section to the view (F1), and
      × and Esc close.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <!-- The shadow lies in a layer of its own, as under the pill, so that the text is not blurred. -->
        <Border Background="{StaticResource Brush.Surface}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Direction="180" Opacity="0.35" Color="Black" />
            </Border.Effect>
        </Border>
        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.BorderStrong}"
                BorderThickness="1,0,0,0">
            <DockPanel>
                <!-- The header: back, the group, Öppna i Guide and close. -->
                <Border DockPanel.Dock="Top" Height="48" Padding="8,0,10,0" BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource Button.Icon}" Command="{Binding BackCommand}"
                                ToolTip="Tillbaka" AutomationProperties.Name="Tillbaka">
                            <controls:GridIcon Size="16" Data="{StaticResource Icon.Back}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Command="{Binding CloseCommand}"
                                ToolTip="Stäng (Esc)" AutomationProperties.Name="Stäng" Margin="6,0,0,0">
                            <controls:GridIcon Size="16" Data="{StaticResource Icon.Close}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Graph}" Height="28" Padding="10,0"
                                FontSize="13" Background="Transparent" Command="{Binding OpenInGuideCommand}"
                                ToolTip="Öppna i Guide (F1)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Öppna i Guide" VerticalAlignment="Center" />
                                <controls:GridIcon Size="13" Data="{StaticResource Icon.Open}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <controls:GridIcon Size="14" Data="{StaticResource Icon.Guide}" Foreground="{StaticResource Brush.TextDim}" />
                            <TextBlock Text="{Binding HeaderText}" FontSize="13" Foreground="{StaticResource Brush.TextDim}"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!--
                  The answer for what is chosen, always at the top with the accent at its left, outside the section's
                  scrolling, so that the section can open at its marked heading while the answer stays in view. A long
                  answer scrolls on its own.
                -->
                <Border DockPanel.Dock="Top" Padding="14,12" CornerRadius="10" Margin="26,20,26,0"
                        Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.Accent}"
                        BorderThickness="2,0,0,0"
                        Visibility="{Binding Page.HasAnswers, Converter={StaticResource VisibleWhen},
                                             FallbackValue=Collapsed}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Page.Label}" FontSize="12.5" Margin="0,0,0,5"
                                   Foreground="{StaticResource Brush.TextDim}" TextTrimming="CharacterEllipsis" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="220">
                            <ItemsControl ItemsSource="{Binding Page.Answers}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type guide:GuideAnswer}">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Text}" FontSize="14" LineHeight="21"
                                                       TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}"
                                                       Opacity="0.85" />
                                            <Button Style="{StaticResource Button.Link}" Content="{Binding LinkText}"
                                                    Margin="0,2,0,0" CommandParameter="{Binding Link}"
                                                    Visibility="{Binding HasLink, Converter={StaticResource VisibleWhen}}"
                                                    Command="{Binding DataContext.GoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <controls:GuideDocumentView Compact="True" Margin="26,20,26,40" Section="{Binding Page.Section}"
                                                Anchor="{Binding Page.Anchor}" Library="{Binding Library}"
                                                LinkCommand="{Binding GoCommand}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
