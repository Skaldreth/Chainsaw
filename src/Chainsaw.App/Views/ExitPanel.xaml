<UserControl x:Class="Chainsaw.App.Views.ExitPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:exits="clr-namespace:Chainsaw.App.Exits"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             Width="300" Focusable="False" KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="OnKey">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- The colour of the route's state: green while lookups can go, red while they cannot. -->
        <Style x:Key="StateFill" TargetType="Shape">
            <Setter Property="Fill" Value="{StaticResource Brush.Error}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A line of the route: green and whole while lookups can go, red and dashed while they cannot. -->
        <Style x:Key="RouteLine" TargetType="Line">
            <Setter Property="X1" Value="0" />
            <Setter Property="X2" Value="1" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Height" Value="2" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Stroke" Value="{StaticResource Brush.Error}" />
            <Setter Property="StrokeDashArray" Value="2 1.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource Brush.Success}" />
                    <Setter Property="StrokeDashArray" Value="{x:Null}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A stop at an end of the route (the computer, the chains): a quiet ring on the raised surface. -->
        <Style x:Key="SideRing" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
        </Style>

        <!-- The label under a stop at an end of the route. -->
        <Style x:Key="SideLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>

        <!-- The round power button of an exit: filled while the exit is on, no frame (sketch UT2b). -->
        <Style x:Key="PowerButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="1.5" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.BorderStrong}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The row at the foot that opens the settings: muted, the whole width, hover on the surface. -->
        <Style x:Key="FootButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- The inner corners follow the panel's, so that the hover never leaves its rounded foot. -->
                        <Border x:Name="Box" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                CornerRadius="0,0,12.5,12.5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          An exit in the vault: the dot of its state (green when connected), its name and the round power button. What
          went wrong is not written on the row; the red dot says it, and the words come on hover (principle 7).
        -->
        <DataTemplate x:Key="ExitRow" DataType="{x:Type vm:ExitRowViewModel}">
            <Border x:Name="Row" Height="48" CornerRadius="8" Background="Transparent" Padding="14,0,8,0"
                    ToolTip="{Binding Word}" ToolTipService.IsEnabled="{Binding HasWord}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource Brush.TextDim}" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="Power" Grid.Column="2" Style="{StaticResource PowerButton}" Margin="12,0,0,0"
                            Command="{Binding DataContext.PowerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" ToolTip="{Binding ActionText}"
                            AutomationProperties.Name="{Binding ActionName}">
                        <controls:GridIcon Size="17" Data="{StaticResource Icon.Power}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter TargetName="Power" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                    <Setter TargetName="Power" Property="Foreground" Value="{StaticResource Brush.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static exits:ExitRowState.Connected}">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static exits:ExitRowState.Connecting}">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Pending}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static exits:ExitRowState.Failed}">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Error}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!--
      The exits' panel (sketch UT2b), folded out under the exit in the title bar: the route as a large picture (the
      computer, the exit in a large ring in the colour of its state, the chains), with VPN the exits in the vault, and at
      the foot the way to the settings, where the way out is chosen and a WireGuard file is added.
    -->
    <Grid>
        <!-- The shadow lies in a layer of its own, as under the command bar, so that it never blurs the text. -->
        <Border CornerRadius="14" Background="{StaticResource Brush.Floating}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="14" Background="{StaticResource Brush.Floating}" BorderBrush="{StaticResource Brush.BorderStrong}"
                BorderThickness="1.5">
            <StackPanel>
                <!-- The route: the computer, the exit and the chains. The colour says the state; no words under it. -->
                <Grid Margin="22,22,22,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource SideRing}" ToolTip="Chainsaw på den här datorn">
                        <controls:GridIcon Size="18" Data="{StaticResource Icon.Laptop}" Foreground="{StaticResource Brush.TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="1" Text="Datorn" Style="{StaticResource SideLabel}" />

                    <Line Grid.Column="1" Style="{StaticResource RouteLine}" />

                    <!-- The exit: a large ring and its icon in the state's colour, over a faint tone of the same. -->
                    <Grid Grid.Column="2" Width="60" Height="60">
                        <Ellipse Style="{StaticResource StateFill}" Opacity="0.08" />
                        <Ellipse StrokeThickness="2">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Stroke" Value="{StaticResource Brush.Error}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <!-- The exit's globe, or Windows' screen when lookups go through the computer's own network. -->
                        <controls:GridIcon Size="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:GridIcon.Style>
                                <Style TargetType="controls:GridIcon">
                                    <Setter Property="Data" Value="{StaticResource Icon.Globe}" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWindowsMode}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource Icon.Monitor}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:GridIcon.Style>
                        </controls:GridIcon>
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RouteText}" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,7,0,0" MaxWidth="120"
                               TextTrimming="CharacterEllipsis" />

                    <Line Grid.Column="3" Style="{StaticResource RouteLine}" />

                    <Border Grid.Column="4" Style="{StaticResource SideRing}" ToolTip="Källorna för blockkedjorna">
                        <controls:GridIcon Size="18" Data="{StaticResource Icon.Server}" Foreground="{StaticResource Brush.TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Blockkedjor" Style="{StaticResource SideLabel}" />
                </Grid>

                <!-- With VPN: the exits in the vault. With Windows there is no list at all (sketch UT2b). -->
                <StackPanel Visibility="{Binding IsVpnMode, Converter={StaticResource Visible}}">
                    <Border Height="1.5" Background="{StaticResource Brush.Submenu}" />
                    <ItemsControl Margin="6" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ExitRow}"
                                  Focusable="False" AutomationProperties.Name="Utgångar" />
                    <TextBlock Text="Inga utgångar i valvet" FontSize="13" Foreground="{StaticResource Brush.TextDim}"
                               Margin="20,4,20,14" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                </StackPanel>

                <!-- What went wrong last, in plain words. -->
                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Error}" FontSize="13" Margin="20,0,20,12"
                           TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />

                <!-- The way to the settings' page Nätverk: the way out, and adding a WireGuard file. -->
                <Border Height="1.5" Background="{StaticResource Brush.Submenu}" />
                <Button x:Name="SettingsButton" Style="{StaticResource FootButton}" Command="{Binding OpenSettingsCommand}">
                    <DockPanel>
                        <controls:GridIcon DockPanel.Dock="Left" Size="16" Data="{StaticResource Icon.Settings}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="Ctrl+," FontSize="12" Foreground="{StaticResource Brush.TextDim}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Inställningar för anslutning" FontSize="13" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
