<UserControl x:Class="Chainsaw.App.Views.RequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:RequestsViewModel}"
             mc:Ignorable="d" Focusable="True" FocusVisualStyle="{x:Null}">

    <!--
      The view Begäran (sketch BG1b): to the left every cash-out traced money reached in the case, with the chain, the
      deposits and their sum, and a green mark where a request is exported; under them Exporterade with SHA-256. To the
      right Ta med (the deposits and the trail as chips), Exportera .md … and the request as a large preview of the very
      blocks the file is written from. Only wiring; what happens lives in RequestsViewModel.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A row of the list: a frame only on the chosen row, a soft ground on hover (sketch BG1b). -->
        <Style x:Key="Row" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Padding="10,9" CornerRadius="8" BorderThickness="1"
                                BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          A chip under Ta med (sketch BG1b): round ends, the accent's edge when taken along, a whole edge for traced
          money and a dashed one for another deposit to the address, since dashed always means uncertain.
        -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="Ground" RadiusX="13" RadiusY="13" Fill="{StaticResource Brush.Surface}" />
                            <Rectangle x:Name="Edge" RadiusX="13" RadiusY="13" StrokeThickness="1" SnapsToDevicePixels="True"
                                       Stroke="{StaticResource Brush.BorderStrong}" />
                            <ContentPresenter Margin="9,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="Ground" Property="Fill" Value="{StaticResource Brush.SurfaceRaised}" />
                                <Setter TargetName="Edge" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsTraced}" Value="False">
                                <Setter TargetName="Edge" Property="StrokeDashArray" Value="3 2" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Edge" Property="Stroke" Value="{StaticResource Brush.TextDim}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Edge" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The chip's dot: the accent for traced money, faint for the rest. -->
        <Style x:Key="ChipDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Fill" Value="{StaticResource Brush.TextFaint}" />
        </Style>

        <!-- The chip's words: bright when taken along, dimmed when not. -->
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Nothing is reached yet: said honestly, with the view's icon, never with made-up rows. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80" MaxWidth="420"
                    Visibility="{Binding HasExits, Converter={x:Static controls:InvertVisibility.Instance}}">
            <controls:GridIcon Size="40" Foreground="{StaticResource Brush.TextFaint}" HorizontalAlignment="Center"
                               Data="{StaticResource Icon.Request}" />
            <TextBlock Text="{x:Static vm:RequestsViewModel.EmptyText}" FontSize="13.5" Margin="0,14,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="21"
                       Foreground="{StaticResource Brush.TextDim}" />
        </StackPanel>

        <Grid Margin="84,16,20,24" Visibility="{Binding HasExits, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== The list of cash-outs, and the exported requests under it. ===== -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{Binding CountText}" FontSize="12" Margin="4,0,4,10"
                           Foreground="{StaticResource Brush.TextDim}" />

                <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border}"
                        Padding="0,10,0,0" Margin="0,10,0,0"
                        Visibility="{Binding HasExports, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Exporterade" FontSize="11.5" Margin="4,0,4,4"
                                   Foreground="{StaticResource Brush.TextDim}" />
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Exports}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ExportRow}">
                                        <StackPanel Margin="6,6" ToolTip="{Binding ToolTip}">
                                            <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource Brush.Text}" />
                                            <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource Brush.TextFaint}">
                                                <Run Text="{Binding When, Mode=OneWay}" /><Run Text=" · SHA-256 " /><Run
                                                    Text="{Binding ShortSha, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Exits}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RequestExitRowViewModel}">
                                    <Button Style="{StaticResource Row}" ToolTip="{Binding Exit.Look.Name}"
                                            Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <DockPanel>
                                            <!-- The sort's square, as in the graph: blue for a cash-out, ice for a freeze. -->
                                            <Grid DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,10,0">
                                                <Rectangle x:Name="Frame" RadiusX="7" RadiusY="7" StrokeThickness="1.5"
                                                           Stroke="{StaticResource Brush.Kind.CashOut}" />
                                                <controls:GridIcon x:Name="Glyph" Size="14" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Brush.Kind.CashOut}"
                                                                   Data="{Binding Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                                            </Grid>
                                            <Grid DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                                  Background="Transparent" ToolTip="{Binding ExportedText}"
                                                  Visibility="{Binding IsExported, Converter={StaticResource Visible}}">
                                                <controls:GridIcon Size="15" Foreground="{StaticResource Brush.Success}"
                                                                   Data="{StaticResource Icon.Request}" />
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource Brush.Text}" />
                                                <TextBlock Text="{Binding Summary}" FontSize="11.5" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource Brush.TextDim}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDashed}" Value="True">
                                            <Setter TargetName="Frame" Property="StrokeDashArray" Value="2.5 1.5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFreeze}" Value="True">
                                            <Setter TargetName="Frame" Property="Stroke" Value="{StaticResource Brush.Mark.Freeze}" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Mark.Freeze}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Static vm:RequestsViewModel.HintText}" FontSize="11.5" Margin="4,6,4,0"
                                   TextWrapping="Wrap" LineHeight="17" Foreground="{StaticResource Brush.TextFaint}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ===== The chosen request: what is taken along, the export, and the preview. ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="Ta med" FontSize="12" Margin="0,5,10,0" VerticalAlignment="Top"
                               Foreground="{StaticResource Brush.TextDim}" />

                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Height="30" Padding="12,0"
                            VerticalAlignment="Top" Command="{Binding ExportCommand}" ToolTip="Exportera .md … · Ctrl+S">
                        <StackPanel Orientation="Horizontal">
                            <controls:GridIcon Size="14" Margin="0,0,7,0" Foreground="{StaticResource Brush.OnAccent}"
                                               Data="{StaticResource Icon.Download}" />
                            <TextBlock Text="Exportera .md …" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Graph}" Height="30" FontSize="12.5"
                            Margin="0,0,8,0" VerticalAlignment="Top" Command="{Binding ToggleLanguageCommand}"
                            Content="{Binding LanguageText}"
                            ToolTip="Språket i begäran: svenska eller engelska. Klicka för att byta." />

                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DepositChipViewModel}">
                                    <Button Style="{StaticResource Chip}" ToolTip="{Binding ToolTip}"
                                            Command="{Binding DataContext.ToggleDepositCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="Dot" Style="{StaticResource ChipDot}" />
                                            <TextBlock x:Name="Words" Text="{Binding Text}" Style="{StaticResource ChipText}" />
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsTraced}" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                            <Setter TargetName="Words" Property="Foreground" Value="{StaticResource Brush.Text}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The trail in one sentence, never with the victim's name; shown only where one reaches. -->
                        <Button Style="{StaticResource Chip}" Command="{Binding ToggleTrailCommand}"
                                ToolTip="Spåret dit i en mening, utan offrets namn"
                                Visibility="{Binding HasTrail, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource ChipDot}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTrailOn}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="Spåret dit">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTrailOn}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </DockPanel>

                <!-- The request as the file will hold it (sketch BG1b). -->
                <Border Grid.Row="1" Padding="34,26" CornerRadius="10" BorderThickness="1"
                        BorderBrush="{StaticResource Brush.Border}" Background="{StaticResource Brush.Surface}">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                                      Visibility="{Binding HasDocument, Converter={StaticResource Visible}}">
                            <controls:RequestPreview Document="{Binding Document}" />
                        </ScrollViewer>
                        <TextBlock Text="{Binding Problem}" FontSize="13" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{StaticResource Brush.TextDim}"
                                   Visibility="{Binding HasDocument, Converter={x:Static controls:InvertVisibility.Instance}}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextFaint}"
                               Text="Förhandsvisning av filen. Markdown, som öppnas i vilket program som helst och klistras in i en begäran." />
                    <TextBlock Text="{Binding ContactText}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.TextFaint}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
