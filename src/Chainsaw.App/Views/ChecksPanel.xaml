<UserControl x:Class="Chainsaw.App.Views.ChecksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ChecksViewModel}"
             mc:Ignorable="d">

    <!--
      Kontroller och förslag (sketch KF2b), folded out where the inspector stands: the overview with "Gå igenom N att
      avgöra", one suggestion at a time with the decision bar at the bottom, or "Allt avgjort" with the ring and the log.
      K and the arrows step, J is Senare, Enter approves, X dismisses, ? asks why and Ctrl+Z takes back; the keys work in
      the graph. Only wiring; what happens lives in ChecksViewModel.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A row in the overview and the log: no frame, a soft surface on hover. -->
        <Style x:Key="Panel.Row" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Floating}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A candidate in the ranked table: a click chooses it; the chosen one stands on the raised surface. -->
        <Style x:Key="Panel.Candidate" TargetType="Button" BasedOn="{StaticResource Panel.Row}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A quiet button with a thin frame: Avfärda and the header's arrows. -->
        <Style x:Key="Panel.Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A group's heading: small capitals with the count. -->
        <Style x:Key="Panel.GroupName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A key hint after a button's text. -->
        <Style x:Key="Panel.Key" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="Margin" Value="7,1,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A rounded square with the analysis's icon: dashed while it is a suggestion, whole for a check. -->
        <DataTemplate x:Key="Badge" DataType="{x:Type vm:CheckRowViewModel}">
            <Grid Width="26" Height="26">
                <Rectangle x:Name="Frame" RadiusX="7" RadiusY="7" StrokeThickness="1.5"
                           Stroke="{Binding Look.TintKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                <controls:GridIcon Size="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding Look.TintKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}"
                                   Data="{Binding Look.Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Group}" Value="{x:Static vm:CheckRowGroup.ToDecide}">
                    <Setter TargetName="Frame" Property="StrokeDashArray" Value="2 1.6" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A row in the overview: the badge, the title with its short muted word, and the count. -->
        <DataTemplate x:Key="OverviewRow" DataType="{x:Type vm:CheckRowViewModel}">
            <Button Style="{StaticResource Panel.Row}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" ToolTip="{Binding Summary}">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Badge}"
                                    Focusable="False" Margin="0,0,11,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13">
                        <Run Text="{Binding Title, Mode=OneWay}" />
                        <Run Text="{Binding Short, Mode=OneWay}" FontSize="12" Foreground="{StaticResource Brush.TextDim}" />
                    </TextBlock>
                </DockPanel>
            </Button>
        </DataTemplate>

        <!-- A row in the log of Allt avgjort: the badge, the title, the state with its dot and Ångra on hover. -->
        <DataTemplate x:Key="LogRow" DataType="{x:Type vm:CheckRowViewModel}">
            <Border x:Name="Box" Height="40" Padding="8,0" CornerRadius="8" Background="Transparent">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Badge}"
                                    Focusable="False" Margin="0,0,11,0" Opacity="0.8" />
                    <Button x:Name="Undo" DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Ångra"
                            FontSize="12" Foreground="{StaticResource Brush.TextMuted}" Width="38" Opacity="0"
                            VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Ta tillbaka beslutet; det förseglas"
                            Visibility="{Binding CanUndo, Converter={StaticResource Visible}}"
                            Command="{Binding DataContext.UndoRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{StaticResource Brush.TextDim}" Margin="0,1,5,0" />
                        <TextBlock x:Name="State" Text="{Binding StateText}" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Group}" Value="{x:Static vm:CheckRowGroup.Decided}">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.TextMuted}" />
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsApproved}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Success}" />
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
                <Trigger SourceName="Box" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Floating}" />
                    <Setter TargetName="Undo" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A chip under the suggestion: what it rests on, the longer text on hover. -->
        <DataTemplate x:Key="Chip" DataType="{x:Type vm:BasisChip}">
            <Border Height="22" Padding="6,0,8,0" Margin="0,0,6,6" CornerRadius="6" Background="{StaticResource Brush.SurfaceRaised}"
                    ToolTip="{Binding Tip}">
                <StackPanel Orientation="Horizontal">
                    <controls:GridIcon Size="12" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"
                                       Data="{Binding Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                    <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource Brush.TextMuted}"
                               Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A candidate in the ranked table: rank in a ring, address, amount, time, score as a bar and a number. -->
        <DataTemplate x:Key="CandidateRow" DataType="{x:Type vm:CandidateRowViewModel}">
            <Button x:Name="Row" Style="{StaticResource Panel.Candidate}"
                    Command="{Binding DataContext.ChooseCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" ToolTip="{Binding Candidate.Reason}">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,10,0">
                        <Ellipse x:Name="Ring" StrokeThickness="1.5" Stroke="{StaticResource Brush.TextFaint}" />
                        <TextBlock x:Name="Rank" Text="{Binding RankText}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="64" HorizontalAlignment="Right">
                        <Border Width="28" Height="4" CornerRadius="2" Background="{StaticResource Brush.SurfaceSelected}"
                                VerticalAlignment="Center" Margin="0,0,6,0">
                            <Border x:Name="Bar" Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="2"
                                    Background="{StaticResource Brush.TextDim}" />
                        </Border>
                        <TextBlock x:Name="Score" Text="{Binding ScoreText}" Width="30" TextAlignment="Right" FontSize="12"
                                   Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Width="34" TextAlignment="Right" FontSize="12"
                               Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock x:Name="Amount" DockPanel.Dock="Right" Text="{Binding AmountText}" Width="56" TextAlignment="Right"
                               FontSize="12" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock x:Name="Address" Text="{Binding ShortAddress}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                    <Setter TargetName="Ring" Property="Fill" Value="{StaticResource Brush.Accent}" />
                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                    <Setter TargetName="Rank" Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource Brush.Accent}" />
                    <Setter TargetName="Score" Property="Foreground" Value="{StaticResource Brush.Text}" />
                    <Setter TargetName="Amount" Property="Foreground" Value="{StaticResource Brush.Text}" />
                    <Setter TargetName="Address" Property="Foreground" Value="{StaticResource Brush.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDismissed}" Value="True">
                    <Setter TargetName="Address" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A segment of the progress bar: green when decided, accent now, faint left. -->
        <DataTemplate x:Key="Segment" DataType="{x:Type vm:ProgressSegment}">
            <Border x:Name="Bar" Height="3" CornerRadius="2" Margin="2,0" ToolTip="{Binding Tip}"
                    Background="{StaticResource Brush.SurfaceSelected}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:SegmentState.Decided}">
                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:SegmentState.Current}">
                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!--
      Where the inspector stands, under the graph's sheet (sketch IN5a): the inspector's darker tone, and 18 px more room
      on the left than the content's 22, so nothing lies in the sheet's shadow.
    -->
    <DockPanel Background="{StaticResource Brush.Underlay}" Margin="18,0,0,0">
        <!-- The header: Förslag, and in a suggestion where it is in the round with the arrows; then close. -->
        <DockPanel DockPanel.Dock="Top" Height="56" Margin="22,0,12,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Panel.Ghost}" Width="30" Height="30"
                    BorderBrush="Transparent" ToolTip="Stäng · Esc" AutomationProperties.Name="Stäng"
                    Command="{Binding ToggleCommand}">
                <controls:GridIcon Size="15" Data="{StaticResource Icon.Close}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsReview, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding PositionText}" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Style="{StaticResource Panel.Ghost}" Width="28" Height="28" ToolTip="Föregående · K"
                        AutomationProperties.Name="Föregående" Command="{Binding PreviousCommand}">
                    <controls:GridIcon Size="13" Data="{StaticResource Icon.ChevronRight}" RenderTransformOrigin="0.5,0.5"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <controls:GridIcon.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </controls:GridIcon.RenderTransform>
                    </controls:GridIcon>
                </Button>
                <Button Style="{StaticResource Panel.Ghost}" Width="28" Height="28" Margin="8,0,0,0" ToolTip="Nästa"
                        AutomationProperties.Name="Nästa" Command="{Binding NextCommand}">
                    <controls:GridIcon Size="13" Data="{StaticResource Icon.ChevronRight}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Border Width="1" Height="18" Background="{StaticResource Brush.BorderStrong}" Margin="8,0,2,0" />
            </StackPanel>
            <TextBlock Text="Förslag" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                       ToolTip="{Binding StatusText}" />
        </DockPanel>

        <!-- What went wrong, honestly, only when something did. -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding Problem}" FontSize="12.5" Foreground="{StaticResource Brush.Error}"
                   TextWrapping="Wrap" Margin="22,0,22,10">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid>
            <!-- ===== One suggestion at a time ===== -->
            <DockPanel Visibility="{Binding IsReview, Converter={StaticResource Visible}}">
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Segments}" ItemTemplate="{StaticResource Segment}"
                              Focusable="False" Margin="20,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- The decision bar, fixed at the bottom in the order Avfärda, Senare, Godkänn. -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Floating}" BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0" Padding="22,14,22,18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource Panel.Ghost}" Height="40" Margin="0,0,4,0"
                                    ToolTip="{Binding Selected.DismissTip}" AutomationProperties.Name="Avfärda"
                                    Command="{Binding DismissCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Selected.DismissText}" />
                                    <TextBlock Text="X" Style="{StaticResource Panel.Key}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource Panel.Ghost}" Height="40" Margin="4,0"
                                    BorderBrush="Transparent" ToolTip="Vänta med beslutet; förslaget läggs sist i kön · J"
                                    AutomationProperties.Name="Senare" Command="{Binding LaterCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Senare" />
                                    <TextBlock Text="J" Style="{StaticResource Panel.Key}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Height="40" Padding="0" Margin="4,0,0,0"
                                    Focusable="False" ToolTip="Godkänn den valda · Enter" AutomationProperties.Name="Godkänn"
                                    Command="{Binding ApproveCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:GridIcon Size="14" Data="{StaticResource Icon.Check}" Foreground="{StaticResource Brush.OnAccent}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Selected.GoText}" FontSize="13.5" VerticalAlignment="Center" />
                                    <TextBlock Text="Enter" Style="{StaticResource Panel.Key}" FontWeight="Normal"
                                               Foreground="{StaticResource Brush.OnAccent}" Opacity="0.7" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Button Style="{StaticResource Button.Link}" Content="+ Skäl, frivilligt" FontSize="12" Margin="0,10,0,0"
                                Foreground="{StaticResource Brush.TextDim}" Focusable="False"
                                ToolTip="Skälet är frivilligt och sparas med beslutet" Command="{Binding ToggleReasonCommand}" />
                        <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding Selected.Reason, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,8,0,0" Height="30" FontSize="13" Tag="Skäl, frivilligt" AutomationProperties.Name="Skäl, frivilligt"
                                 Visibility="{Binding IsReasonOpen, Converter={StaticResource Visible}}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ApproveCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                </Border>

                <!-- Gjort av sig självt, folded into one line; a click shows the overview. -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource Panel.Row}" Height="38" Padding="22,0"
                        Visibility="{Binding HasDone, Converter={StaticResource Visible}}"
                        ToolTip="Kontroller som gjorde sitt av sig själva" Command="{Binding ShowOverviewCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" Background="Transparent" BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="0,1,0,0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Floating}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <DockPanel>
                        <controls:GridIcon DockPanel.Dock="Left" Size="13" Data="{StaticResource Icon.Check}"
                                           Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <controls:GridIcon DockPanel.Dock="Right" Size="13" Data="{StaticResource Icon.ChevronRight}"
                                           Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DoneCountText}" FontSize="12"
                                   Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="Gjort av sig självt" FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Button>

                <!-- The suggestion, large. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel DataContext="{Binding Selected}" Margin="22,22,22,16">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="42" Height="42" Margin="0,0,14,0">
                                <Rectangle RadiusX="11" RadiusY="11" StrokeThickness="1.5" StrokeDashArray="2.5 2"
                                           Stroke="{Binding Look.TintKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                                <controls:GridIcon Size="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Look.TintKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}"
                                                   Data="{Binding Look.Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Meta}" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}"
                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Summary}" />
                            </StackPanel>
                        </DockPanel>

                        <controls:SuggestionFlowPicture Flow="{Binding Flow}" Margin="0,16,0,0"
                                                        Visibility="{Binding HasCandidates, Converter={StaticResource Visible}}" />

                        <ItemsControl ItemsSource="{Binding Basis}" ItemTemplate="{StaticResource Chip}" Focusable="False"
                                      Margin="0,16,0,-6" Visibility="{Binding HasBasis, Converter={StaticResource Visible}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Brush.Border}" Padding="4"
                                Margin="0,16,0,0" Visibility="{Binding HasCandidates, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <DockPanel Height="24" Margin="10,0">
                                    <TextBlock DockPanel.Dock="Right" Text="POÄNG" Width="64" TextAlignment="Right" FontSize="10.5"
                                               Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Words.TimeColumn}" Width="34" TextAlignment="Right"
                                               FontSize="10.5" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="BELOPP" Width="56" TextAlignment="Right" FontSize="10.5"
                                               Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock Text="{Binding Words.FirstColumn}" FontSize="10.5" Foreground="{StaticResource Brush.TextDim}"
                                               VerticalAlignment="Center" Margin="28,0,0,0" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Candidates}" ItemTemplate="{StaticResource CandidateRow}"
                                              Focusable="False" />
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,16,0,0">
                            <Button DockPanel.Dock="Left" Style="{StaticResource Panel.Row}" Height="24" Padding="0,0,6,0"
                                    Background="Transparent" ToolTip="Öppnar Guiden bredvid · ?" AutomationProperties.Name="Varför?"
                                    Command="{Binding DataContext.AskWhyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="18" Height="18" Margin="0,0,6,0">
                                        <Ellipse Stroke="{StaticResource Brush.BorderHover}" StrokeThickness="1" />
                                        <controls:GridIcon Size="12" Data="{StaticResource Icon.Question}"
                                                           Foreground="{StaticResource Brush.TextMuted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Varför?" FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding AnalysisText}" FontSize="11.5" Foreground="{StaticResource Brush.TextDim}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       ToolTip="Analysen och dess version; förslaget är en bedömning, aldrig ett faktum" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ===== The overview ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding IsOverview, Converter={StaticResource Visible}}">
                <StackPanel Margin="12,4,12,12">
                    <Button Style="{StaticResource Button.Primary}" Height="44" Padding="14,0" Margin="10,4,10,14"
                            HorizontalContentAlignment="Stretch" Focusable="False" ToolTip="Ett förslag i taget · Enter"
                            Command="{Binding StartReviewCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="11"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.AccentHover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <DockPanel>
                            <controls:GridIcon DockPanel.Dock="Left" Size="16" Data="{StaticResource Icon.ChevronRight}"
                                               Foreground="{StaticResource Brush.OnAccent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock DockPanel.Dock="Right" Text="Enter" FontSize="11" FontWeight="Normal" Opacity="0.7"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StartText}" FontSize="13.5" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" Height="30" Margin="10,0">
                        <Ellipse Width="7" Height="7" Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.5" StrokeDashArray="1.5 1.2"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Style="{StaticResource Panel.GroupName}" Text="ATT AVGÖRA" />
                        <TextBlock Style="{StaticResource Panel.GroupName}" Text="{Binding ToDecide.Count}" FontWeight="Normal"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ToDecide}" ItemTemplate="{StaticResource OverviewRow}" Focusable="False" />

                    <StackPanel Orientation="Horizontal" Height="30" Margin="10,4,10,0"
                                Visibility="{Binding HasDone, Converter={StaticResource Visible}}">
                        <Ellipse Width="7" Height="7" Stroke="{StaticResource Brush.TextDim}" StrokeThickness="1.5"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Style="{StaticResource Panel.GroupName}" Text="GJORT AV SIG SJÄLVT" />
                        <TextBlock Style="{StaticResource Panel.GroupName}" Text="{Binding DoneCountText}" FontWeight="Normal"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Done}" ItemTemplate="{StaticResource OverviewRow}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Allt avgjort ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding IsSettled, Converter={StaticResource Visible}}">
                <StackPanel Margin="22,40,22,12">
                    <Grid Width="76" Height="76" HorizontalAlignment="Center">
                        <controls:SegmentRing Segments="{Binding Ring}" />
                        <controls:GridIcon Size="28" Data="{StaticResource Icon.Check}" Foreground="{StaticResource Brush.Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Allt avgjort" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding SettledText}" FontSize="12.5" Foreground="{StaticResource Brush.TextMuted}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />

                    <StackPanel Margin="0,26,0,0" Visibility="{Binding HasDecided, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal" Height="30">
                            <TextBlock Style="{StaticResource Panel.GroupName}" Text="AVGJORT" />
                            <TextBlock Style="{StaticResource Panel.GroupName}" Text="{Binding Decided.Count}" FontWeight="Normal"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Decided}" ItemTemplate="{StaticResource LogRow}" Focusable="False" />
                    </StackPanel>

                    <StackPanel Margin="0,4,0,0" Visibility="{Binding HasDone, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal" Height="30">
                            <TextBlock Style="{StaticResource Panel.GroupName}" Text="GJORT AV SIG SJÄLVT" />
                            <TextBlock Style="{StaticResource Panel.GroupName}" Text="{Binding DoneCountText}" FontWeight="Normal"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Done}" ItemTemplate="{StaticResource LogRow}" Focusable="False" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
