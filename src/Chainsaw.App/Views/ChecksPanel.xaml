<UserControl x:Class="Chainsaw.App.Views.ChecksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chainsaw.App.Controls"
             xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ChecksViewModel}"
             mc:Ignorable="d">

    <!--
      The checks and suggestions (sketch KF1a), folded out where the inspector stands: Att avgöra first, Gjort av sig
      självt under, then Avgjort. The chosen row folds out its candidates and buttons. J and K step, Enter approves,
      X dismisses and ? asks why; the keys work in the graph. Only wiring; what happens lives in ChecksViewModel.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A candidate: its score as a bar and a number, its address, and the decision. -->
        <DataTemplate x:Key="Candidate" DataType="{x:Type vm:CandidateRowViewModel}">
            <Button Style="{StaticResource Button.MenuItem}" Height="26" Padding="6,0" Focusable="False"
                    Command="{Binding DataContext.ChooseCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" ToolTip="{Binding Candidate.Reason}">
                <DockPanel>
                    <Border x:Name="Bar" DockPanel.Dock="Left" Width="{Binding BarWidth}" Height="4" CornerRadius="2"
                            Background="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ScoreText}" FontSize="12.5" Margin="6,0,8,0"
                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                    <TextBlock x:Name="State" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextDim}" />
                    <TextBlock x:Name="Address" Text="{Binding ShortAddress}" FontFamily="{StaticResource Font.Mono}"
                               FontSize="12" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                    <Setter TargetName="Address" Property="Foreground" Value="{StaticResource Brush.Text}" />
                    <Setter TargetName="State" Property="Text" Value="vald" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsApproved}" Value="True">
                    <Setter TargetName="State" Property="Text" Value="godkänd" />
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDismissed}" Value="True">
                    <Setter TargetName="State" Property="Text" Value="avfärdad" />
                    <Setter TargetName="Address" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="Bar" Property="Opacity" Value="0.3" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A row: the icon in a dashed (waits) or whole (done) ring, the title, the line under and the count. -->
        <DataTemplate x:Key="Row" DataType="{x:Type vm:CheckRowViewModel}">
            <Border x:Name="Box" CornerRadius="8" Padding="8,7" Margin="0,0,0,3" BorderThickness="1"
                    BorderBrush="Transparent" Background="Transparent">
                <StackPanel>
                    <Button Style="{StaticResource Button.MenuItem}" Height="Auto" Padding="0" Focusable="False"
                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="24" Height="24" VerticalAlignment="Top" Margin="0,1,9,0">
                                <Ellipse x:Name="Ring" StrokeThickness="1.2"
                                         Stroke="{Binding Look.TintKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                                <controls:GridIcon Size="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Look.TintKey, Converter={x:Static controls:ResourceKeyConverter.Instance}}"
                                                   Data="{Binding Look.Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                            </Grid>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="13" VerticalAlignment="Top"
                                       Foreground="{StaticResource Brush.Accent}" Margin="6,2,0,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <StackPanel x:Name="Open" Visibility="Collapsed" Margin="33,8,0,0">
                        <ItemsControl ItemsSource="{Binding Candidates}" ItemTemplate="{StaticResource Candidate}" Focusable="False" />
                        <TextBox x:Name="Reason" Style="{StaticResource TextBox.Field}" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,6,0,0" Height="28" FontSize="13" ToolTip="Skäl, valfritt"
                                 Visibility="{Binding CanDecide, Converter={StaticResource Visible}}"
                                 AutomationProperties.Name="Skäl, valfritt">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding AnalysisText}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextDim}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource Button.Graph}" Height="26" Padding="9,0" Margin="0,0,6,0"
                                        Focusable="False" ToolTip="Enter"
                                        Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding GoText}" FontSize="13" />
                                        <TextBlock Text="Enter" FontSize="11.5" Margin="6,1,0,0" Foreground="{StaticResource Brush.TextDim}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Graph}" Height="26" Padding="9,0" Margin="0,0,6,0"
                                        Focusable="False" ToolTip="Avfärda · X" AutomationProperties.Name="Avfärda"
                                        Visibility="{Binding CanDecide, Converter={StaticResource Visible}}"
                                        Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Avfärda" FontSize="13" />
                                        <TextBlock Text="X" FontSize="11.5" Margin="6,1,0,0" Foreground="{StaticResource Brush.TextDim}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Icon}" Width="26" Height="26" Focusable="False"
                                        ToolTip="Varför? · ?" AutomationProperties.Name="Varför?"
                                        Command="{Binding DataContext.AskWhyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <controls:GridIcon Size="14" Foreground="{StaticResource Brush.Accent}" Data="{StaticResource Icon.Why}" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSuggestion}" Value="True">
                    <Setter TargetName="Ring" Property="StrokeDashArray" Value="2.5 2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                    <Setter TargetName="Open" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A group's heading: a dashed or whole dot, the name and the count. -->
        <Style x:Key="GroupName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="Margin" Value="8,0,0,6" />
        </Style>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource Brush.Surface}">
        <!-- The keys, at the bottom. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,9">
            <StackPanel>
                <TextBlock FontSize="12" Foreground="{StaticResource Brush.TextDim}"
                           Text="J K stega · Enter godkänn · X avfärda · ? varför" />
                <TextBlock FontSize="12" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"
                           Text="{Binding StatusText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="10,16,10,12">
                <DockPanel Margin="8,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="26" Height="26"
                            ToolTip="Stäng · Ctrl+J" AutomationProperties.Name="Stäng" Command="{Binding ToggleCommand}">
                        <controls:GridIcon Size="14" Data="{StaticResource Icon.Close}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <TextBlock Text="Kontroller och förslag" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding Problem}" FontSize="12.5" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap"
                           Margin="8,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Stroke="{StaticResource Brush.Accent}" StrokeDashArray="2 1.5" Margin="8,0,0,6" />
                    <TextBlock Style="{StaticResource GroupName}" Text="Att avgöra" />
                    <TextBlock Style="{StaticResource GroupName}" Text="{Binding ToDecide.Count}" Foreground="{StaticResource Brush.TextDim}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ToDecide}" ItemTemplate="{StaticResource Row}" Focusable="False" />
                <TextBlock Text="Inget väntar på beslut." FontSize="12.5" Foreground="{StaticResource Brush.TextDim}" Margin="8,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToDecide.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Ellipse Width="8" Height="8" Stroke="{StaticResource Brush.TextDim}" Margin="8,0,0,6" />
                    <TextBlock Style="{StaticResource GroupName}" Text="Gjort av sig självt" />
                    <TextBlock Style="{StaticResource GroupName}" Text="{Binding Done.Count}" Foreground="{StaticResource Brush.TextDim}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Done}" ItemTemplate="{StaticResource Row}" Focusable="False" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Decided.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.TextDim}" Margin="8,0,0,6" />
                    <TextBlock Style="{StaticResource GroupName}" Text="Avgjort" />
                    <TextBlock Style="{StaticResource GroupName}" Text="{Binding Decided.Count}" Foreground="{StaticResource Brush.TextDim}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Decided}" ItemTemplate="{StaticResource Row}" Focusable="False" Opacity="0.75" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
