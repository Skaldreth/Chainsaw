<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      The logo: two chain links hooked into each other, lying on the diagonal (the user's reference image,
      2026-11-07). Both links are drawn upright around the origin and turned 45 degrees. Each link's end lies inside
      the other, so their sides run together in the middle; two slits in the title bar's colour cut the shared sides
      where one link passes over the other, which is what makes them read as interlocked.
    -->
    <DrawingImage x:Key="Logo.Small">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,256,256" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <DrawingGroup>
                    <DrawingGroup.Transform>
                        <TransformGroup>
                            <RotateTransform Angle="45" />
                            <TranslateTransform X="128" Y="128" />
                        </TransformGroup>
                    </DrawingGroup.Transform>
                    <GeometryDrawing Geometry="M-30,-88 A30,30 0 0 1 30,-88 L30,25 A30,30 0 0 1 -30,25 Z
                                               M-30,-25 A30,30 0 0 1 30,-25 L30,88 A30,30 0 0 1 -30,88 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource Brush.Accent}" Thickness="20" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M-48,-29 L-12,-17 M48,29 L12,17">
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource Brush.Surface}" Thickness="8" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
