<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Chainsaw.App.Controls"
                    xmlns:vm="clr-namespace:Chainsaw.App.ViewModels">

    <!-- An icon: its geometry on the 24 grid, scaled to its size, the line in the control's foreground. -->
    <Style TargetType="controls:GridIcon">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GridIcon">
                    <Viewbox Width="{TemplateBinding Size}" Height="{TemplateBinding Size}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{TemplateBinding Data}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="{Binding Stroke, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The tooltip: a small dark box, the name and the shortcut. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Brush.Floating}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      An icon in the floating pill (after Gawk's Byggare, decided 2026-11-07): 38 px and round, the name on hover in a
      tooltip, the chosen one on the selected grey. The dot in the corner is set by the pill's template.
    -->
    <Style x:Key="Button.Rail" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
        <Setter Property="ToolTipService.Placement" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="19">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The window's own buttons in the title bar: minimise, maximise, close. -->
    <Style x:Key="Button.Window" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.WindowClose" TargetType="Button" BasedOn="{StaticResource Button.Window}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.CloseHover}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      The text field of the command bar: no frame of its own (the bar is the frame), the placeholder from Tag, shown while
      the field is empty. No padding on the frame, since the TextBox pads its text itself (the rule from Gawk).
    -->
    <Style x:Key="TextBox.Command" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource Brush.TextDim}"
                                   VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed" IsHitTestVisible="False" />
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== The lock screen and the first-run setup (sketches ID7 and FS1a) ===== -->

    <!-- A text field of a form: 40 px, a grey frame that turns to the accent while the field has the keyboard. -->
    <Style x:Key="TextBox.Field" TargetType="TextBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A secret field: the same as a text field. The secret is only ever read as characters (PasswordEntry). -->
    <Style x:Key="PasswordBox.Field" TargetType="PasswordBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The lock screen's field: taller, larger dots, framed in the accent as in sketch ID7. -->
    <Style x:Key="PasswordBox.Lock" TargetType="PasswordBox" BasedOn="{StaticResource PasswordBox.Field}">
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
    </Style>

    <!-- The main button of a form: the accent, dark text, rounded; faded while it waits. -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A quiet button of a form: a grey frame and grey text, such as Tillbaka and Hoppa över. -->
    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A choice of the exit step: 52 px, left aligned, a title and a line under it (sketch FS1a). -->
    <Style x:Key="Button.Choice" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="52" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- Om Chainsaw in the lock screen's corner: plain text that gets a grey ground on hover. -->
    <Style x:Key="Button.About" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The label above a field. -->
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- The explaining line under a heading. -->
    <Style x:Key="Text.Lead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <!-- Why a step did not go on: in the error colour, hidden while empty. -->
    <Style x:Key="Text.Error" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Nytt ärende (sketch NC1a) and the first case of the setup ===== -->

    <!-- The start points: several lines in the mono font, 74 px high as in the sketch, scrolling past that. -->
    <Style x:Key="TextBox.Area" TargetType="TextBox" BasedOn="{StaticResource TextBox.Field}">
        <Setter Property="Height" Value="74" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!--
      What Chains recognises in a start point (NC1a): the chain's tag in a small frame, the value shortened and what it
      is. What is not built yet is toned; what is not recognised is in the error colour.
    -->
    <DataTemplate x:Key="StartPointLine" DataType="{x:Type vm:StartPointLine}">
        <StackPanel x:Name="Line" Orientation="Horizontal" Margin="0,6,0,0">
            <Border x:Name="Tag" BorderBrush="{StaticResource Brush.BorderHover}" BorderThickness="1" CornerRadius="6"
                    Padding="6,1" MinWidth="34" VerticalAlignment="Center">
                <TextBlock x:Name="Chain" Text="{Binding ChainLabel}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Short}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5"
                       Foreground="{StaticResource Brush.TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="Kind" Text="{Binding KindText}" FontSize="12.5" Foreground="{StaticResource Brush.TextDim}"
                       Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSupported}" Value="False">
                <Setter TargetName="Line" Property="Opacity" Value="0.55" />
                <Setter TargetName="Tag" Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                <Setter TargetName="Chain" Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                <Setter TargetName="Line" Property="Opacity" Value="1" />
                <Setter TargetName="Kind" Property="Foreground" Value="{StaticResource Brush.Error}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The switch of *Kan öppnas av en kollega*: a 32 × 18 track, the accent when on, a light knob that moves. -->
    <Style x:Key="Toggle.Switch" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <DockPanel>
                            <Border x:Name="Track" DockPanel.Dock="Left" Width="32" Height="18" CornerRadius="9"
                                    Background="{StaticResource Brush.BorderStrong}" VerticalAlignment="Top" Margin="0,2,10,0">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource Brush.Text}"
                                         HorizontalAlignment="Left" Margin="2,0,0,0" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Knob" Property="Margin" Value="16,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.AccentHover}" />
                            <Setter TargetName="Track" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A button in the graph's corner (sketch GR4): 30 px, a grey frame, the method or the amounts. -->
    <Style x:Key="Button.Graph" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- One half of the graph's switch between the free surface and the hop columns: an icon, no frame of its own. -->
    <Style x:Key="Button.Segment" TargetType="Button" BasedOn="{StaticResource Button.Graph}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
    </Style>

    <!-- The legend's ? in the graph's corner (sketch GR4): a small round button. -->
    <Style x:Key="Button.Help" TargetType="Button" BasedOn="{StaticResource Button.Graph}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.TextDim}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A link in the inspector, to the Guide or to Varför?: small accent text, underlined on hover. -->
    <Style x:Key="Button.Link" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
      The exit in the title bar (sketch UT1a): a quiet chip with the state's dot, the exit's name and a small arrow, that
      folds out the exits' panel. It is lit while the panel is out.
    -->
    <Style x:Key="Button.Chip" TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="9,0,8,0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The round power button of an exit in the panel (sketch UT1a): it connects, or disconnects when lit. -->
    <Style x:Key="Button.Power" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.BorderStrong}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row of a menu that does something, such as Lägg till WireGuard-fil … (sketch UT1a). -->
    <Style x:Key="Button.MenuItem" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
