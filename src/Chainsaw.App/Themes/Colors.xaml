<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      The slate of sketch ID9b, from back to front: a cool, blue-grey dark that never is pure black, which is tiring over
      a work day, made lighter towards the palette's cream step by step.
    -->
    <Color x:Key="Color.Background">#22262A</Color>
    <Color x:Key="Color.Surface">#2B2E32</Color>
    <!-- The surface fully transparent: a fade to the surface must start from its own colour, not from Transparent
         (white without alpha), or it greys on the way. -->
    <Color x:Key="Color.Surface.Clear">#002B2E32</Color>
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#33373A" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#383B3E" />
    <SolidColorBrush x:Key="Brush.SurfaceSelected" Color="#404346" />
    <!-- The floating command bar and other things that lie above the page. -->
    <SolidColorBrush x:Key="Brush.Floating" Color="#2F3236" />
    <!-- An open submenu of the pill and its tab (sketch PN1): a step above the pill, so that it reads as on top. -->
    <SolidColorBrush x:Key="Brush.Submenu" Color="#3A3D40" />
    <!-- A row of a folded-out panel under the pointer, a step lighter than the panel (sketch UT1a). -->
    <SolidColorBrush x:Key="Brush.SubmenuHover" Color="#3C3F42" />

    <SolidColorBrush x:Key="Brush.Border" Color="#33373A" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#45474A" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#636465" />

    <SolidColorBrush x:Key="Brush.Text" Color="#FBF6F0" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#9AA2A6" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#7C8387" />
    <!-- Icons of empty pages and other things that should not draw the eye. -->
    <SolidColorBrush x:Key="Brush.TextFaint" Color="#636465" />

    <!-- Chainsaw's accent, terracotta (sketch ID9b, replaced Magenta): the victims' money and what is chosen. -->
    <Color x:Key="Color.Accent">#C55A3D</Color>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#CD7158" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FBF6F0" />
    <!-- The accent as a faint tint under a chosen card or a way that is on (sketches BV4a, FS2a). -->
    <SolidColorBrush x:Key="Brush.AccentTint" Color="#3A2E2A" />
    <!-- Success, the warning and the error as faint tints under a tag (sketches ST2a, UT3b). -->
    <SolidColorBrush x:Key="Brush.SuccessTint" Color="#2F3A33" />
    <SolidColorBrush x:Key="Brush.PendingTint" Color="#3A3630" />
    <SolidColorBrush x:Key="Brush.PendingEdge" Color="#6B5A3A" />
    <SolidColorBrush x:Key="Brush.ErrorTint" Color="#3A2E31" />
    <SolidColorBrush x:Key="Brush.ErrorEdge" Color="#6B4547" />

    <SolidColorBrush x:Key="Brush.Success" Color="#8CC98F" />
    <SolidColorBrush x:Key="Brush.Error" Color="#EC8C8C" />
    <!-- Something under way, such as an exit being connected (sketch UT1a). -->
    <SolidColorBrush x:Key="Brush.Pending" Color="#E0B872" />
    <!-- The close button of the window under the pointer, as in Windows. -->
    <SolidColorBrush x:Key="Brush.CloseHover" Color="#C42B1C" />

    <!-- The graph's colours by what happens to the money (sketches GR3a and GR3c). -->
    <SolidColorBrush x:Key="Brush.Kind.CashOut" Color="#8DBAFF" />
    <SolidColorBrush x:Key="Brush.Kind.Spent" Color="#E0B872" />
    <SolidColorBrush x:Key="Brush.Kind.Risk" Color="#EC8C8C" />
    <SolidColorBrush x:Key="Brush.Kind.Sanctioned" Color="#FF7A7A" />
    <SolidColorBrush x:Key="Brush.Kind.OtherChain" Color="#C8A6E8" />
    <SolidColorBrush x:Key="Brush.Kind.Cluster" Color="#9AA2A6" />
    <SolidColorBrush x:Key="Brush.Kind.Unknown" Color="#7C8387" />

    <!-- The graph's surface (sketch GR4): a hop column's band, a line without traced money, a dashed end's frame. -->
    <SolidColorBrush x:Key="Brush.Graph.Lane" Color="#262A2E" />
    <SolidColorBrush x:Key="Brush.Graph.LaneText" Color="#747575" />
    <SolidColorBrush x:Key="Brush.Graph.Untraced" Color="#676969" />
    <SolidColorBrush x:Key="Brush.Graph.DashedFrame" Color="#6B4040" />
    <SolidColorBrush x:Key="Brush.Graph.ChainFrame" Color="#5A4870" />
    <!-- The marks' discs and the icons on them (sketches GR3a and GR3c). -->
    <SolidColorBrush x:Key="Brush.Mark.OnCashOut" Color="#0F1C2E" />
    <SolidColorBrush x:Key="Brush.Mark.OtherCase" Color="#45474A" />
    <SolidColorBrush x:Key="Brush.Mark.OnSanctioned" Color="#2A0F0F" />
    <!-- Tidigare sanktionerad: the sanctioned mark toned down, a dim red disc with a muted red icon. -->
    <SolidColorBrush x:Key="Brush.Mark.FormerlySanctioned" Color="#5A3D3D" />
    <SolidColorBrush x:Key="Brush.Mark.OnFormerlySanctioned" Color="#D9A3A3" />
    <!-- Kan frysas (sketch TK1a): a pale ice-blue disc with a dark snowflake. -->
    <SolidColorBrush x:Key="Brush.Mark.Freeze" Color="#A9DCF2" />
    <SolidColorBrush x:Key="Brush.Mark.OnFreeze" Color="#0E2633" />
    <!-- The inspector's box that says who can freeze what is left (sketch TK1a): a cold, dark tint with pale text. -->
    <SolidColorBrush x:Key="Brush.Freeze.Box" Color="#1B2428" />
    <SolidColorBrush x:Key="Brush.Freeze.Edge" Color="#3F5A66" />
    <SolidColorBrush x:Key="Brush.Freeze.Text" Color="#D6E8EF" />
    <!-- The swap's pill on a line (sketch TK1a). -->
    <SolidColorBrush x:Key="Brush.Graph.SwapPill" Color="#2A2433" />
    <!-- The time line (sketch TL1a): the dotted bands between the days, and the whole line at a chosen time. -->
    <Color x:Key="Color.Graph.TimeBand">#575B5F</Color>
    <Color x:Key="Color.Graph.TimeLine">#DCD7D0</Color>
    <!-- The start point's flag (sketch GR5, variant A): a light disc, the same form as the marks, in the other corner. -->
    <SolidColorBrush x:Key="Brush.Mark.Start" Color="#E6E6E6" />
    <!-- The watch's own quiet tint (sketch BV2a): not the accent, the exchanges' blue, red, yellow or purple. -->
    <SolidColorBrush x:Key="Brush.Watch" Color="#9AD0DC" />
    <SolidColorBrush x:Key="Brush.Watch.Idle" Color="#747575" />
    <SolidColorBrush x:Key="Brush.Mark.OnAccent" Color="#2A0C1E" />
    <!--
      The card's back (sketch IN4a): each asset's own quiet ring (bitcoin sand, ether steel, the stablecoins' green), the rules
      between its rows and its foot; and the small marks of sketch GR9a: an amber edge for the wait for a source, the
      dark ink on an amber disc, the hours' dotted lines in a zoomed band and the held-back strokes in the strip's lens.
    -->
    <SolidColorBrush x:Key="Brush.Asset.Bitcoin" Color="#D9CBB8" />
    <SolidColorBrush x:Key="Brush.Asset.Ether" Color="#B6BFD0" />
    <SolidColorBrush x:Key="Brush.Asset.Token" Color="#5EC2A8" />
    <SolidColorBrush x:Key="Brush.Card.Rule" Color="#3B3E42" />
    <SolidColorBrush x:Key="Brush.Pending.Edge" Color="#5C523F" />
    <SolidColorBrush x:Key="Brush.Mark.OnPending" Color="#2A2110" />
    <Color x:Key="Color.Graph.HourLine">#55585C</Color>
    <SolidColorBrush x:Key="Brush.Strip.HeldBack" Color="#6A6D71" />
    <!-- The areas behind the actors (sketch KF1b): drawn faint as fill and a little stronger as edge. -->
    <SolidColorBrush x:Key="Brush.Area.Red" Color="#EC8C8C" />
    <SolidColorBrush x:Key="Brush.Area.Sand" Color="#D6C4A0" />
    <SolidColorBrush x:Key="Brush.Area.Grey" Color="#C8C8C8" />
    <SolidColorBrush x:Key="Brush.Area.Lila" Color="#C8A6E8" />
    <SolidColorBrush x:Key="Brush.Area.Green" Color="#8CC98F" />
    <SolidColorBrush x:Key="Brush.Area.Blue" Color="#8DBAFF" />
    <!--
      The comment (sketch KN1a): a sheet in a faint warm tone with a folded corner, so that it is never taken for an
      actor; its Markdown marks dim while it is written, its thread a thin dotted line, a new one with a dashed edge.
    -->
    <SolidColorBrush x:Key="Brush.Note.Paper" Color="#37332F" />
    <SolidColorBrush x:Key="Brush.Note.Edge" Color="#4A4540" />
    <SolidColorBrush x:Key="Brush.Note.Mark" Color="#6A6560" />
    <SolidColorBrush x:Key="Brush.Note.Thread" Color="#8A8178" />
    <SolidColorBrush x:Key="Brush.Note.Code" Color="#2A2724" />
    <SolidColorBrush x:Key="Brush.Note.Draft" Color="#5A544E" />

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Mono only for hashes, txids and addresses in the inspector, and the terminal. -->
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
