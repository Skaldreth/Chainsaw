<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Gawk's neutral greys, from back to front. Deliberately not pure black, which is tiring over a work day. -->
    <Color x:Key="Color.Background">#191919</Color>
    <Color x:Key="Color.Surface">#1F1F1F</Color>
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#262626" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#2A2A2A" />
    <SolidColorBrush x:Key="Brush.SurfaceSelected" Color="#333333" />
    <!-- The floating command bar and other things that lie above the page. -->
    <SolidColorBrush x:Key="Brush.Floating" Color="#222222" />
    <!-- An open submenu of the pill and its tab (sketch PN1): a step above the pill, so that it reads as on top. -->
    <SolidColorBrush x:Key="Brush.Submenu" Color="#2C2C2C" />
    <!-- A row of a folded-out panel under the pointer, a step lighter than the panel (sketch UT1a). -->
    <SolidColorBrush x:Key="Brush.SubmenuHover" Color="#2E2E2E" />

    <SolidColorBrush x:Key="Brush.Border" Color="#2A2A2A" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#5A5A5A" />

    <SolidColorBrush x:Key="Brush.Text" Color="#EFEFEF" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#B4B4B4" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#8F8F8F" />
    <!-- Icons of empty pages and other things that should not draw the eye. -->
    <SolidColorBrush x:Key="Brush.TextFaint" Color="#5A5A5A" />

    <!-- Chainsaw's accent, Magenta (sketch ID6): the victims' money and what is chosen. -->
    <Color x:Key="Color.Accent">#E070B0</Color>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#EA8DC2" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#2A0C1E" />

    <SolidColorBrush x:Key="Brush.Success" Color="#8CC98F" />
    <SolidColorBrush x:Key="Brush.Error" Color="#EC8C8C" />
    <!-- Something under way, such as an exit being connected (sketch UT1a). -->
    <SolidColorBrush x:Key="Brush.Pending" Color="#E0B872" />
    <!-- The close button of the window under the pointer, as in Windows. -->
    <SolidColorBrush x:Key="Brush.CloseHover" Color="#C42B1C" />

    <!-- The graph's colours by what happens to the money (sketches GR3a and GR3c). -->
    <SolidColorBrush x:Key="Brush.Kind.CashOut" Color="#8DBAFF" />
    <SolidColorBrush x:Key="Brush.Kind.Spent" Color="#E0B872" />
    <SolidColorBrush x:Key="Brush.Kind.Risk" Color="#EC8C8C" />
    <SolidColorBrush x:Key="Brush.Kind.Sanctioned" Color="#FF7A7A" />
    <SolidColorBrush x:Key="Brush.Kind.OtherChain" Color="#C8A6E8" />
    <SolidColorBrush x:Key="Brush.Kind.Cluster" Color="#B4B4B4" />
    <SolidColorBrush x:Key="Brush.Kind.Unknown" Color="#8F8F8F" />

    <!-- The graph's surface (sketch GR4): a hop column's band, a line without traced money, a dashed end's frame. -->
    <SolidColorBrush x:Key="Brush.Graph.Lane" Color="#1C1C1C" />
    <SolidColorBrush x:Key="Brush.Graph.LaneText" Color="#6F6F6F" />
    <SolidColorBrush x:Key="Brush.Graph.Untraced" Color="#6A6A6A" />
    <SolidColorBrush x:Key="Brush.Graph.DashedFrame" Color="#6B4040" />
    <SolidColorBrush x:Key="Brush.Graph.ChainFrame" Color="#5A4870" />
    <!-- The marks' discs and the icons on them (sketches GR3a and GR3c). -->
    <SolidColorBrush x:Key="Brush.Mark.OnCashOut" Color="#0F1C2E" />
    <SolidColorBrush x:Key="Brush.Mark.OtherCase" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Brush.Mark.OnSanctioned" Color="#2A0F0F" />
    <!-- Kan frysas (sketch TK1a): a pale ice-blue disc with a dark snowflake. -->
    <SolidColorBrush x:Key="Brush.Mark.Freeze" Color="#A9DCF2" />
    <SolidColorBrush x:Key="Brush.Mark.OnFreeze" Color="#0E2633" />
    <!-- The swap's pill on a line (sketch TK1a). -->
    <SolidColorBrush x:Key="Brush.Graph.SwapPill" Color="#2A2433" />
    <!-- The start point's flag (sketch GR5, variant A): a light disc, the same form as the marks, in the other corner. -->
    <SolidColorBrush x:Key="Brush.Mark.Start" Color="#E6E6E6" />
    <!-- The areas behind the actors (sketch KF1b): drawn faint as fill and a little stronger as edge. -->
    <SolidColorBrush x:Key="Brush.Area.Red" Color="#EC8C8C" />
    <SolidColorBrush x:Key="Brush.Area.Sand" Color="#D6C4A0" />
    <SolidColorBrush x:Key="Brush.Area.Grey" Color="#C8C8C8" />
    <SolidColorBrush x:Key="Brush.Area.Lila" Color="#C8A6E8" />
    <SolidColorBrush x:Key="Brush.Area.Green" Color="#8CC98F" />
    <SolidColorBrush x:Key="Brush.Area.Blue" Color="#8DBAFF" />

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Mono only for hashes, txids and addresses in the inspector, and the terminal. -->
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
