<Window x:Class="Chainsaw.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Chainsaw.App.Controls"
        xmlns:vm="clr-namespace:Chainsaw.App.ViewModels"
        xmlns:views="clr-namespace:Chainsaw.App.Views"
        xmlns:nav="clr-namespace:Chainsaw.App.Navigation"
        Title="Chainsaw" Width="1440" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!--
      Chainsaw draws its own title bar, as Gawk does; Windows keeps resizing, snapping and the system menu. The thin glass
      edge keeps the frame that Windows 11 rounds (Interop/WindowFrame.cs), so the window has Gawk's round corners.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />

        <!--
          An icon of the pill: the view's icon, the tooltip with its shortcut, and a dot when something waits there. A
          press shows the view, or folds out the icon's submenu (sketch PN1).
        -->
        <DataTemplate x:Key="RailItem" DataType="{x:Type vm:RailItemViewModel}">
            <!--
              The icon's slot folds away when its view cannot be used (no case open) and folds back when it can: it shrinks
              in height and fades, so that the pill grows and shrinks smoothly (the user's wish 2026-11-07).
            -->
            <Border x:Name="Slot">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="Fold" ScaleY="1" />
                </Border.LayoutTransform>
            <Button x:Name="Item" Style="{StaticResource Button.Rail}"
                    Command="{Binding DataContext.PressCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" ToolTip="{Binding Entry.ToolTip}"
                    AutomationProperties.Name="{Binding Entry.Name}">
                <Grid Width="38" Height="38">
                    <controls:GridIcon x:Name="Icon" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Data="{Binding Entry.Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                    <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource Brush.Accent}"
                             Stroke="{StaticResource Brush.SurfaceRaised}" StrokeThickness="2"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                             Visibility="Collapsed" />
                </Grid>
            </Button>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Entry.IsBuilt}" Value="False">
                    <Setter TargetName="Icon" Property="Opacity" Value="0.4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsShown}" Value="False">
                    <Setter TargetName="Slot" Property="IsHitTestVisible" Value="False" />
                    <Setter TargetName="Item" Property="Focusable" Value="False" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Fold" Storyboard.TargetProperty="ScaleY" To="0"
                                                 Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Slot" Storyboard.TargetProperty="Opacity" To="0"
                                                 Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Fold" Storyboard.TargetProperty="ScaleY" To="1"
                                                 Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Slot" Storyboard.TargetProperty="Opacity" To="1"
                                                 BeginTime="0:0:0.07" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Item" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                    <Setter TargetName="Item" Property="Foreground" Value="{StaticResource Brush.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasWaiting}" Value="True">
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The line between the pill's groups, as in Gawk's Byggare: 24 px, in the strong border colour. -->
        <Style x:Key="Line.Pill" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Background" Value="{StaticResource Brush.BorderStrong}" />
        </Style>

        <!-- The pill's lifted look: a raised surface, a strong edge and fully round ends. -->
        <Style x:Key="Border.Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
        </Style>
    </Window.Resources>

    <!-- Maximised, a window with its own chrome reaches past the screen's edge; the border keeps it inside. -->
    <Border x:Name="Frame">
        <Grid>
            <!-- The shell is in the visual tree only while the vault is open; locked, it is collapsed behind the gate. -->
            <Grid x:Name="ShellRoot" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== Title bar: logo, case, watch, exit, window buttons ===== -->
                <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="False">
                        <Image DockPanel.Dock="Left" Source="{StaticResource Logo.Small}" Width="16" Height="16"
                               Margin="14,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock DockPanel.Dock="Left" Text="Chainsaw" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <!-- The case, or Inget ärende öppet: a click (or Ctrl+O) folds out the case picker (sketch ÄV1a). -->
                        <Button x:Name="CaseChip" DockPanel.Dock="Left" Margin="9,0,0,0" VerticalAlignment="Center"
                                Command="{Binding CasePicker.ToggleCommand}" ToolTip="Ärenden (Ctrl+O)"
                                WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Ärenden">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Chip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CasePicker.IsOpen}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.SubmenuHover}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CaseTitle}" Foreground="{StaticResource Brush.TextDim}" FontSize="14"
                                           VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                                <controls:GridIcon Size="12" Data="{StaticResource Icon.ChevronDown}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource Brush.TextDim}" />
                            </StackPanel>
                        </Button>

                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.WindowClose}" Click="OnClose"
                                WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Stäng">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" StrokeThickness="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Window}" Click="OnMaximize"
                                WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximera">
                            <Path Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" Width="10" Height="10" StrokeThickness="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Window}" Click="OnMinimize"
                                WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimera">
                            <Path Data="M0,5 L10,5" Width="10" Height="10" StrokeThickness="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>

                        <!--
                          The exit, honestly (sketch UT1a): a green dot and its name while it is connected, grey words
                          otherwise. A click folds out the exits' panel under it.
                        -->
                        <Button x:Name="ExitChip" DockPanel.Dock="Right" Margin="0,0,14,0" VerticalAlignment="Center"
                                Command="{Binding ExitPanel.ToggleCommand}" ToolTip="{Binding SourceText}"
                                WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Utgångar">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Chip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExitPanel.IsOpen}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.SubmenuHover}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Brush.TextFaint}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExitLive}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ExitText}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextDim}" />
                                <controls:GridIcon Size="12" Data="{StaticResource Icon.ChevronDown}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource Brush.TextDim}" />
                            </StackPanel>
                        </Button>

                        <!--
                          A source asks Chainsaw to wait, or is asked no faster than its pace: a small amber dot beside the
                          exit, only while it lasts, with the words on hover.
                        -->
                        <Border DockPanel.Dock="Right" Background="Transparent" Padding="6" Margin="0,0,2,0"
                                VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"
                                AutomationProperties.Name="{Binding WaitText}"
                                Visibility="{Binding IsWaiting, Converter={StaticResource VisibleWhen}}">
                            <Border.ToolTip>
                                <StackPanel MaxWidth="320">
                                    <TextBlock Text="{Binding WaitText}" Foreground="{StaticResource Brush.Pending}" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                        En källa ber Chainsaw vänta, eller frågas inte fortare än sin takt. Arbetet går vidare.
                                    </TextBlock>
                                </StackPanel>
                            </Border.ToolTip>
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Pending}" />
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Clipped at the title bar's lower edge, so that no panel's shadow ever lies over the title bar. -->
                <Grid Grid.Row="1" ClipToBounds="True">
                    <!--
                      ===== The page. It has no header of its own (decided 2026-11-07): the pill's chosen icon says which view
                      it is, and the space is the view's. =====
                    -->
                    <Grid>

                        <!-- The graph (sketch GR4). -->
                        <views:GraphView x:Name="GraphPage"
                                         Visibility="{Binding DataContext.IsGraphShown, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                        <!-- Bevakning (sketch BV1a). -->
                        <views:MonitoringView x:Name="MonitoringPage"
                                              Visibility="{Binding DataContext.IsMonitoringShown, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                        <!-- Exponering (sketch EP1b). -->
                        <views:ExposureView x:Name="ExposurePage"
                                            Visibility="{Binding DataContext.IsExposureShown, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                        <!-- Begäran (sketch BG1b). -->
                        <views:RequestsView x:Name="RequestsPage"
                                            Visibility="{Binding DataContext.IsRequestsShown, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                        <!-- Etiketter (sketch ET1a). -->
                        <views:LabelsView x:Name="LabelsPage"
                                          Visibility="{Binding DataContext.IsLabelsShown, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                        <views:ReportView x:Name="ReportPage" Visibility="{Binding DataContext.IsReportShown, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                        <!-- The Guide (F1, sketch GD1a in a simple form). -->
                        <views:GuideView x:Name="GuidePage"
                                         Visibility="{Binding DataContext.IsGuideShown, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                        <!-- A view that is not built yet: the page says so, with the view's icon, and never shows made-up data. -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80"
                                    Visibility="{Binding IsPlaceholderShown, Converter={StaticResource VisibleWhen}}">
                            <controls:GridIcon Size="40" Foreground="{StaticResource Brush.TextFaint}" HorizontalAlignment="Center"
                                               Data="{Binding CurrentEntry.Icon, Converter={x:Static controls:ResourceKeyConverter.Instance}}" />
                            <TextBlock Text="{Binding CurrentEntry.Name}" FontSize="14" Foreground="{StaticResource Brush.TextDim}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock Text="Inte byggt än" FontSize="13.5" Foreground="{StaticResource Brush.TextFaint}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                    </Grid>

                    <!--
                      ===== The Guide beside the work (sketch GD1b): a panel from the right over the inspector, without
                      darkening the rest. Its data context is the panel's own view model. ===== -->
                    <views:GuidePanel x:Name="GuidePanel"
                                      Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhen}}" />

                    <!--
                      ===== The pill (decided 2026-11-07, after Gawk's Byggare): the views as round icons, the name on hover,
                      floating over the page at the left edge, centred in height ===== -->
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0">
                        <!-- The shadow lies in a layer of its own: an effect on the pill would blur its icons. -->
                        <Border Style="{StaticResource Border.Pill}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.45" Color="Black" />
                            </Border.Effect>
                        </Border>
                        <Border Style="{StaticResource Border.Pill}" BorderBrush="{StaticResource Brush.BorderStrong}"
                                BorderThickness="1" Padding="5">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Top}" ItemTemplate="{StaticResource RailItem}" Focusable="False" />
                                <Border Style="{StaticResource Line.Pill}" />
                                <ItemsControl ItemsSource="{Binding Work}" ItemTemplate="{StaticResource RailItem}" Focusable="False" />
                                <Border Style="{StaticResource Line.Pill}"
                                        Visibility="{Binding IsWorkShown, Converter={StaticResource VisibleWhen}}" />
                                <ItemsControl ItemsSource="{Binding Bottom}" ItemTemplate="{StaticResource RailItem}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--
                      ===== An open submenu of the pill (sketch PN1), over the pill and the page, with its tab laid exactly
                      over the button it folds out of ===== -->
                    <Canvas x:Name="SubmenuLayer" ClipToBounds="False">
                        <views:PillSubmenu x:Name="Submenu" />
                    </Canvas>

                    <!--
                      ===== The command bar (decided 2026-11-07): search and commands are here and nowhere else. It is
                      hidden until Ctrl+K or Ctrl+F brings it up like Spotlight, near the top; Esc, a click outside or a
                      command that did what it was asked hides it again. Nothing is darkened, since the chosen search
                      row is shown in the graph under it (sketch KR1a). ===== -->
                    <Grid x:Name="CommandLayer" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Rectangle x:Name="CommandDim" Grid.RowSpan="2" Fill="Transparent" MouseDown="OnCommandOutside" />
                        <!--
                          At most 640 wide, and narrower when the window or the space beside the Guide's panel is, so
                          that it is never cut (a stretch held back by MaxWidth is centred).
                        -->
                        <Grid x:Name="CommandPanel" Grid.Row="1" MaxWidth="640" Margin="24,0" VerticalAlignment="Top"
                              HorizontalAlignment="Stretch" RenderTransformOrigin="0.5,0">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CommandScale" />
                                    <TranslateTransform x:Name="CommandSlide" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <!-- The shadow lies in a layer of its own: an effect on the bar would blur its text. -->
                            <Border CornerRadius="14" Background="{StaticResource Brush.Floating}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.55" Color="Black" />
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="14" Background="{StaticResource Brush.Floating}"
                                    BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1.5">
                                <StackPanel>
                                    <DockPanel Height="56" Margin="18,0">
                                        <controls:GridIcon DockPanel.Dock="Left" Size="20" Data="{StaticResource Icon.Search}"
                                                           Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"
                                                           Margin="0,0,12,0" />
                                        <TextBlock DockPanel.Dock="Right" Text="Esc" FontSize="12" Foreground="{StaticResource Brush.TextDim}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <!-- The chain what is written is recognised on (sketch KR1a), for example ₿ Bitcoin. -->
                                        <Border DockPanel.Dock="Right" Height="22" CornerRadius="11" Padding="8,0" Margin="12,0,0,0"
                                                BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1"
                                                VerticalAlignment="Center" ToolTip="Känns igen som en adress eller en tx på kedjan"
                                                Visibility="{Binding Search.HasChain, Converter={StaticResource VisibleWhen}}">
                                            <TextBlock Text="{Binding Search.ChainText}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.TextMuted}" />
                                        </Border>
                                        <TextBox x:Name="CommandBox" Style="{StaticResource TextBox.Command}" FontSize="16"
                                                 Tag="Sök etikett, adress, tx, kluster eller begrepp, eller skriv /kommando"
                                                 Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Kommandorad" PreviewKeyDown="OnCommandKey">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding SubmitCommand}" />
                                                <KeyBinding Key="Escape" Command="{Binding CloseCommandBarCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>
                                    <!-- The answer under the field, or the hint for what is written; an error in the error colour. -->
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1.5,0,0" Padding="18,10,18,12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShownAbove}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ShownAbove}" FontSize="13" TextWrapping="Wrap" LineHeight="18">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsShowingError}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <!-- The search (sketch KR1a): the best hit, the groups and the keys. -->
                                    <views:CommandSearchList x:Name="SearchList" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!--
                  The exits' panel (sketch UT1a), folded out under the exit in the title bar, its right edge at the chip's.
                  A click anywhere else under the title bar folds it in, and goes no further.
                -->
                <Grid Grid.Row="1"
                      Visibility="{Binding ExitPanel.IsOpen, Converter={StaticResource VisibleWhen}}">
                    <Rectangle Fill="Transparent" MouseDown="OnExitPanelOutside" />
                    <views:ExitPanel x:Name="ExitPanelView" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,4,152,0" />
                </Grid>

                <!--
                  The case picker (sketch ÄV1a), folded out under the case in the title bar, its left edge at the chip's.
                  A click anywhere else under the title bar folds it in, and goes no further.
                -->
                <Grid x:Name="CasePickerLayer" Grid.Row="1" Grid.RowSpan="2"
                      Visibility="{Binding CasePicker.IsOpen, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
                    <Rectangle Fill="Transparent" MouseDown="OnCasePickerOutside" />
                    <views:CasePicker x:Name="CasePickerView" HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Margin="100,4,0,0" />
                </Grid>

                <!-- Nytt ärende (NC2a): over everything under the title bar, with the rest darkened. -->
                <views:NewCasePanel x:Name="NewCasePanel" Grid.Row="1" />

                <!-- The settings (ST1a): a dialog in the middle, over everything under the title bar, the rest darkened. -->
                <views:SettingsDialog x:Name="SettingsDialog" Grid.Row="1" />

                <!-- The case's envelopes (ÄR1b): a colleague's file, the properties and the choice after a crash. -->
                <views:CaseDialogs x:Name="CaseDialogsView" Grid.Row="1" />

                <!-- The toaster (TO1a): at the lower right, over everything under the title bar, dialogs too. -->
                <views:ToastHost x:Name="Toasts" Grid.Row="1" />
            </Grid>

            <!-- The gate: the lock screen (ID7) or the first-run setup (FS1a) on the field, in place of everything. -->
            <views:GateView x:Name="Gate" />
        </Grid>
    </Border>
</Window>
