<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- LibraryImport (WinHttpProxyReader) generates its marshalling as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Chainsaw.Modules.Network.Contracts\Chainsaw.Modules.Network.Contracts.csproj" />
    <ProjectReference Include="..\..\Security\Chainsaw.Modules.Security.Contracts\Chainsaw.Modules.Security.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shipped WireGuard helper's hash, so that only that copy is started (HelperProcessStarter). -->
    <EmbeddedResource Include="..\..\..\..\tools\Chainsaw.Tunnel\dist\chainsaw-tunnel.exe.sha256"
                      LogicalName="Chainsaw.Modules.Network.chainsaw-tunnel.exe.sha256" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Chainsaw.Modules.Network.Tests" />
  </ItemGroup>
</Project>
